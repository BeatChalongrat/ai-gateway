# ============================================================
# SRAN AI Gateway — Frontend Environment
# Copy this file to .env.local:
#   cp .env.example .env.local
# ============================================================

# Backend API URL (must match backend APP_PORT)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Admin API key (created by seed script or via admin UI)
# Required for the admin console to authenticate with the backend.
NEXT_PUBLIC_ADMIN_API_KEY=
