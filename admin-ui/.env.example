# ============================================================
# SRAN AI Gateway — Frontend Environment
# Copy this file to .env.local:
#   cp .env.example .env.local
# ============================================================

# Backend API URL (must match backend APP_PORT)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Phase 2A: admin auth is now cookie-session based. No API key is
# bundled into the browser any more — authentication is handled by
# POST /auth/session/login which sets an HttpOnly admin_session cookie.
# The legacy public admin-API-key variable was removed to close P0-1
# (client-side API-key exposure). If you see it in any older deploy
# config, delete it.
