# Portal Next.js env — copy to .env.local and fill in before running.

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
# Must match the origin the portal is served from. In dev: http://localhost:3001
NEXTAUTH_URL=http://localhost:3001
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Flip to "true" once provider credentials below are set. The signup and
# login pages check this flag to decide whether to render the social buttons
# or a "coming soon" banner. Leave empty/false on machines where the OAuth
# apps haven't been provisioned.
NEXT_PUBLIC_OAUTH_ENABLED=false

# Internal URL the NextAuth API route uses to reach the backend. In Docker
# compose this would be http://backend:8080 — leave as localhost for the
# host-based dev workflow.
BACKEND_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Google OAuth
#   1. Create a project in https://console.cloud.google.com/
#   2. APIs & Services → Credentials → Create OAuth client ID
#   3. Authorized redirect URI:
#      http://localhost:3001/api/auth/callback/google
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# GitHub OAuth
#   1. https://github.com/settings/developers → New OAuth App
#   2. Authorization callback URL:
#      http://localhost:3001/api/auth/callback/github
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Production notes (Phase 3)
# ---------------------------------------------------------------------------
# - NEXTAUTH_URL must be the real portal origin (https://<portal-host>).
# - NEXTAUTH_SECRET: generate fresh (openssl rand -base64 32); the dev
#   default in docker-compose refuses to boot prod.
# - Add the prod redirect URI to the SAME Google client:
#     https://<portal-host>/api/auth/callback/google
#   plus the JS origin https://<portal-host>; consent screen = Internal.
# - ROTATE GOOGLE_CLIENT_SECRET before prod and mirror it to the
#   backend's OAUTH_GOOGLE_CLIENT_SECRET (root .env / secrets store).
