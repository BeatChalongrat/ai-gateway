{
  "detector": "password_field",
  "entity_type": "password_in_config",
  "category": "secret",
  "severity": 3,
  "cases": [
    {
      "id": "password_equals",
      "input": "password=secret123 yay",
      "should_match": true,
      "expected_count": 1,
      "expected_spans": [
        {
          "start": 9,
          "end": 18
        }
      ]
    },
    {
      "id": "password_colon_quoted",
      "input": "password: \"hunter2\" line",
      "should_match": true,
      "expected_count": 1,
      "expected_spans": [
        {
          "start": 10,
          "end": 19
        }
      ]
    },
    {
      "id": "db_password_uppercase",
      "input": "DB_PASSWORD='changeme' env",
      "should_match": true,
      "expected_count": 1,
      "expected_spans": [
        {
          "start": 12,
          "end": 22
        }
      ]
    },
    {
      "id": "secret_key_yaml",
      "input": "secret_key: abcdef end",
      "should_match": true,
      "expected_count": 1,
      "expected_spans": [
        {
          "start": 12,
          "end": 18
        }
      ]
    },
    {
      "id": "password_bare_no_assign",
      "input": "the password is hidden",
      "should_match": false,
      "expected_count": 0,
      "expected_spans": []
    },
    {
      "id": "login_word_no_label",
      "input": "login=admin no password",
      "should_match": false,
      "expected_count": 0,
      "expected_spans": []
    }
  ]
}
