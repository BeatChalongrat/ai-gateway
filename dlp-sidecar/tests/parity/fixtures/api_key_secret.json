{
  "detector": "api_key_secret",
  "entity_type": "api_key_secret",
  "category": "credential",
  "severity": 4,
  "cases": [
    {
      "id": "anthropic_long",
      "input": "key sk-ant-api03-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa committed",
      "should_match": true,
      "expected_count": 1,
      "expected_spans": [
        {
          "start": 4,
          "end": 51
        }
      ]
    },
    {
      "id": "google_api_key",
      "input": "GOOGLE_API_KEY=AIzaSyA1B2C3D4E5F6G7H8I9J0K1L2M3N4O5P6Q here",
      "should_match": true,
      "expected_count": 1,
      "expected_spans": [
        {
          "start": 15,
          "end": 54
        }
      ]
    },
    {
      "id": "jwt_token",
      "input": "token eyJhbGciOiJI.eyJzdWIiOiIxMjM.SflKxwRJSMeKKF here",
      "should_match": true,
      "expected_count": 1,
      "expected_spans": [
        {
          "start": 6,
          "end": 49
        }
      ]
    },
    {
      "id": "assignment_capture",
      "input": "config api_key=\"abcd1234EFGHabcd1234EFGH\" loaded",
      "should_match": true,
      "expected_count": 1,
      "expected_spans": [
        {
          "start": 16,
          "end": 40
        }
      ]
    },
    {
      "id": "no_secret_present",
      "input": "normal text no credentials",
      "should_match": false,
      "expected_count": 0,
      "expected_spans": []
    },
    {
      "id": "anthropic_too_short",
      "input": "sk-ant-api03-short bad",
      "should_match": false,
      "expected_count": 0,
      "expected_spans": []
    },
    {
      "id": "low_entropy_no_label",
      "input": "abcdefghij just letters",
      "should_match": false,
      "expected_count": 0,
      "expected_spans": []
    }
  ]
}
