# =============================================================================
# AI Gateway — UAT server .env template
# =============================================================================
# Copy to <repo-root>/.env on the UAT server and fill in the marked sections.
#
# APP_ENV=development keeps validate_secrets() permissive so we don't have to
# generate every secret to bring the box up. Flip to production *before*
# handing the URL to the customer, regenerating every "REPLACE_ME" entry
# with `python3 -c "import secrets; print(secrets.token_hex(32))"`.
# =============================================================================

APP_ENV=development

# ---- Postgres -----------------------------------------------------------
# Defaults match docker-compose.yml; override only if the customer wants
# a managed Postgres instead of the bundled container.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_gateway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---- Redis --------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Network ------------------------------------------------------------
# Replace <SERVER_IP> with the UAT box's reachable hostname or IP. Both
# admin-ui (3000) and portal (3001) must appear in CORS_ORIGINS or the
# browser will block the API calls.
CORS_ORIGINS=http://<SERVER_IP>:3000,http://<SERVER_IP>:3001
PORTAL_PUBLIC_URL=http://<SERVER_IP>:3001
ADMIN_UI_ORIGIN=http://<SERVER_IP>:3000
PORTAL_ORIGIN=http://<SERVER_IP>:3001

# ---- Secrets (rotate before production handoff) -------------------------
# Generate each value with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-stable-key-change-in-prod
MASTER_ENCRYPTION_KEY=dev-stable-key-change-in-prod
PORTAL_JWT_SECRET=dev-stable-portal-key-change-in-prod
SESSION_SIGNING_SECRETS=dev-session-signing-secret
DLP_HMAC_KEY=dev-dlp-hmac-key-change-in-production
DLP_AUDIT_KEY=

# ---- Email (Phase 3.5 — Resend) -----------------------------------------
# Empty key leaves the sender in "log-to-console" mode (dev). Set a real
# Resend key before flipping APP_ENV to production.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@sran.ai
EMAIL_FROM_NAME=SRAN AI Gateway

# ---- Provider keys ------------------------------------------------------
# Leave blank and let the operator enter them through the Providers page
# (the admin UI persists them to provider_keys, AES-GCM-encrypted at rest).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
MINIMAX_API_KEY=
QWEN_API_KEY=
KIMI_API_KEY=
ZAI_API_KEY=

# ---- Sidecars (default: python paths — no extra services needed) --------
# Switch to "go" / "rust" once the sidecars are confirmed healthy on the
# UAT box; the fallback path is automatic so a misconfig won't 500 traffic.
LOG_WORKER_ENGINE=python
RATE_LIMITER_ENGINE=python

# ---- Cost display -------------------------------------------------------
DISPLAY_CURRENCY=THB
USD_TO_THB_RATE=35.0
