@@ -0,0 +1,371 @@
+"""Thai Royal/Public Entity Registry — Phase 3.
+
+Deterministic, versioned, in-memory registry of verified Thai royal /
+historical / public references. It is used ONLY as span-scoped NEGATIVE
+evidence: a match marks a span as a known public name/place/org so the
+Policy Engine may relax an OVERLAPPING name/location/org finding. It never
+masks, restores, deletes findings, or relaxes a whole message — and never
+overrides secret / credential / strong-identifier / private-attribute /
+numeric findings.
+
+Hardening:
+- Loaded + validated ONCE, cached in memory. No DB/network/Redis per
+  request. An invalid registry disables itself (empty) — it never becomes
+  allow-all.
+- Matching is per :class:`NumericTextSegment` (local offsets +
+  message_index); context windows never cross a segment boundary.
+- Numerals (Thai ๐-๙ / Arabic 0-9) and optional whitespace are handled by
+  the compiled patterns; matching uses boundary guards so an alias never
+  matches inside a longer word. Longest alias wins.
+- Ambiguous / short aliases require royal context nearby; otherwise they
+  produce NO public evidence (conservative).
+
+NEVER logs or stores matched text / alias text / surrounding text.
+"""
+
+from __future__ import annotations
+
+import enum
+import json
+import re
+import unicodedata
+from dataclasses import dataclass
+from pathlib import Path
+
+import structlog
+
+logger = structlog.get_logger(__name__)
+
+_REGISTRY_PATH = (
+    Path(__file__).resolve().parent / "data" / "thai_public_entities.v1.json"
+)
+
+_MAX_TEXT_LEN = 200_000
+_MAX_MATCHES_PER_SEGMENT = 50
+_CONTEXT_WINDOW = 80  # chars each side for context-required aliases
+
+# Sentence separators (Latin + CJK + Thai-relevant + line breaks +
+# semicolon). Used to keep ambiguous-alias context within one sentence.
+_SENTENCE_SEP_RE = re.compile(r"[.!?;。！？\n\r]")
+
+
+def _sentence_bounds(text: str, start: int, end: int) -> tuple[int, int]:
+    """Return [lo, hi) sentence bounds containing the [start, end) span:
+    just after the nearest separator before ``start``, up to the nearest
+    separator at/after ``end`` (or text ends)."""
+    lo = 0
+    for m in _SENTENCE_SEP_RE.finditer(text, 0, start):
+        lo = m.end()
+    m2 = _SENTENCE_SEP_RE.search(text, end)
+    hi = m2.start() if m2 else len(text)
+    return lo, hi
+
+
+_THAI_DIGITS = "๐๑๒๓๔๕๖๗๘๙"
+_THAI_DIGIT_TO_ARABIC = {d: str(i) for i, d in enumerate(_THAI_DIGITS)}
+_THAI_LETTER_RE = re.compile(r"[ก-ฮะ-๎]")  # consonants+vowels
+
+
+class PublicEntityType(str, enum.Enum):
+    ROYAL_HISTORICAL_NAME = "ROYAL_HISTORICAL_NAME"
+    ROYAL_PUBLIC_NAME = "ROYAL_PUBLIC_NAME"
+    ROYAL_TITLE = "ROYAL_TITLE"
+    ROYAL_REIGN_REFERENCE = "ROYAL_REIGN_REFERENCE"
+    PUBLIC_FIGURE_NAME = "PUBLIC_FIGURE_NAME"
+    PUBLIC_PLACE = "PUBLIC_PLACE"
+    PUBLIC_ORGANIZATION = "PUBLIC_ORGANIZATION"
+
+
+_VALID_TYPES = {t.value for t in PublicEntityType}
+
+# Alias kinds.
+EXACT_UNAMBIGUOUS = "exact_unambiguous"
+CONTEXT_REQUIRED = "context_required"
+
+# Global royal-context fallback when an entity declares no required_context
+# for a context-required alias.
+_GLOBAL_ROYAL_CONTEXT = (
+    "รัชกาล", "พระบาทสมเด็จ", "สมเด็จพระ", "พระเจ้าอยู่หัว", "พระมหากษัตริย์",
+    "พระราช", "เสด็จ", "ทรง", "กษัตริย์", "royal", "king", "reign",
+)
+
+
+@dataclass(frozen=True)
+class PublicEntitySpan:
+    message_index: int | None
+    start: int
+    end: int
+    entity_id: str
+    entity_type: PublicEntityType
+    alias_type: str   # EXACT_UNAMBIGUOUS | CONTEXT_REQUIRED
+    rule_id: str
+    confidence: float = 1.0
+
+
+@dataclass(frozen=True)
+class _AliasEntry:
+    entity_id: str
+    entity_type: PublicEntityType
+    kind: str
+    required_context: tuple[str, ...]
+    group: str  # regex group name
+
+
+def _is_thai_letter(ch: str) -> bool:
+    return bool(_THAI_LETTER_RE.match(ch))
+
+
+def _alias_core_pattern(alias: str) -> str:
+    parts: list[str] = []
+    for ch in alias:
+        if ch.isdigit():
+            parts.append(f"[{ch}{_THAI_DIGITS[int(ch)]}]")
+        elif ch in _THAI_DIGIT_TO_ARABIC:
+            parts.append(f"[{_THAI_DIGIT_TO_ARABIC[ch]}{ch}]")
+        elif ch == " ":
+            parts.append(r"\s*")
+        elif ch == ".":
+            parts.append(r"\.\s*")
+        elif ch == "ฯ":
+            parts.append(r"ฯ?")  # tolerate the paiyannoi being dropped
+        else:
+            parts.append(re.escape(ch))
+    return "".join(parts)
+
+
+# Lexical word-continuation class for ambiguous-alias boundaries: Thai
+# letters/marks/digits (ก-๛ spans Thai consonants…Thai digits), Latin
+# letters, Arabic digits, underscore. A match glued to any of these is a
+# different word and must NOT count.
+_WORD_CONT = r"ก-๛A-Za-z0-9_"
+
+
+def _boundary_guarded(alias: str, core: str, kind: str) -> str:
+    """Wrap a pattern with boundary guards.
+
+    Thai script has no inter-word spaces, so EXACT/unambiguous long
+    aliases use only DIGIT guards (so ``ร.9`` never matches inside
+    ``ร.99`` / ``รัชกาลที่ 9`` never inside ``รัชกาลที่ 90``); their
+    glued-suffix risk is handled downstream by STRICT CONTAINMENT in the
+    Policy Engine, so we must NOT add a broad Thai-letter guard that would
+    break legitimate Thai phrases.
+
+    CONTEXT_REQUIRED / ambiguous aliases (e.g. ``ในหลวง``) DO get a
+    conservative lexical-boundary guard: they must not be glued to a Thai
+    letter, Latin letter, Thai/Arabic digit, or underscore on either side
+    (so ``ในหลวงชัย`` / ``ชัยในหลวง`` / ``ในหลวง123`` / ``abcในหลวง`` do
+    not match), while surrounding punctuation/quotes/spaces are allowed.
+    """
+    first, last = alias[0], alias[-1]
+    if kind == CONTEXT_REQUIRED:
+        # Asymmetric guard. POST: reject ANY word-continuation char
+        # (Thai letter/digit, Latin, digit, underscore) so a Thai SUFFIX
+        # can't extend the alias into a longer name (``ในหลวงชัย`` /
+        # ``ในหลวง123``). PRE: reject only Latin/Arabic/Thai digits +
+        # underscore (``abcในหลวง`` / ``123ในหลวง``) but ALLOW a Thai
+        # prefix, because Thai glues words (``และในหลวง`` is legitimate).
+        # A glued Thai-prefix name (``ชัยในหลวง``) is still kept safe by
+        # the context requirement + strict containment downstream.
+        pre = r"(?<![A-Za-z0-9๐-๙_])"
+        post = rf"(?![{_WORD_CONT}])"
+        return pre + core + post
+    pre = r"(?<!\d)" if first.isdigit() else ""
+    post = r"(?!\d)" if last.isdigit() else ""
+    return pre + core + post
+
+
+class _PublicEntityRegistry:
+    """Immutable, validated, compiled registry (loaded once)."""
+
+    def __init__(self) -> None:
+        self._combined: re.Pattern | None = None
+        self._by_group: dict[str, _AliasEntry] = {}
+        self._loaded = False
+        self._version = "unloaded"
+        self._entity_count = 0
+
+    # -- loading ------------------------------------------------------------
+
+    def _ensure_loaded(self) -> None:
+        if self._loaded:
+            return
+        self._loaded = True  # mark first so a failure disables (no retry storm)
+        try:
+            self._load()
+        except Exception as exc:  # noqa: BLE001 — disable, never allow-all
+            logger.error(
+                "dlp_public_registry_load_failed", error=str(exc)[:200]
+            )
+            self._combined = None
+            self._by_group = {}
+
+    def _load(self) -> None:
+        raw = json.loads(_REGISTRY_PATH.read_text(encoding="utf-8"))
+        if not isinstance(raw, dict) or "entities" not in raw:
+            raise ValueError("registry missing 'entities'")
+        self._version = str(raw.get("registry_version", "unknown"))
+
+        # alias text → set of entity_ids (for conflict detection)
+        seen: dict[str, set[str]] = {}
+        # collect (alias, entry-data) preserving order
+        collected: list[tuple[str, str, PublicEntityType, str, tuple]] = []
+        for ent in raw["entities"]:
+            if ent.get("status") != "active":
+                continue
+            etype = ent.get("entity_type")
+            if etype not in _VALID_TYPES:
+                raise ValueError(f"invalid entity_type: {etype!r}")
+            etype_enum = PublicEntityType(etype)
+            eid = ent["entity_id"]
+            req = tuple(ent.get("required_context") or [])
+            # canonical + aliases are exact/unambiguous (verified, specific
+            # references). ``required_context`` governs ONLY the ambiguous
+            # aliases — short/colloquial forms that must have royal context
+            # nearby before they count as public evidence.
+            names = [ent["canonical_name"], *ent.get("aliases", [])]
+            for a in names:
+                a = (a or "").strip()
+                if a:
+                    collected.append((a, eid, etype_enum, EXACT_UNAMBIGUOUS, req))
+            for a in ent.get("ambiguous_aliases", []) or []:
+                a = (a or "").strip()
+                if a:
+                    collected.append((a, eid, etype_enum, CONTEXT_REQUIRED, req))
+
+        # Conflict detection: same alias → 2+ entities → drop (fail closed).
+        # Aliases are matched against RAW segment text (offset-correct), so
+        # the conflict key and the compiled pattern both use the raw alias.
+        for a, eid, *_ in collected:
+            seen.setdefault(a, set()).add(eid)
+        conflicting = {a for a, ids in seen.items() if len(ids) > 1}
+        if conflicting:
+            logger.warning(
+                "dlp_public_registry_alias_conflicts",
+                count=len(conflicting),
+            )
+
+        # Build combined regex, longest alias first so the longest valid
+        # match wins at any position.
+        collected.sort(key=lambda t: len(t[0]), reverse=True)
+        fragments: list[str] = []
+        by_group: dict[str, _AliasEntry] = {}
+        for i, (a, eid, etype_enum, kind, req) in enumerate(collected):
+            if a in conflicting:
+                continue  # ambiguous/conflicting → no public evidence
+            grp = f"pe{i}"
+            core = _alias_core_pattern(a)
+            fragments.append(f"(?P<{grp}>{_boundary_guarded(a, core, kind)})")
+            by_group[grp] = _AliasEntry(
+                entity_id=eid, entity_type=etype_enum, kind=kind,
+                required_context=req or _GLOBAL_ROYAL_CONTEXT, group=grp,
+            )
+        self._by_group = by_group
+        self._combined = re.compile("|".join(fragments)) if fragments else None
+        self._entity_count = len({e.entity_id for e in by_group.values()})
+
+    @staticmethod
+    def _norm(text: str) -> str:
+        return unicodedata.normalize("NFKC", text)
+
+    # -- matching -----------------------------------------------------------
+
+    def match_segments(self, segments) -> list[PublicEntitySpan]:
+        """Return public-entity spans across all segments (local offsets +
+        message_index). Empty when the registry is disabled/empty —
+        conservative (no relaxation), never allow-all. Never raises."""
+        self._ensure_loaded()
+        if self._combined is None:
+            return []
+        out: list[PublicEntitySpan] = []
+        try:
+            for seg in segments:
+                text = getattr(seg, "text", "")
+                if not isinstance(text, str) or not text:
+                    continue
+                if len(text) > _MAX_TEXT_LEN:
+                    text = text[:_MAX_TEXT_LEN]
+                # Match on the ORIGINAL segment text so span offsets align
+                # with detector finding offsets. Aliases were NFKC-normalized
+                # at load; the compiled patterns already tolerate Thai/Arabic
+                # numerals + optional whitespace, which are the only variants
+                # that matter for the Thai seed (NFKC is length-preserving
+                # for these scripts, so this stays offset-correct).
+                count = 0
+                for m in self._combined.finditer(text):
+                    entry = self._by_group.get(m.lastgroup or "")
+                    if entry is None:
+                        continue
+                    if entry.kind == CONTEXT_REQUIRED and not self._has_context(
+                        text, m.start(), m.end(), entry.required_context
+                    ):
+                        continue
+                    out.append(PublicEntitySpan(
+                        message_index=getattr(seg, "message_index", None),
+                        start=m.start(), end=m.end(),
+                        entity_id=entry.entity_id, entity_type=entry.entity_type,
+                        alias_type=entry.kind,
+                        rule_id=f"public_entity.{entry.entity_type.value}.{entry.entity_id}",
+                        confidence=1.0,
+                    ))
+                    count += 1
+                    if count >= _MAX_MATCHES_PER_SEGMENT:
+                        break
+        except Exception as exc:  # noqa: BLE001 — disable for this call
+            logger.warning("dlp_public_registry_match_failed", error=str(exc)[:120])
+            return []
+        return out
+
+    @staticmethod
+    def _has_context(text, start, end, required_context) -> bool:
+        # Phase 3.1: context must be in the SAME sentence as the alias.
+        # Clamp the ±window to the sentence boundaries around the alias so
+        # a keyword from an adjacent sentence (or after a newline) cannot
+        # validate it.
+        s_lo, s_hi = _sentence_bounds(text, start, end)
+        lo = max(s_lo, start - _CONTEXT_WINDOW)
+        hi = min(s_hi, end + _CONTEXT_WINDOW)
+        # Exclude the matched span itself so the alias can't be its own
+        # context.
+        window = text[lo:start] + " " + text[end:hi]
+        return any(kw in window for kw in required_context)
+
+    @property
+    def version(self) -> str:
+        self._ensure_loaded()
+        return self._version
+
+
+public_entity_registry = _PublicEntityRegistry()
+
+# Detectors/entity types whose findings a public-entity span may relax.
+RELAXABLE_NAME_DETECTORS = frozenset({"thai_name", "thai_name_no_prefix"})
+RELAXABLE_NAME_ENTITY_TYPES = frozenset({"person", "thai_name"})
+_LOCATION_ENTITY_TYPES = frozenset({"location", "gpe"})
+_ORG_ENTITY_TYPES = frozenset({"organization"})
+_PLACE_REGISTRY_TYPES = frozenset({PublicEntityType.PUBLIC_PLACE})
+_ORG_REGISTRY_TYPES = frozenset({PublicEntityType.PUBLIC_ORGANIZATION})
+_NAME_REGISTRY_TYPES = frozenset({
+    PublicEntityType.ROYAL_HISTORICAL_NAME,
+    PublicEntityType.ROYAL_PUBLIC_NAME,
+    PublicEntityType.ROYAL_TITLE,
+    PublicEntityType.ROYAL_REIGN_REFERENCE,
+    PublicEntityType.PUBLIC_FIGURE_NAME,
+})
+
+
+def finding_relaxable_by(span_type: PublicEntityType, detector_name: str,
+                         entity_type: str) -> bool:
+    """Whether a public span of ``span_type`` may relax a finding from
+    ``detector_name`` / ``entity_type``. Names relax name findings; places
+    relax locations; orgs relax organizations. Nothing else."""
+    et = (entity_type or "").lower()
+    if span_type in _NAME_REGISTRY_TYPES:
+        return (
+            detector_name in RELAXABLE_NAME_DETECTORS
+            or et in RELAXABLE_NAME_ENTITY_TYPES
+        )
+    if span_type in _PLACE_REGISTRY_TYPES:
+        return et in _LOCATION_ENTITY_TYPES
+    if span_type in _ORG_REGISTRY_TYPES:
+        return et in _ORG_ENTITY_TYPES
+    return False
diff --git a/backend/app/services/dlp/secure_calc.py b/backend/app/services/dlp/secure_calc.py
new file mode 100644
index 0000000..e0f2490
--- /dev/null
+++ b/backend/app/services/dlp/secure_calc.py
@@ -0,0 +1,442 @@
+"""Secure Calculator — Phase 4A.2.6.
+
+Computes over Vault V2 ``calculation_eligible`` confidential-numeric tokens and
+mints a result token ``<CALC_n>``. The raw operands and the raw result NEVER
+leave trusted server memory + the scoped result vault: the provider, canonical
+history, ``request_logs.output_final``, and search/export/admin all see only
+``<CALC_n>``. The result restores to its raw value ONLY on the authorized owner
+display path (same Vault V2 scope authority).
+
+Hard security rules (enforced here):
+  * Deterministic ``decimal.Decimal`` arithmetic ONLY — no ``eval``, no
+    expression parser, no Python/JS/SQL execution, no LLM-decided math.
+  * Operands MUST be Vault V2 entries with ``numeric_class==CONFIDENTIAL_NUMERIC``
+    AND ``calculation_eligible==True`` (which already implies action==MASK,
+    not never_restore, not a secret/identifier). Anything else → fail closed.
+  * Result tokens are ``calculation_eligible=False`` → no chained ``<CALC_n>``
+    arithmetic in v1.
+  * The result store keys on the SAME owner-scope digest as Vault V2 (a
+    separate ``dlp_calc:v1`` namespace); wrong scope = not found.
+  * No raw operand/result value is ever logged.
+"""
+
+from __future__ import annotations
+
+import inspect
+import json
+import re
+from dataclasses import dataclass
+from decimal import Decimal, InvalidOperation, getcontext, ROUND_HALF_UP
+from enum import Enum
+from typing import Any, Iterable
+
+import structlog
+
+from app.services._redis_pool import get_async_redis
+from app.services.dlp.numeric_context import CONFIDENTIAL_NUMERIC
+from app.services.dlp.vault_v2 import VaultScope, VAULT_V2_TTL_SECONDS
+
+logger = structlog.get_logger(__name__)
+
+# Bounded precision — generous but finite, so a pathological operand can't
+# blow up memory. Fixed-point decimal; never float.
+getcontext().prec = 50
+
+_CALC_KEY_PREFIX = "dlp_calc:v1"
+_CALC_COUNTER = "__calc_counter__"
+CALC_TOKEN_TYPE = "calculation_result"
+CALC_SCHEMA_VERSION = 1
+
+# ``<CALC_n>`` namespace — DISJOINT from ``<rN>`` and ``<<CATEGORY_N>>``.
+CALC_TOKEN_RE = re.compile(r"\A<CALC_(\d+)>\Z")
+# A result-token value cap (defense against a runaway operand list).
+_MAX_OPERANDS = 100
+
+
+def is_calc_token(token: str) -> bool:
+    return bool(CALC_TOKEN_RE.match(token or ""))
+
+
+class CalcError(ValueError):
+    """Fail-closed calculator error. Carries a STABLE code, never raw values."""
+
+    def __init__(self, code: str) -> None:
+        super().__init__(code)
+        self.code = code
+
+
+class CalcOperation(str, Enum):
+    SUM = "sum"
+    AVERAGE = "average"
+    DIFFERENCE = "difference"
+    PERCENTAGE_CHANGE = "percentage_change"
+    ADD = "add"
+    SUBTRACT = "subtract"
+    MULTIPLY = "multiply"
+    DIVIDE = "divide"
+
+
+_BINARY_EXACT2 = {
+    CalcOperation.DIFFERENCE,
+    CalcOperation.SUBTRACT,
+    CalcOperation.DIVIDE,
+    CalcOperation.PERCENTAGE_CHANGE,
+}
+
+
+def coerce_operation(value: Any) -> "CalcOperation | None":
+    if isinstance(value, CalcOperation):
+        return value
+    if isinstance(value, str):
+        try:
+            return CalcOperation(value.strip().lower())
+        except ValueError:
+            return None
+    return None
+
+
+def parse_operand(raw: str) -> Decimal:
+    """Parse a stored raw numeric value to a Decimal. Fail closed on garbage.
+
+    Accepts plain integers/decimals with optional thousands separators; rejects
+    anything that isn't a finite number (no currency symbols, no expressions).
+    """
+    if not isinstance(raw, str):
+        raise CalcError("operand_not_numeric")
+    s = raw.strip().replace(",", "")
+    if not re.fullmatch(r"-?\d+(?:\.\d+)?", s):
+        raise CalcError("operand_not_numeric")
+    try:
+        d = Decimal(s)
+    except (InvalidOperation, ValueError):
+        raise CalcError("operand_not_numeric")
+    if not d.is_finite():
+        raise CalcError("operand_not_finite")
+    return d
+
+
+def compute(operation: CalcOperation, operands: list[Decimal]) -> Decimal:
+    """Deterministic fixed-point arithmetic. Fail-closed; no eval."""
+    n = len(operands)
+    if n == 0:
+        raise CalcError("no_operands")
+    if n > _MAX_OPERANDS:
+        raise CalcError("too_many_operands")
+    if operation in _BINARY_EXACT2 and n != 2:
+        raise CalcError("operation_requires_two_operands")
+
+    try:
+        if operation in (CalcOperation.SUM, CalcOperation.ADD):
+            result = sum(operands, Decimal(0))
+        elif operation == CalcOperation.AVERAGE:
+            result = sum(operands, Decimal(0)) / Decimal(n)
+        elif operation in (CalcOperation.DIFFERENCE, CalcOperation.SUBTRACT):
+            result = operands[0] - operands[1]
+        elif operation == CalcOperation.MULTIPLY:
+            result = Decimal(1)
+            for o in operands:
+                result *= o
+        elif operation == CalcOperation.DIVIDE:
+            if operands[1] == 0:
+                raise CalcError("division_by_zero")
+            result = operands[0] / operands[1]
+        elif operation == CalcOperation.PERCENTAGE_CHANGE:
+            if operands[0] == 0:
+                raise CalcError("percentage_change_base_zero")
+            result = (operands[1] - operands[0]) / operands[0] * Decimal(100)
+        else:  # pragma: no cover - enum exhaustive
+            raise CalcError("unsupported_operation")
+    except CalcError:
+        raise
+    except (InvalidOperation, ArithmeticError):
+        raise CalcError("arithmetic_error")
+
+    if not result.is_finite():
+        raise CalcError("result_not_finite")
+    return result
+
+
+def format_result(result: Decimal, *, currency: bool = False) -> str:
+    """Canonical string form of a result. 2dp for currency; else normalized."""
+    if currency:
+        return str(result.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP))
+    # Normalize: drop a trailing .0 (80000.0 → 80000) but keep real fractions.
+    normalized = result.normalize()
+    # ``normalize`` can yield scientific notation for large ints (8E+4); expand.
+    return f"{normalized:f}"
+
+
+# ---------------------------------------------------------------------------
+# Result entry + scoped result vault
+# ---------------------------------------------------------------------------
+
+
+async def _await(value: Any) -> Any:
+    if inspect.isawaitable(value):
+        return await value
+    return value
+
+
+@dataclass(frozen=True)
+class CalcResultEntry:
+    """A minted ``<CALC_n>`` result. Operands are TOKEN REFS only (never raw)."""
+
+    schema_version: int
+    token: str
+    token_type: str
+    raw_value: str
+    operation: str
+    operand_tokens: tuple[str, ...]
+    restorable_to_user: bool
+    never_restore_to_provider: bool
+    calculation_eligible: bool
+    created_at: int
+
+    def to_json(self) -> str:
+        return json.dumps(
+            {
+                "schema_version": self.schema_version,
+                "token": self.token,
+                "token_type": self.token_type,
+                "raw_value": self.raw_value,
+                "operation": self.operation,
+                "operand_tokens": list(self.operand_tokens),
+                "restorable_to_user": self.restorable_to_user,
+                "never_restore_to_provider": self.never_restore_to_provider,
+                "calculation_eligible": self.calculation_eligible,
+                "created_at": self.created_at,
+            },
+            sort_keys=True,
+            separators=(",", ":"),
+            ensure_ascii=False,
+        )
+
+    @classmethod
+    def from_json(cls, blob: Any) -> "CalcResultEntry | None":
+        if isinstance(blob, bytes):
+            try:
+                blob = blob.decode("utf-8")
+            except Exception:
+                return None
+        if not isinstance(blob, str):
+            return None
+        try:
+            d = json.loads(blob)
+            return cls(
+                schema_version=int(d["schema_version"]),
+                token=str(d["token"]),
+                token_type=str(d["token_type"]),
+                raw_value=str(d["raw_value"]),
+                operation=str(d["operation"]),
+                operand_tokens=tuple(str(t) for t in d.get("operand_tokens", [])),
+                restorable_to_user=bool(d["restorable_to_user"]),
+                never_restore_to_provider=bool(d["never_restore_to_provider"]),
+                calculation_eligible=bool(d["calculation_eligible"]),
+                created_at=int(d["created_at"]),
+            )
+        except (KeyError, TypeError, ValueError, json.JSONDecodeError):
+            return None
+
+
+class SecureCalcResultStore:
+    """Scoped ``<CALC_n>`` result store (parallel to Vault V2, same scope key).
+
+    Keyed ``dlp_calc:v1:{scope.digest()}`` so a result is bound to the same
+    owner scope as its operands. Wrong scope = not found.
+    """
+
+    def __init__(self, redis_client: Any = None) -> None:
+        self._fake = redis_client
+        self._async: Any | None = None
+
+    def _client(self) -> Any:
+        if self._fake is not None:
+            return self._fake
+        if self._async is None:
+            self._async = get_async_redis()
+        return self._async
+
+    @staticmethod
+    def _key(scope: VaultScope) -> str:
+        return f"{_CALC_KEY_PREFIX}:{scope.digest()}"
+
+    async def mint_and_store_async(
+        self,
+        scope: "VaultScope | None",
+        *,
+        raw_value: str,
+        operation: str,
+        operand_tokens: Iterable[str],
+        created_at: int,
+    ) -> "tuple[str, CalcResultEntry]":
+        if scope is None or not scope.is_valid:
+            raise CalcError("invalid_scope")
+        key = self._key(scope)
+        client = self._client()
+        idx = await _await(client.hincrby(key, _CALC_COUNTER, 1))
+        token = f"<CALC_{int(idx) - 1}>"
+        entry = CalcResultEntry(
+            schema_version=CALC_SCHEMA_VERSION,
+            token=token,
+            token_type=CALC_TOKEN_TYPE,
+            raw_value=raw_value,
+            operation=operation,
+            operand_tokens=tuple(operand_tokens),
+            restorable_to_user=True,
+            never_restore_to_provider=True,
+            calculation_eligible=False,
+            created_at=created_at,
+        )
+        await _await(client.hset(key, token, entry.to_json()))
+        await _await(client.expire(key, VAULT_V2_TTL_SECONDS))
+        return token, entry
+
+    async def resolve_for_user_async(
+        self, scope: "VaultScope | None", tokens: Iterable[str]
+    ) -> dict[str, str]:
+        """Owner-authorized restore: ``<CALC_n>`` → raw result string."""
+        if scope is None or not scope.is_valid:
+            return {}
+        toks = [t for t in tokens if is_calc_token(t)]
+        if not toks:
+            return {}
+        try:
+            values = await _await(self._client().hmget(self._key(scope), toks))
+        except Exception as exc:
+            logger.warning(
+                "dlp_calc_resolve_failed",
+                scope_fp=scope.fingerprint(),
+                exception_type=type(exc).__name__,
+            )
+            return {}
+        out: dict[str, str] = {}
+        for tok, blob in zip(toks, values or []):
+            entry = CalcResultEntry.from_json(blob)
+            if entry is None or entry.token != tok:
+                continue
+            if entry.restorable_to_user and not entry.calculation_eligible:
+                out[tok] = entry.raw_value
+        return out
+
+
+secure_calc_result_store = SecureCalcResultStore()
+
+
+# ---------------------------------------------------------------------------
+# High-level secure calculation over Vault V2 entries
+# ---------------------------------------------------------------------------
+
+
+def operand_eligible(entry: Any) -> bool:
+    """A Vault V2 entry is a legal calculator operand iff it is a
+    confidential-numeric, calculation-eligible, restorable, non-secret entry.
+    """
+    return (
+        entry is not None
+        and getattr(entry, "numeric_class", None) == CONFIDENTIAL_NUMERIC
+        and bool(getattr(entry, "calculation_eligible", False))
+        and not bool(getattr(entry, "never_restore", True))
+        and bool(getattr(entry, "restorable_to_user", False))
+    )
+
+
+async def secure_calculate(
+    *,
+    scope: "VaultScope | None",
+    operation: CalcOperation,
+    operand_tokens: list[str],
+    vault_entries: dict[str, Any],
+    created_at: int,
+    currency: bool = False,
+) -> "tuple[str, CalcResultEntry]":
+    """Resolve eligible operands, compute, mint + store a ``<CALC_n>``.
+
+    ``vault_entries`` is the scoped Vault V2 lookup (token → VaultEntryV2). Any
+    ineligible / missing / chained-calc token fails the WHOLE calculation
+    closed (no partial result). Raw operands stay in local memory only.
+    """
+    if scope is None or not scope.is_valid:
+        raise CalcError("invalid_scope")
+    if not operand_tokens:
+        raise CalcError("no_operands")
+    # Reject chained <CALC_n> operands (v1) and any non-vault token shape.
+    operands: list[Decimal] = []
+    for tok in operand_tokens:
+        if is_calc_token(tok):
+            raise CalcError("chained_calc_not_supported")
+        entry = vault_entries.get(tok)
+        if not operand_eligible(entry):
+            raise CalcError("operand_not_eligible")
+        operands.append(parse_operand(entry.raw_value))
+    result = compute(operation, operands)
+    raw_value = format_result(result, currency=currency)
+    return await secure_calc_result_store.mint_and_store_async(
+        scope,
+        raw_value=raw_value,
+        operation=operation.value,
+        operand_tokens=operand_tokens,
+        created_at=created_at,
+    )
+
+
+@dataclass(frozen=True)
+class CalcChatOutcome:
+    """In-chat secure-calc result. ``canonical`` carries the token; ``raw_value``
+    is restored to the OWNER display only (never logged/egressed)."""
+
+    canonical: str
+    token: str
+    raw_value: str
+
+
+# Minimum operand counts per operation for the in-chat path (binary ops are
+# already arity-2-checked by ``compute``).
+def _arity_ok(operation: CalcOperation, count: int) -> bool:
+    if operation in _BINARY_EXACT2:
+        return count == 2
+    return count >= 2  # sum/add/average/multiply need at least two operands
+
+
+async def orchestrate_secure_calc(
+    *,
+    scope: "VaultScope | None",
+    records: Iterable[Any],
+    user_text: str,
+    created_at: int,
+) -> "CalcChatOutcome | None":
+    """In-chat entry point. Detect intent + collect ELIGIBLE operands from the
+    turn's allocation records (in-memory; no provider/raw-text parsing), compute,
+    mint ``<CALC_n>``, and return the canonical template + raw result.
+
+    Returns ``None`` when there is no calc intent or too few eligible operands
+    (chat proceeds normally). Raises :class:`CalcError` when a calc WAS
+    requested over valid operands but cannot complete (e.g. division by zero) —
+    the caller renders a safe error template, never raw, never the provider.
+    """
+    # Local import avoids a module import cycle (intent imports this module).
+    from app.services.dlp.secure_calc_intent import detect_calc_operation, calc_template
+    from app.services.dlp.vault_v2 import build_entries_from_records
+
+    if scope is None or not scope.is_valid:
+        return None
+    operation = detect_calc_operation(user_text)
+    if operation is None:
+        return None
+
+    entries = build_entries_from_records(records, created_at=created_at)
+    eligible = [(e.token, e.raw_value) for e in entries if e.calculation_eligible]
+    if not _arity_ok(operation, len(eligible)):
+        return None  # not enough eligible operands → normal chat, no compute
+
+    operands = [parse_operand(raw) for _, raw in eligible]
+    operand_tokens = [tok for tok, _ in eligible]
+    result = compute(operation, operands)  # may raise CalcError → safe error
+    raw_value = format_result(result)
+    token, _entry = await secure_calc_result_store.mint_and_store_async(
+        scope,
+        raw_value=raw_value,
+        operation=operation.value,
+        operand_tokens=operand_tokens,
+        created_at=created_at,
+    )
+    return CalcChatOutcome(canonical=calc_template(operation, token), token=token, raw_value=raw_value)
diff --git a/backend/app/services/dlp/secure_calc_intent.py b/backend/app/services/dlp/secure_calc_intent.py
new file mode 100644
index 0000000..12165cd
--- /dev/null
+++ b/backend/app/services/dlp/secure_calc_intent.py
@@ -0,0 +1,63 @@
+"""Deterministic secure-calculator intent detection — Phase 4A.2.6.1.
+
+Keyword/phrase → :class:`CalcOperation`. NO LLM, no fuzzy matching, no eval.
+Ambiguous input (more than one distinct operation matched) → ``None`` (deny;
+chat proceeds normally). This NEVER inspects numbers — operand collection is a
+separate, Vault-V2-eligibility-gated step. NO raw value is read here.
+"""
+
+from __future__ import annotations
+
+import re
+
+from app.services.dlp.secure_calc import CalcOperation
+
+# Ordered (operation, pattern). All matched; if >1 distinct op → ambiguous.
+# NOTE: Thai has no word boundaries, so ``\b`` is used ONLY around the English
+# keywords; Thai keywords are matched as plain substrings. Stray Thai matches
+# are harmless — the calc still requires >= 2 Vault-V2-eligible operands.
+_PATTERNS: list[tuple[CalcOperation, re.Pattern]] = [
+    (CalcOperation.PERCENTAGE_CHANGE, re.compile(
+        r"เปอร์เซ็นต์(การเปลี่ยนแปลง|เพิ่มขึ้น|ลดลง)|percent(age)?\s*change|%\s*เปลี่ยน", re.IGNORECASE)),
+    (CalcOperation.AVERAGE, re.compile(r"ค่าเฉลี่ย|เฉลี่ย|\baverage\b|\bmean\b", re.IGNORECASE)),
+    (CalcOperation.DIFFERENCE, re.compile(
+        r"ส่วนต่าง|ผลต่าง|ลบ|หัก|\bdifference\b|\bsubtract\b|\bminus\b", re.IGNORECASE)),
+    (CalcOperation.MULTIPLY, re.compile(r"คูณ|\bmultiply\b|\btimes\b", re.IGNORECASE)),
+    (CalcOperation.DIVIDE, re.compile(r"หาร|\bdivide\b", re.IGNORECASE)),
+    (CalcOperation.SUM, re.compile(
+        r"ผลรวม|รวม|บวก|\bsum\b|\badd\b|\btotal\b", re.IGNORECASE)),
+]
+
+# Operation → deterministic Thai response template (the canonical assistant text
+# carries the result token; the owner display restores it to the raw result).
+_TEMPLATES: dict[CalcOperation, str] = {
+    CalcOperation.SUM: "ผลรวมคือ {tok}",
+    CalcOperation.ADD: "ผลรวมคือ {tok}",
+    CalcOperation.AVERAGE: "ค่าเฉลี่ยคือ {tok}",
+    CalcOperation.DIFFERENCE: "ส่วนต่างคือ {tok}",
+    CalcOperation.SUBTRACT: "ส่วนต่างคือ {tok}",
+    CalcOperation.MULTIPLY: "ผลคูณคือ {tok}",
+    CalcOperation.DIVIDE: "ผลหารคือ {tok}",
+    CalcOperation.PERCENTAGE_CHANGE: "เปอร์เซ็นต์การเปลี่ยนแปลงคือ {tok}",
+}
+
+# Safe wording when a calc was requested but cannot be performed securely.
+CALC_SAFE_ERROR = "ไม่สามารถคำนวณได้อย่างปลอดภัยจากข้อมูลที่มีอยู่"
+
+
+def detect_calc_operation(text: str) -> "CalcOperation | None":
+    """Return the single matched operation, or ``None`` (no/ambiguous intent)."""
+    if not isinstance(text, str) or not text.strip():
+        return None
+    matched = []
+    for op, pat in _PATTERNS:
+        if pat.search(text):
+            matched.append(op)
+    distinct = list(dict.fromkeys(matched))
+    if len(distinct) == 1:
+        return distinct[0]
+    return None  # zero matches OR ambiguous (>1 distinct) → deny
+
+
+def calc_template(operation: CalcOperation, token: str) -> str:
+    return _TEMPLATES.get(operation, "ผลลัพธ์คือ {tok}").format(tok=token)
diff --git a/backend/app/services/dlp/tool_arg_policy.py b/backend/app/services/dlp/tool_arg_policy.py
