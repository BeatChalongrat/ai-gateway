+			Message: "สร้างรูปแล้วแต่บันทึกไฟล์ไม่สำเร็จ กรุณาลองใหม่อีกครั้ง",
+			Status:  500,
+		}}
+	}
+	slog.Info("image_generation_direct_succeeded",
