+        token=token,
+        raw_value=original,
+        category=getattr(m, "category", "") or "",
+        detector=getattr(m, "detector_name", None),
+        entity_type=getattr(m, "entity_type", None),
+        action=ma.action.name,
+        policy_v2=dict(pv) if pv else {},
