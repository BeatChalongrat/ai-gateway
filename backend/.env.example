# Backend environment — copy to backend/.env and fill in for your
# deployment. Values in <brackets> are placeholders; validate_secrets()
# will crash the worker at startup if any insecure default slips
# through to a non-dev APP_ENV.

# --- Runtime ---
APP_ENV=development              # "development" / "test" / "production"
APP_PORT=8080
LOG_LEVEL=INFO
# Startup schema-drift guard (FIX 3). Empty = auto by APP_ENV (development →
# autoupgrade, else → failclosed). autoupgrade | failclosed | warn | off.
# SCHEMA_DRIFT_MODE=
# 3000=admin-ui, 3001=portal, 3002=web-chat. allow_credentials=True
# requires explicit origins (no "*"). Web-chat calls the gateway directly
# for silent refresh + /portal/me, so :3002 must be listed. In prod use
# the real portal + chat origins. Browser origins are https since FIX133
# (Caddy front door; docs/ops/tls.md).
CORS_ORIGINS=https://localhost:3000,https://localhost:3001,https://localhost:3002,http://localhost:5173

# --- Postgres / Redis ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_gateway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_HOST=localhost
REDIS_PORT=6379

# --- Security secrets (Phase 2A) ---
# Each MUST be >= 32 bytes of CSPRNG output. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
JWT_SECRET=<32+ byte secret>
MASTER_ENCRYPTION_KEY=<32+ byte secret>
# Portal user-auth secret. MUST be byte-identical to the Go chat-edge
# service's PORTAL_JWT_SECRET — the gateway mints the session JWT and
# chat-edge verifies it with the same key. Mismatch = every chat request
# 401s. validate_secrets() (and the Go Validate()) reject the dev default
# outside dev.
PORTAL_JWT_SECRET=<32+ byte secret>

# Provider API key encryption at rest (AES-256-GCM). 64 hex chars = 32
# bytes. Generate: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production (validate_secrets blocks startup if missing);
# empty in dev/test falls back to a deterministic dev key.
PROVIDER_KEY_MASTER_KEY=

# Rate-limit behaviour when Redis is unreachable — GENERAL TRAFFIC only
# (chat / image / media limiters):
#   fail_open    (default) — admit unlimited; rate limiting is a safety net
#   conservative          — apply a small in-process per-key limit instead
# Credential-guarding limiters (admin login, portal password reset) are
# NOT governed by this knob: they ALWAYS fall back to the in-process
# conservative cap during an outage (never fail open).
RATE_LIMIT_REDIS_OUTAGE_MODE=fail_open

# SSRF allowlist for Replicate result URLs (webhook output / poll output).
# Only https URLs on these hostnames (exact or subdomain) are fetched.
# Comma-separated. Default: replicate.delivery (Replicate's artifact CDN).
REPLICATE_DELIVERY_ALLOWED_HOSTS=replicate.delivery

# --- Portal auth cookies (HttpOnly cookie migration) ---
# The gateway sets the portal session as HttpOnly cookies (access +
# refresh). Access TTL is 60 min (PORTAL_ACCESS_TOKEN_EXPIRE_MINUTES);
# refresh TTL is 90 days (PORTAL_REFRESH_TOKEN_EXPIRE_DAYS) and rotates on
# every refresh, so an active session never expires.
#   AUTH_COOKIE_DOMAIN — empty = host-only (localhost shares across ports
#     in dev). In prod set a shared parent like ".yourdomain.com" so the
#     cookie reaches portal., chat., and api. sub-domains.
#   AUTH_COOKIE_SECURE — unset = auto (off in dev, ON outside dev/test).
#     Force true in any HTTPS deployment.
#   AUTH_COOKIE_SAMESITE — "lax" (default). Use "none" ONLY if chat/api
#     live on a different registrable domain than the portal (then Secure
#     is mandatory).
# Startup guard (validate_secrets, non-dev): SAMESITE must be
# lax|strict|none, and SAMESITE=none REQUIRES AUTH_COOKIE_DOMAIN + Secure
# — otherwise the process refuses to start (a wrong cookie scope doesn't
# error at runtime, it just 401s every web-chat/portal fetch).
# AUTH_COOKIE_DOMAIN=
# AUTH_COOKIE_SECURE=
# AUTH_COOKIE_SAMESITE=lax

# SESSION_SIGNING_SECRETS is a comma-separated rotation list.
# First entry signs new cookies; all entries verify. See
# RUNBOOK.md "Session signing key rotation" for the prepend-new /
# wait / drop-old procedure.
SESSION_SIGNING_SECRETS=<32+ byte secret>[,<previous 32+ byte secret>]

# Admin session cookie settings. Defaults are safe.
# SESSION_COOKIE_NAME=admin_session
# SESSION_IDLE_TTL_SECONDS=86400     # sliding 24h
# SESSION_ABSOLUTE_TTL_SECONDS=604800 # hard cap 7 days

# Origins the admin UI + portal run on — used for OAuth return_to
# safelist and CORS.
ADMIN_UI_ORIGIN=https://localhost:3000
PORTAL_ORIGIN=https://localhost:3001

# --- OAuth providers (Phase 2A Commit 4; SSO Phases 0-3) ---
# Empty = unconfigured; the relevant /oauth/start endpoint will fail
# fast on fetch_token. Fill in for the providers you support.
# OAUTH_GOOGLE_CLIENT_ID must be the SAME Google client the portal's
# NextAuth uses (the backend pins id_token `aud` to it). The secret
# lives ONLY here — never in the desktop app; the backend performs the
# code exchange for the desktop PKCE flow. Rotate the secret before
# prod (the dev one has been shared in chat/tooling).
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# --- Provider API keys ---
# These SEED provider_keys on a provider's FIRST boot and are ignored ever
# after; the admin console under /providers owns them from then on, with no
# restart needed. EDITING ONE OF THESE ON A RUNNING SYSTEM DOES NOTHING, and
# a key deleted in the UI stays deleted across restarts.
#
# A provider with no key returns HTTP 503 "No API key configured for provider
# '<name>'" — an intentional fail-safe rather than a silent mis-route.
# Placeholders are never seeded; the boot log says which providers were
# seeded, skipped, or already owned by the database.
#
# OPENAI_API_KEY also backs the embeddings (RAG / KB search) and voice
# (Whisper STT, TTS) clients — they resolve through the same key pool now, so
# rotating the key in the admin UI moves them too.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- DLP ---
DLP_ENABLED=true
DLP_DEFAULT_PROFILE=default
DLP_RAW_RETENTION_DAYS=90

# --- Google SSO sign-in policy (Phases 0-3) ---
# Comma-separated allowlist; empty = allow all domains. Server-side gate.
ALLOWED_EMAIL_DOMAINS=gbtech.co.th
# `hd` account-chooser hint on /oauth/start (UX only).
GOOGLE_HOSTED_DOMAIN=gbtech.co.th
# Central tenant every OAuth user joins (slug is the idempotency key).
CENTRAL_TENANT_SLUG=gbtech
CENTRAL_TENANT_NAME=GB Tech
# Phase 3 cutover: false = email+password surface (login/signup/
# password-reset) answers 403 password_login_disabled; UIs hide the
# form off /portal/auth/public-settings. Code stays for re-enable.
PASSWORD_LOGIN_ENABLED=false

# --- SRAN Desktop update NOTIFICATION (FIX22 §2, stage 1) ---
# The desktop version the operator wants installed, served by
# GET /v1/desktop/version as a bare string. The app compares it with its own
# version and shows a dismissible banner; the user installs by hand. No file,
# no URL, no feed (stage 2 — a signed update channel — waits for a code-signing
# certificate). Empty (default) = the endpoint 404s and the app shows nothing.
DESKTOP_LATEST_VERSION=
