<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Web-chat dark palette (globals.css :23-67) -->
    <Color x:Key="BgPrimaryColor">#212121</Color>
    <Color x:Key="BgSecondaryColor">#2F2F2F</Color>
    <!-- R12-fix-4: elevated card surface (login card) — brighter than BgSecondary -->
    <Color x:Key="BgElevatedColor">#383838</Color>
    <Color x:Key="BgSidebarColor">#171717</Color>
    <Color x:Key="TextPrimaryColor">#ECECEC</Color>
    <Color x:Key="TextSecondaryColor">#A0A0A0</Color>
    <Color x:Key="TextTertiaryColor">#6B6B6B</Color>
    <!-- Neutral accent = foreground (web has no blue) -->
    <Color x:Key="AccentColor">#ECECEC</Color>
    <Color x:Key="OnAccentColor">#212121</Color>
    <Color x:Key="AccentBlueColor">#60A5FA</Color>
    <Color x:Key="AccentGreenColor">#10A37F</Color>
    <Color x:Key="AccentRedColor">#EF4444</Color>
    <Color x:Key="AccentWarningColor">#F59E0B</Color>
    <Color x:Key="BorderColor">#3A3A3A</Color>
    <Color x:Key="UserBubbleColor">#2F2F2F</Color>
    <Color x:Key="AssistantBubbleColor">#212121</Color>
    <Color x:Key="CodeBgColor">#1E1E1E</Color>
    <Color x:Key="BgSelectedColor">#3A3A3A</Color>
    <Color x:Key="SidebarActiveColor">#2A2A2A</Color>
    <Color x:Key="AccentBlueHoverColor">#93C5FD</Color>
    <Color x:Key="AccentRedHoverColor">#FCA5A5</Color>

    <SolidColorBrush x:Key="BgPrimaryBrush" Color="{StaticResource BgPrimaryColor}" />
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondaryColor}" />
    <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource BgElevatedColor}" />
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebarColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}" />
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreenColor}" />
    <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRedColor}" />
    <SolidColorBrush x:Key="AccentWarningBrush" Color="{StaticResource AccentWarningColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="UserBubbleBrush" Color="{StaticResource UserBubbleColor}" />
    <SolidColorBrush x:Key="AssistantBubbleBrush" Color="{StaticResource AssistantBubbleColor}" />
    <SolidColorBrush x:Key="CodeBgBrush" Color="{StaticResource CodeBgColor}" />
    <SolidColorBrush x:Key="CodeTextBrush" Color="#D4D4D4" />
    <SolidColorBrush x:Key="CodeHeaderBgBrush" Color="#2D2D2D" />
    <!-- Syntax highlighting (Phase 4) — all ≥ WCAG AA on CodeBg #1E1E1E -->
    <SolidColorBrush x:Key="SynKeywordBrush" Color="#569CD6" />
    <SolidColorBrush x:Key="SynStringBrush" Color="#CE9178" />
    <SolidColorBrush x:Key="SynCommentBrush" Color="#6A9955" />
    <SolidColorBrush x:Key="SynNumberBrush" Color="#B5CEA8" />
    <SolidColorBrush x:Key="SynTypeBrush" Color="#4EC9B0" />
    <SolidColorBrush x:Key="BgSelectedBrush" Color="{StaticResource BgSelectedColor}" />
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="{StaticResource SidebarActiveColor}" />
    <SolidColorBrush x:Key="AccentBlueHoverBrush" Color="{StaticResource AccentBlueHoverColor}" />
    <SolidColorBrush x:Key="AccentRedHoverBrush" Color="{StaticResource AccentRedHoverColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="White" />
    <!-- Danger menu-item hover: ~15% red wash (web bg-status-danger/15) -->
    <SolidColorBrush x:Key="DangerHoverBgBrush" Color="#26EF4444" />
    <!-- Auto-model sparkle (web's purple accent) -->
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="#8B5CF6" />

    <!-- Owl logo: white variant for the dark canvas -->
    <BitmapImage x:Key="LogoSource"
                 UriSource="pack://application:,,,/SranDesktop.Presentation;component/Assets/sran-logo-white.png" />

</ResourceDictionary>
