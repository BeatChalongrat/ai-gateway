<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Web-chat light palette (globals.css :87-100) -->
    <Color x:Key="BgPrimaryColor">#FFFFFF</Color>
    <Color x:Key="BgSecondaryColor">#F0F0F0</Color>
    <!-- R12-fix-4: elevated card surface (login card) -->
    <Color x:Key="BgElevatedColor">#FFFFFF</Color>
    <Color x:Key="BgSidebarColor">#F9F9F9</Color>
    <Color x:Key="TextPrimaryColor">#0D0D0D</Color>
    <Color x:Key="TextSecondaryColor">#5B5B5B</Color>
    <Color x:Key="TextTertiaryColor">#8A8A8A</Color>
    <!-- Neutral accent = foreground (web has no blue) -->
    <Color x:Key="AccentColor">#0D0D0D</Color>
    <Color x:Key="OnAccentColor">#FFFFFF</Color>
    <Color x:Key="AccentBlueColor">#3B82F6</Color>
    <Color x:Key="AccentGreenColor">#10A37F</Color>
    <Color x:Key="AccentRedColor">#EF4444</Color>
    <Color x:Key="AccentAmberColor">#D9822B</Color>
    <Color x:Key="AccentWarningColor">#F59E0B</Color>
    <Color x:Key="BorderColor">#E5E5E5</Color>
    <Color x:Key="UserBubbleColor">#F0F0F0</Color>
    <Color x:Key="AssistantBubbleColor">#FFFFFF</Color>
    <!-- Code blocks are theme-aware (light in light theme, per web) -->
    <Color x:Key="CodeBgColor">#F7F7F8</Color>
    <Color x:Key="BgSelectedColor">#E5E5E5</Color>
    <Color x:Key="SidebarActiveColor">#E5E5E5</Color>
    <Color x:Key="AccentBlueHoverColor">#60A5FA</Color>
    <Color x:Key="AccentRedHoverColor">#F87171</Color>

    <SolidColorBrush x:Key="BgPrimaryBrush" Color="{StaticResource BgPrimaryColor}" />
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondaryColor}" />
    <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource BgElevatedColor}" />
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebarColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}" />
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreenColor}" />
    <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRedColor}" />
    <SolidColorBrush x:Key="AccentAmberBrush" Color="{StaticResource AccentAmberColor}" />
    <SolidColorBrush x:Key="AccentWarningBrush" Color="{StaticResource AccentWarningColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="UserBubbleBrush" Color="{StaticResource UserBubbleColor}" />
    <SolidColorBrush x:Key="AssistantBubbleBrush" Color="{StaticResource AssistantBubbleColor}" />
    <SolidColorBrush x:Key="CodeBgBrush" Color="{StaticResource CodeBgColor}" />
    <SolidColorBrush x:Key="CodeTextBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="CodeHeaderBgBrush" Color="#EEEEEE" />
    <!-- Syntax highlighting (Phase 4) — all ≥ WCAG AA on CodeBg #F7F7F8 -->
    <SolidColorBrush x:Key="SynKeywordBrush" Color="#0000CC" />
    <SolidColorBrush x:Key="SynStringBrush" Color="#A31515" />
    <SolidColorBrush x:Key="SynCommentBrush" Color="#008000" />
    <SolidColorBrush x:Key="SynNumberBrush" Color="#0B7A50" />
    <SolidColorBrush x:Key="SynTypeBrush" Color="#1F6B80" />
    <SolidColorBrush x:Key="BgSelectedBrush" Color="{StaticResource BgSelectedColor}" />
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="{StaticResource SidebarActiveColor}" />
    <SolidColorBrush x:Key="AccentBlueHoverBrush" Color="{StaticResource AccentBlueHoverColor}" />
    <SolidColorBrush x:Key="AccentRedHoverBrush" Color="{StaticResource AccentRedHoverColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="White" />
    <!-- Danger menu-item hover: ~15% red wash (web bg-status-danger/15) -->
    <SolidColorBrush x:Key="DangerHoverBgBrush" Color="#26EF4444" />
    <!-- Auto-model sparkle (web's purple accent) -->
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="#8B5CF6" />

    <!-- Owl logo: black artwork for the light canvas -->
    <BitmapImage x:Key="LogoSource"
                 UriSource="pack://application:,,,/SranDesktop.Presentation;component/Assets/sran-logo.png" />

</ResourceDictionary>
