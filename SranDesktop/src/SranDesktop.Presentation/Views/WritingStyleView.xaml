<Window x:Class="SranDesktop.Presentation.Views.WritingStyleView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:SranDesktop.Presentation.Converters"
        xmlns:controls="clr-namespace:SranDesktop.Presentation.Controls"
        xmlns:vm="clr-namespace:SranDesktop.Presentation.ViewModels"
        xmlns:loc="clr-namespace:SranDesktop.Presentation.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:WritingStyleViewModel}"
        Title="{loc:T style.title}"
        Width="560" Height="600"
        MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,24,24,12">
            <StackPanel Orientation="Horizontal">
                <controls:IconView Geometry="{StaticResource Geo_PenLine}"
                                   Stroke="{DynamicResource TextPrimaryBrush}"
                                   Width="20" Height="20" Margin="0,0,10,0"
                                   VerticalAlignment="Center" />
                <TextBlock Text="{loc:T style.title}" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{loc:T style.subtitle}" FontSize="12.5" Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,20">
            <StackPanel>
                <!-- Active profile card -->
                <Border Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12"
                        Padding="14,12" Margin="0,4,0,14"
                        Visibility="{Binding HasProfile, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Style="{DynamicResource PillButton}" Padding="10,3"
                                    Command="{Binding ClearProfileCommand}">
                                <TextBlock Text="{loc:T style.clear}" FontSize="11.5" />
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <controls:IconView Geometry="{StaticResource Geo_Check}"
                                                   Stroke="{DynamicResource AccentGreenBrush}"
                                                   Width="14" Height="14" Margin="0,0,7,0"
                                                   VerticalAlignment="Center" />
                                <TextBlock Text="{loc:T style.active}" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding Profile}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Samples input -->
                <TextBlock Text="{loc:T style.samplesHint}" FontSize="12" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox Text="{Binding Samples, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="180" MaxHeight="280"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,12" />

                <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Margin="0,0,0,8"
                           TextWrapping="Wrap" Foreground="{DynamicResource AccentRedBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid>
                    <Button Style="{DynamicResource AccentButton}" Padding="18,7"
                            HorizontalAlignment="Center"
                            Command="{Binding AnalyzeCommand}"
                            Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <TextBlock Text="{loc:T style.analyze}" FontSize="13" FontWeight="Medium" />
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar Width="120" Height="4" IsIndeterminate="True"
                                     VerticalAlignment="Center" />
                        <TextBlock Text="{loc:T style.analyzing}" FontSize="12.5" Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
