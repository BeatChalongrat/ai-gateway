<Window x:Class="SranDesktop.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:SranDesktop.Presentation.Converters"
        xmlns:controls="clr-namespace:SranDesktop.Presentation.Controls"
        xmlns:views="clr-namespace:SranDesktop.Presentation.Views"
        xmlns:vm="clr-namespace:SranDesktop.Presentation.ViewModels"
        xmlns:loc="clr-namespace:SranDesktop.Presentation.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Style="{DynamicResource WindowBaseStyle}"
        Title="SRAN Desktop"
        Icon="pack://application:,,,/SranDesktop;component/Assets/app.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        Width="1200" Height="760"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Custom window control buttons (min / max / close) -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgSelectedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CloseTitleBarButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />  <!-- update banner (R11 A1d) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (draggable via WindowChrome caption) -->
        <Border Grid.Row="0" Background="{DynamicResource BgSidebarBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButton}"
                            Click="MinimizeButton_Click" ToolTip="Minimize"
                            AutomationProperties.Name="Minimize">
                        <Path Data="M0,0 H10" Stretch="None"
                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}"
                            Click="MaximizeButton_Click" ToolTip="Maximize"
                            AutomationProperties.Name="Maximize">
                        <Path Data="M0,0 H10 V10 H0 Z" Stretch="None"
                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1" />
                    </Button>
                    <Button Style="{StaticResource CloseTitleBarButton}"
                            Click="CloseButton_Click" ToolTip="Close"
                            AutomationProperties.Name="Close">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stretch="None"
                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1" />
                    </Button>
                </StackPanel>
                <!-- drag area -->
                <Border Background="Transparent" />
            </DockPanel>
        </Border>

        <!-- Update notification bar (R11 A1d) -->
        <Border Grid.Row="1" Background="{DynamicResource AccentBrush}" Padding="12,7"
                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Margin="10,0,0,0" Padding="12,3"
                            Background="Transparent" BorderThickness="1"
                            BorderBrush="{DynamicResource OnAccentBrush}"
                            Foreground="{DynamicResource OnAccentBrush}"
                            controls:ButtonHelper.CornerRadius="6"
                            Command="{Binding InstallUpdateCommand}">
                        <TextBlock Text="{loc:T update.install}" FontSize="12" FontWeight="SemiBold" />
                    </Button>
                    <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,3"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource OnAccentBrush}" Opacity="0.75"
                            Command="{Binding DismissUpdateCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <!-- mandatory updates can't be postponed (A1d) -->
                                    <DataTrigger Binding="{Binding IsUpdateMandatory}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{loc:T update.later}" FontSize="12" />
                    </Button>
                    <TextBlock VerticalAlignment="Center" FontSize="12.5"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource OnAccentBrush}">
                        <Run Text="{loc:T update.available}" />
                        <Run Text="{Binding UpdateVersion, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" " /><Run Text="{Binding UpdateNotes, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
                <!-- download progress (A1e) -->
                <ProgressBar Height="3" Margin="0,6,0,0"
                             Minimum="0" Maximum="1"
                             Value="{Binding UpdateDownloadProgress, Mode=OneWay}"
                             Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

    <Grid Grid.Row="2">
        <!-- Main shell -->
        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar (width animated by the toggle) -->
            <Grid Grid.Column="0"
                  x:Name="SidebarRoot"
                  Width="264"
                  ClipToBounds="True"
                  Background="{DynamicResource BgSidebarBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Projects section (R9 Feature B4) -->
                <StackPanel Grid.Row="0"
                            Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel Margin="16,10,10,2">
                        <Button DockPanel.Dock="Right" Style="{DynamicResource IconButton}"
                                Width="22" Height="22"
                                Command="{Binding CreateProjectCommand}"
                                AutomationProperties.Name="New project"
                                ToolTip="{loc:T project.create}">
                            <controls:IconView Geometry="{StaticResource Geo_Plus}"
                                               Stroke="{DynamicResource TextTertiaryBrush}"
                                               Width="12" Height="12" />
                        </Button>
                        <TextBlock Text="{loc:T sidebar.projects}" FontSize="10" FontWeight="Medium"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Projects}" MaxHeight="150">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{DynamicResource FlatRowButton}" Margin="8,1"
                                        Command="{Binding DataContext.OpenProjectCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:IconView Geometry="{StaticResource Geo_Folder}"
                                                           Stroke="{DynamicResource AccentBrush}"
                                                           Width="14" Height="14" Margin="0,0,8,0"
                                                           VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Height="1" Margin="12,6,12,0"
                            Background="{DynamicResource BorderBrush}" Opacity="0.5" />
                </StackPanel>

                <views:SidebarView Grid.Row="1" x:Name="SidebarControl"
                                   DataContext="{Binding Conversations}"
                                   CollapseRequested="SidebarControl_CollapseRequested" />

                <!-- Account footer: avatar + email + overflow menu (web parity Fix 2) -->
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,8">
                    <DockPanel LastChildFill="True">
                        <!-- avatar -->
                        <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="14"
                                Background="{DynamicResource BgSecondaryBrush}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding AvatarInitial}" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Border>

                        <!-- overflow "..." → settings popup panel (web parity R5) -->
                        <Button DockPanel.Dock="Right"
                                x:Name="UserMenuButton"
                                Click="UserMenuButton_Click"
                                Style="{DynamicResource IconButton}"
                                Width="28" Height="28" Margin="4,0,0,0"
                                AutomationProperties.Name="Account menu"
                                ToolTip="Account">
                            <controls:IconView Geometry="{StaticResource Geo_More}"
                                               Stroke="{DynamicResource TextSecondaryBrush}"
                                               Width="14" Height="14" />
                        </Button>

                        <!-- email -->
                        <TextBlock Text="{Binding UserEmail}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12" />
                    </DockPanel>
                </Border>

                <!-- Settings popup panel above the user footer (web parity R5) -->
                <Popup x:Name="UserMenuPopup"
                       PlacementTarget="{Binding ElementName=UserMenuButton}"
                       Placement="Top"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="4,6"
                            Margin="8"
                            MinWidth="260">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4"
                                              Opacity="0.4" Color="Black" />
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel.Resources>
                                <!-- Small grey group label between menu sections (R8 B1) -->
                                <Style x:Key="MenuSectionHeader" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="10.5" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                    <Setter Property="Margin" Value="12,10,12,2" />
                                </Style>
                                <Style x:Key="MenuSectionDivider" TargetType="Border">
                                    <Setter Property="Height" Value="1" />
                                    <Setter Property="Margin" Value="8,6,8,0" />
                                    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
                                    <Setter Property="Opacity" Value="0.6" />
                                </Style>
                            </StackPanel.Resources>

                            <!-- ── APPEARANCE ── -->
                            <TextBlock Style="{StaticResource MenuSectionHeader}"
                                       Text="{loc:T menu.section.appearance}" />

                            <!-- 1. Dark mode: toggles live, popup stays open -->
                            <Button Style="{DynamicResource FlatRowButton}" Height="40"
                                    Command="{Binding ToggleThemeCommand}"
                                    AutomationProperties.Name="Dark mode">
                                <DockPanel LastChildFill="True">
                                    <controls:IconView DockPanel.Dock="Left"
                                                       Width="16" Height="16" Margin="0,0,10,0"
                                                       VerticalAlignment="Center"
                                                       Stroke="{DynamicResource TextSecondaryBrush}">
                                        <controls:IconView.Style>
                                            <Style TargetType="controls:IconView">
                                                <Setter Property="Geometry" Value="{StaticResource Geo_Sun}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                        <Setter Property="Geometry" Value="{StaticResource Geo_Moon}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:IconView.Style>
                                    </controls:IconView>
                                    <!-- toggle pill -->
                                    <Border DockPanel.Dock="Right" Width="36" Height="20"
                                            CornerRadius="10" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource BgSelectedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentGreenBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Ellipse Width="14" Height="14" Fill="White" Margin="3,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Border>
                                    <TextBlock Text="{loc:T menu.darkMode}" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </DockPanel>
                            </Button>

                            <!-- 2. Language toggle: EN ↔ TH, live re-labels the whole UI (R7 F4) -->
                            <Button Style="{DynamicResource FlatRowButton}" Height="40"
                                    Click="ToggleLanguage_Click"
                                    AutomationProperties.Name="Language">
                                <DockPanel LastChildFill="True">
                                    <controls:IconView DockPanel.Dock="Left"
                                                       Geometry="{StaticResource Geo_Browser}"
                                                       Stroke="{DynamicResource TextSecondaryBrush}"
                                                       Width="16" Height="16" Margin="0,0,10,0"
                                                       VerticalAlignment="Center" />
                                    <Border DockPanel.Dock="Right" CornerRadius="5" Padding="6,2"
                                            Background="{DynamicResource BgSelectedBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Source={x:Static loc:LocaleService.Instance}, Path=LocaleUpper}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="{loc:T menu.language}" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </DockPanel>
                            </Button>

                            <!-- ── DATA ── -->
                            <Border Style="{StaticResource MenuSectionDivider}" />
                            <TextBlock Style="{StaticResource MenuSectionHeader}"
                                       Text="{loc:T menu.section.data}" />

                            <!-- 3. Knowledge Base (in-app dialog) -->
                            <Button Style="{DynamicResource FlatRowButton}" Height="40"
                                    Click="OpenKnowledgeBase_Click"
                                    AutomationProperties.Name="Knowledge Base">
                                <DockPanel LastChildFill="True">
                                    <controls:IconView DockPanel.Dock="Left"
                                                       Geometry="{StaticResource Geo_BookOpen}"
                                                       Stroke="{DynamicResource TextSecondaryBrush}"
                                                       Width="16" Height="16" Margin="0,0,10,0"
                                                       VerticalAlignment="Center" />
                                    <controls:IconView DockPanel.Dock="Right"
                                                       Geometry="{StaticResource Geo_ChevronRight}"
                                                       Stroke="{DynamicResource TextTertiaryBrush}"
                                                       Width="12" Height="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:T menu.knowledgeBase}" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </DockPanel>
                            </Button>

                            <!-- 4. Memory (in-app dialog) -->
                            <Button Style="{DynamicResource FlatRowButton}" Height="40"
                                    Click="OpenMemory_Click"
                                    AutomationProperties.Name="Memory settings">
                                <DockPanel LastChildFill="True">
                                    <controls:IconView DockPanel.Dock="Left"
                                                       Geometry="{StaticResource Geo_Brain}"
                                                       Stroke="{DynamicResource TextSecondaryBrush}"
                                                       Width="16" Height="16" Margin="0,0,10,0"
                                                       VerticalAlignment="Center" />
                                    <controls:IconView DockPanel.Dock="Right"
                                                       Geometry="{StaticResource Geo_ChevronRight}"
                                                       Stroke="{DynamicResource TextTertiaryBrush}"
                                                       Width="12" Height="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:T menu.memory}" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </DockPanel>
                            </Button>

                            <!-- ── OTHER ── -->
                            <Border Style="{StaticResource MenuSectionDivider}" />
                            <TextBlock Style="{StaticResource MenuSectionHeader}"
                                       Text="{loc:T menu.section.other}" />

                            <!-- 5. Voice Settings (live since R9 J) -->
                            <Button Style="{DynamicResource FlatRowButton}" Height="40"
                                    Click="OpenVoiceSettings_Click"
                                    AutomationProperties.Name="Voice Settings">
                                <DockPanel LastChildFill="True">
                                    <controls:IconView DockPanel.Dock="Left"
                                                       Geometry="{StaticResource Geo_Mic}"
                                                       Stroke="{DynamicResource TextSecondaryBrush}"
                                                       Width="16" Height="16" Margin="0,0,10,0"
                                                       VerticalAlignment="Center" />
                                    <controls:IconView DockPanel.Dock="Right"
                                                       Geometry="{StaticResource Geo_ChevronRight}"
                                                       Stroke="{DynamicResource TextTertiaryBrush}"
                                                       Width="12" Height="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:T menu.voiceSettings}" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </DockPanel>
                            </Button>

                            <!-- 6. Desktop-specific settings (tray, auto-start, URLs, cleanup) -->
                            <Button Style="{DynamicResource FlatRowButton}" Height="40"
                                    Click="OpenDesktopSettings_Click"
                                    AutomationProperties.Name="Desktop settings">
                                <DockPanel LastChildFill="True">
                                    <controls:IconView DockPanel.Dock="Left"
                                                       Geometry="{StaticResource Geo_Settings}"
                                                       Stroke="{DynamicResource TextSecondaryBrush}"
                                                       Width="16" Height="16" Margin="0,0,10,0"
                                                       VerticalAlignment="Center" />
                                    <controls:IconView DockPanel.Dock="Right"
                                                       Geometry="{StaticResource Geo_ChevronRight}"
                                                       Stroke="{DynamicResource TextTertiaryBrush}"
                                                       Width="12" Height="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:T menu.desktopSettings}" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </DockPanel>
                            </Button>

                            <!-- R9: Scheduled tasks -->
                            <Button Style="{DynamicResource FlatRowButton}" Height="40"
                                    Click="OpenScheduledTasks_Click"
                                    AutomationProperties.Name="Scheduled tasks">
                                <DockPanel LastChildFill="True">
                                    <controls:IconView DockPanel.Dock="Left"
                                                       Geometry="{StaticResource Geo_Calendar}"
                                                       Stroke="{DynamicResource TextSecondaryBrush}"
                                                       Width="16" Height="16" Margin="0,0,10,0"
                                                       VerticalAlignment="Center" />
                                    <controls:IconView DockPanel.Dock="Right"
                                                       Geometry="{StaticResource Geo_ChevronRight}"
                                                       Stroke="{DynamicResource TextTertiaryBrush}"
                                                       Width="12" Height="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:T menu.scheduledTasks}" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </DockPanel>
                            </Button>

                            <!-- R9: Skills -->
                            <Button Style="{DynamicResource FlatRowButton}" Height="40"
                                    Click="OpenSkills_Click"
                                    AutomationProperties.Name="Skills">
                                <DockPanel LastChildFill="True">
                                    <controls:IconView DockPanel.Dock="Left"
                                                       Geometry="{StaticResource Geo_Puzzle}"
                                                       Stroke="{DynamicResource TextSecondaryBrush}"
                                                       Width="16" Height="16" Margin="0,0,10,0"
                                                       VerticalAlignment="Center" />
                                    <controls:IconView DockPanel.Dock="Right"
                                                       Geometry="{StaticResource Geo_ChevronRight}"
                                                       Stroke="{DynamicResource TextTertiaryBrush}"
                                                       Width="12" Height="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:T menu.skills}" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </DockPanel>
                            </Button>

                            <!-- R9: Connector marketplace -->
                            <Button Style="{DynamicResource FlatRowButton}" Height="40"
                                    Click="OpenConnectors_Click"
                                    AutomationProperties.Name="Connectors">
                                <DockPanel LastChildFill="True">
                                    <controls:IconView DockPanel.Dock="Left"
                                                       Geometry="{StaticResource Geo_Store}"
                                                       Stroke="{DynamicResource TextSecondaryBrush}"
                                                       Width="16" Height="16" Margin="0,0,10,0"
                                                       VerticalAlignment="Center" />
                                    <controls:IconView DockPanel.Dock="Right"
                                                       Geometry="{StaticResource Geo_ChevronRight}"
                                                       Stroke="{DynamicResource TextTertiaryBrush}"
                                                       Width="12" Height="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:T menu.connectors}" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </DockPanel>
                            </Button>

                            <!-- R9: Writing style -->
                            <Button Style="{DynamicResource FlatRowButton}" Height="40"
                                    Click="OpenWritingStyle_Click"
                                    AutomationProperties.Name="Writing style">
                                <DockPanel LastChildFill="True">
                                    <controls:IconView DockPanel.Dock="Left"
                                                       Geometry="{StaticResource Geo_PenLine}"
                                                       Stroke="{DynamicResource TextSecondaryBrush}"
                                                       Width="16" Height="16" Margin="0,0,10,0"
                                                       VerticalAlignment="Center" />
                                    <controls:IconView DockPanel.Dock="Right"
                                                       Geometry="{StaticResource Geo_ChevronRight}"
                                                       Stroke="{DynamicResource TextTertiaryBrush}"
                                                       Width="12" Height="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:T style.profile}" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </DockPanel>
                            </Button>

                            <!-- 7. Keyboard shortcuts (Ctrl+/) -->
                            <Button Style="{DynamicResource FlatRowButton}" Height="40"
                                    Click="OpenShortcuts_Click"
                                    AutomationProperties.Name="Keyboard shortcuts">
                                <DockPanel LastChildFill="True">
                                    <controls:IconView DockPanel.Dock="Left"
                                                       Geometry="{StaticResource Geo_Keyboard}"
                                                       Stroke="{DynamicResource TextSecondaryBrush}"
                                                       Width="16" Height="16" Margin="0,0,10,0"
                                                       VerticalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="Ctrl+/" FontSize="11" Opacity="0.7"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBlock Text="{loc:T menu.keyboardShortcuts}" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </DockPanel>
                            </Button>

                            <Border Height="1" Margin="8,5"
                                    Background="{DynamicResource BorderBrush}" Opacity="0.6" />

                            <!-- 7. Log out (red) -->
                            <Button Style="{DynamicResource FlatRowButton}" Height="40"
                                    Click="Logout_Click"
                                    AutomationProperties.Name="Log out">
                                <DockPanel LastChildFill="True">
                                    <controls:IconView DockPanel.Dock="Left"
                                                       Geometry="{StaticResource Geo_Logout}"
                                                       Stroke="{DynamicResource AccentRedBrush}"
                                                       Width="16" Height="16" Margin="0,0,10,0"
                                                       VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:T menu.logout}" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentRedBrush}" />
                                </DockPanel>
                            </Button>

                            <!-- App version footer (R11 A1f) -->
                            <TextBlock FontSize="10.5" Margin="12,6,12,2"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}">
                                <Run Text="{loc:T settings.version}" />
                                <Run Text="{Binding AppVersion, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- Content area -->
            <Grid Grid.Column="1" Background="{DynamicResource BgPrimaryBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header bar -->
                <Border Grid.Row="0" Padding="8,6"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />  <!-- sidebar toggle -->
                            <ColumnDefinition Width="*" />     <!-- spacer (no centered title) -->
                            <ColumnDefinition Width="Auto" />  <!-- Share (R9 K) -->
                            <ColumnDefinition Width="Auto" />  <!-- Memory -->
                            <ColumnDefinition Width="Auto" />  <!-- more menu -->
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{DynamicResource IconButton}"
                                AutomationProperties.Name="Toggle sidebar"
                                ToolTip="Toggle sidebar (Ctrl+Shift+S)"
                                Click="ToggleSidebar_Click">
                            <controls:IconView Geometry="{StaticResource Geo_SidebarToggle}"
                                               Stroke="{DynamicResource TextSecondaryBrush}"
                                               Width="17" Height="17" />
                        </Button>

                        <!-- No agent toggle: every turn runs the always-on tool loop;
                             the model decides when to use tools (Claude-style). -->

                        <!-- Share (R9 K2) -->
                        <Button Grid.Column="2"
                                Style="{DynamicResource PillButton}"
                                Margin="0,0,4,0"
                                Command="{Binding Chat.ShareCommand}"
                                AutomationProperties.Name="Share"
                                ToolTip="{loc:T header.share}"
                                Visibility="{Binding Chat.HasActiveConversation, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <controls:IconView Geometry="{StaticResource Geo_Share}"
                                                   Stroke="{DynamicResource TextSecondaryBrush}"
                                                   Width="15" Height="15" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:T header.share}" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Button>

                        <!-- Memory chip (visible only with an active conversation — R2 Fix 2)
                             + pending-suggestions badge (R7 E5) -->
                        <Grid Grid.Column="3"
                              Visibility="{Binding Chat.HasActiveConversation, Converter={StaticResource BoolToVisibility}}">
                            <Button x:Name="MemoryButton"
                                    Style="{DynamicResource PillButton}"
                                    Margin="0,0,4,0"
                                    Click="MemoryButton_Click"
                                    AutomationProperties.Name="Memory"
                                    ToolTip="{loc:T header.memory}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconView Geometry="{StaticResource Geo_Brain}"
                                                       Stroke="{DynamicResource TextSecondaryBrush}"
                                                       Width="16" Height="16" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:T header.memory}" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="8"
                                    Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-5,-2,0" IsHitTestVisible="False"
                                    Visibility="{Binding Chat.HasPendingMemories, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Chat.PendingMemoryCount}" FontSize="10"
                                           Foreground="{DynamicResource OnAccentBrush}" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <!-- "..." export menu (visible only with an active conversation — R2 Fix 2) -->
                        <Button Grid.Column="4"
                                x:Name="MoreMenuButton"
                                Style="{DynamicResource IconButton}"
                                Click="MoreMenuButton_Click"
                                AutomationProperties.Name="More options"
                                ToolTip="More options"
                                Visibility="{Binding Chat.HasActiveConversation, Converter={StaticResource BoolToVisibility}}">
                            <controls:IconView Geometry="{StaticResource Geo_More}"
                                               Stroke="{DynamicResource TextSecondaryBrush}"
                                               Width="18" Height="18" />
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{loc:T header.exportMarkdown}"
                                              Command="{Binding Chat.ExportMarkdownCommand}">
                                        <MenuItem.Icon>
                                            <controls:IconView Geometry="{StaticResource Geo_FileText}"
                                                               Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                                                               Width="14" Height="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:T header.exportJson}"
                                              Command="{Binding Chat.ExportJsonCommand}">
                                        <MenuItem.Icon>
                                            <controls:IconView Geometry="{StaticResource Geo_FileCode}"
                                                               Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                                                               Width="14" Height="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="{loc:T header.copyMarkdown}"
                                              Command="{Binding Chat.CopyMarkdownCommand}">
                                        <MenuItem.Icon>
                                            <controls:IconView Geometry="{StaticResource Geo_Copy}"
                                                               Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                                                               Width="14" Height="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <!-- Memory popover -->
                        <Popup x:Name="MemoryPopup"
                               PlacementTarget="{Binding ElementName=MemoryButton}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Margin="8"
                                    Background="{DynamicResource BgPrimaryBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10"
                                    Padding="6" MinWidth="240">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2"
                                                      Opacity="0.35" Color="Black" />
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Margin="10,6,10,2" FontSize="11"
                                               Foreground="{DynamicResource TextTertiaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{loc:T header.memoryOn}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Chat.MemoryEnabled}" Value="False">
                                                        <Setter Property="Text" Value="{loc:T header.memoryOff}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Style="{DynamicResource FlatRowButton}"
                                            Click="MemoryToggle_Click"
                                            AutomationProperties.Name="Toggle memory for this chat">
                                        <TextBlock FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{loc:T header.memoryTurnOff}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Chat.MemoryEnabled}" Value="False">
                                                            <Setter Property="Text" Value="{loc:T header.memoryTurnOn}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                    <Border Height="1" Margin="4,4"
                                            Background="{DynamicResource BorderBrush}" />
                                    <Button Style="{DynamicResource FlatRowButton}"
                                            Click="OpenMemorySettings_Click"
                                            AutomationProperties.Name="Open Memory Settings">
                                        <TextBlock Text="{loc:T header.openMemorySettings}" FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <!-- Empty state: logo + greeting + composer + suggestion chips.
                         Stretch + MaxWidth makes WPF size this to exactly 768 and centre
                         it, so the composer child can fill the full 768 (web parity Fix 3). -->
                    <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                MaxWidth="768">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveConversation}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Image Source="{DynamicResource LogoSource}"
                               Width="80" Height="80" Margin="0,0,0,18"
                               HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <TextBlock Text="{Binding Greeting}"
                                   FontSize="30" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{loc:T empty.subtitle}"
                                   Margin="0,6,0,24"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <!-- Composer (shared control) — type here to start a chat -->
                        <controls:ComposerControl DataContext="{Binding Chat}" Margin="0" />

                        <!-- Suggestion chips: horizontal full-pill row -->
                        <WrapPanel HorizontalAlignment="Center" Margin="0,16,0,0">
                            <WrapPanel.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Margin" Value="4" />
                                    <Setter Property="Padding" Value="16,8" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="Command" Value="{Binding SuggestionCommand}" />
                                    <Setter Property="controls:ButtonHelper.CornerRadius" Value="18" />
                                </Style>
                            </WrapPanel.Resources>
                            <Button CommandParameter="Help me draft ">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconView Geometry="{StaticResource Geo_Edit}" Width="14" Height="14"
                                                       Stroke="{DynamicResource TextTertiaryBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="{loc:T empty.chip.write}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button CommandParameter="Explain ">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconView Geometry="{StaticResource Geo_Learn}" Width="14" Height="14"
                                                       Stroke="{DynamicResource TextTertiaryBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="{loc:T empty.chip.learn}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button CommandParameter="Write code ">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconView Geometry="{StaticResource Geo_Code}" Width="14" Height="14"
                                                       Stroke="{DynamicResource TextTertiaryBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="{loc:T empty.chip.code}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button CommandParameter="Analyze ">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconView Geometry="{StaticResource Geo_Analyze}" Width="14" Height="14"
                                                       Stroke="{DynamicResource TextTertiaryBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="{loc:T empty.chip.analyze}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Chat -->
                    <views:ChatView DataContext="{Binding Chat}">
                        <views:ChatView.Style>
                            <Style TargetType="views:ChatView">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Conversation}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:ChatView.Style>
                    </views:ChatView>

                    <!-- Credits badge, bottom-right (web parity R6) -->
                    <Button x:Name="UsageBadge"
                            Style="{DynamicResource FlatRowButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,14,10" Padding="10,5"
                            Panel.ZIndex="10"
                            Click="UsageBadge_Click"
                            AutomationProperties.Name="Usage"
                            ToolTip="Credits remaining">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9"
                                     Stroke="{DynamicResource AccentGreenBrush}" StrokeThickness="2"
                                     Fill="Transparent" Margin="0,0,6,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CreditsRemainingText}"
                                       FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <controls:IconView Geometry="{StaticResource Geo_ChevronUp}"
                                               Stroke="{DynamicResource TextTertiaryBrush}"
                                               Width="10" Height="10" Margin="5,1,0,0"
                                               VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Usage popup -->
                    <Popup x:Name="UsagePopup"
                           PlacementTarget="{Binding ElementName=UsageBadge}"
                           Placement="Top"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Margin="8"
                                Background="{DynamicResource BgPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12"
                                Padding="14" Width="340">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="3"
                                                  Opacity="0.4" Color="Black" />
                            </Border.Effect>
                            <StackPanel>
                                <!-- header -->
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="Usage" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                            Style="{DynamicResource FlatRowButton}" Padding="6,2"
                                            Click="OpenPortalUsage_Click">
                                        <TextBlock Text="View in Portal" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Button>
                                </DockPanel>

                                <!-- credits summary -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <controls:CircularProgress Percentage="{Binding UsagePercentRemaining}"
                                                               Width="48" Height="48"
                                                               Margin="0,0,12,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CreditsRemainingText}"
                                                   FontSize="17" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding CreditsTotalText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="USAGE BY MODEL" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="0,0,0,6" />

                                <ItemsControl ItemsSource="{Binding UsageByModel}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Model}" FontSize="12" FontWeight="Medium"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                                        <Run Text="{Binding CreditsUsed, Mode=OneWay, StringFormat=N0}" /><Run Text=" cred" />
                                                    </TextBlock>
                                                </DockPanel>
                                                <DockPanel Margin="0,1,0,3">
                                                    <TextBlock Text="{Binding Provider}" FontSize="10.5"
                                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                               Text="{Binding Percentage, Mode=OneWay, StringFormat={}{0:0.0}%}" />
                                                </DockPanel>
                                                <ProgressBar Value="{Binding Percentage, Mode=OneWay}" Maximum="100"
                                                             Height="4" Foreground="{DynamicResource AccentBlueBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Height="1" Margin="0,2,0,8"
                                        Background="{DynamicResource BorderBrush}" Opacity="0.6" />
                                <DockPanel>
                                    <TextBlock Text="Total used" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                               Text="{Binding TotalCreditsUsedText}" FontSize="11" FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Grid>

        <!-- Login overlay -->
        <views:LoginView DataContext="{Binding Login}"
                         Visibility="{Binding DataContext.IsAuthenticated,
                                      RelativeSource={RelativeSource AncestorType=Window},
                                      Converter={StaticResource BoolToVisibility},
                                      ConverterParameter=Invert}" />

        <!-- Startup splash while restoring a stored session (polished R12) -->
        <Border Background="{DynamicResource BgPrimaryBrush}"
                Visibility="{Binding IsInitializing, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="14"
                        Background="{DynamicResource AccentBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="S" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource OnAccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="SRAN Desktop" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" />
                <ProgressBar IsIndeterminate="True" Width="120" Height="2"
                             Margin="0,16,0,0" BorderThickness="0"
                             Background="{DynamicResource BgSecondaryBrush}"
                             Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>
        </Border>

        <!-- Toast overlay (Phase 8 Task 1): above all content, below dialog
             windows. Null background = clicks pass through except on cards. -->
        <controls:ToastHost Grid.Row="2" Panel.ZIndex="100" />
    </Grid>
    </Grid>
</Window>
