<Window x:Class="SranDesktop.Presentation.Views.Dialogs.ShortcutsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SranDesktop.Presentation.Controls"
        Title="Keyboard shortcuts"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="DescText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,18,24,20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <controls:IconView Geometry="{StaticResource Geo_Sparkles}"
                               Stroke="{DynamicResource TextPrimaryBrush}"
                               Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Text="Keyboard shortcuts" FontSize="17" FontWeight="SemiBold"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,5">
                <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl + N" /></Border>
            </StackPanel>
            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DescText}" Text="New chat" />

            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,5">
                <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl + K" /></Border>
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DescText}" Text="Search conversations" />

            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,5">
                <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl + Shift + S" /></Border>
            </StackPanel>
            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DescText}" Text="Toggle sidebar" />

            <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,5">
                <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl + Shift + Space" /></Border>
            </StackPanel>
            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DescText}" Text="Show / hide from anywhere" />

            <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Margin="0,5">
                <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyText}" Text="Enter" /></Border>
            </StackPanel>
            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource DescText}" Text="Send message" />

            <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal" Margin="0,5">
                <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyText}" Text="Shift + Enter" /></Border>
            </StackPanel>
            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource DescText}" Text="New line" />

            <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" Margin="0,5">
                <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyText}" Text="Esc" /></Border>
            </StackPanel>
            <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource DescText}" Text="Stop generating" />

            <StackPanel Grid.Row="7" Grid.Column="0" Orientation="Horizontal" Margin="0,5">
                <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl + /" /></Border>
            </StackPanel>
            <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource DescText}" Text="Show this help" />
        </Grid>

        <Button Content="Close" HorizontalAlignment="Right" Margin="0,16,0,0"
                Padding="16,7" IsCancel="True" IsDefault="True" />
    </StackPanel>
</Window>
