<Window x:Class="SranDesktop.Presentation.Views.Dialogs.FilePreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SranDesktop.Presentation.Converters"
        xmlns:controls="clr-namespace:SranDesktop.Presentation.Controls"
        xmlns:loc="clr-namespace:SranDesktop.Presentation.Localization"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{Binding Filename}"
        Width="900" Height="700"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- One block of a Word document or a slide body. Shared by both
             panes so the two never drift apart. Everything is a TextBlock:
             document text is data, never markup. -->
        <DataTemplate x:Key="PreviewBlockTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                           FontSize="{Binding FontSize}"
                           Margin="{Binding Margin}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBold}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBullet}" Value="True">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextSecondaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- A table keeps its shape: fixed-width cells so the columns
                     line up without a layout pass per row. -->
                <ItemsControl ItemsSource="{Binding TableRows}" Margin="0,6,0,8"
                              Visibility="{Binding IsTable, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="160" Padding="6,4"
                                                BorderThickness="0,0,1,1"
                                                BorderBrush="{DynamicResource BorderBrush}">
                                            <TextBlock Text="{Binding}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- Esc closes, matching every other preview surface in the app. -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Window.InputBindings>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Left" Text="{Binding Filename}"
                       FontSize="15" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
        </DockPanel>

        <!-- Body -->
        <Border Grid.Row="1" CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource BgSecondaryBrush}"
                ClipToBounds="True">
            <Grid>
                <!-- Image -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                    <Image Source="{Binding Image}" Stretch="Uniform" StretchDirection="DownOnly"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="8" />
                </ScrollViewer>

                <!-- PDF: rendered by the WebView2 with scripting DISABLED and
                     navigation locked to this one document (PdfPreviewSandbox). -->
                <wv2:WebView2 x:Name="PdfView"
                              Visibility="{Binding IsPdf, Converter={StaticResource BoolToVisibility}}" />

                <!-- Spreadsheet (Phase 16): a native DataGrid, not HTML. Cell
                     text reaches the screen through a TextBlock, so there is
                     no markup surface for a cell to escape from. Columns are
                     generated at load time (see the code-behind) because the
                     sheet's shape is not known until the file is read. -->
                <DockPanel Visibility="{Binding IsSheet, Converter={StaticResource BoolToVisibility}}">
                    <!-- Sheet tabs -->
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding SheetTabs}"
                                  Margin="8,8,8,4"
                                  Visibility="{Binding HasSheetTabs, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}"
                                        Padding="10,4" Margin="0,0,4,0"
                                        FontWeight="{Binding TabFontWeight}"
                                        Command="{Binding DataContext.SelectSheetCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Footer: how much is on screen + load more -->
                    <DockPanel DockPanel.Dock="Bottom" Margin="10,6,10,8">
                        <TextBlock Text="{Binding SheetSummary}" VerticalAlignment="Center"
                                   FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                Content="{loc:T preview.loadMoreRows}"
                                Padding="10,4" MinWidth="120"
                                Command="{Binding LoadMoreCommand}"
                                Visibility="{Binding CanLoadMore, Converter={StaticResource BoolToVisibility}}" />
                    </DockPanel>

                    <DataGrid x:Name="SheetGrid"
                              ItemsSource="{Binding SheetRows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              HeadersVisibility="Column"
                              SelectionUnit="Cell"
                              GridLinesVisibility="All"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              Background="Transparent"
                              RowBackground="Transparent"
                              AlternatingRowBackground="Transparent"
                              BorderThickness="0"
                              FontSize="12" />
                </DockPanel>

                <!-- Word document (Phase 16): ordered blocks. -->
                <DockPanel Visibility="{Binding IsDocument, Converter={StaticResource BoolToVisibility}}">
                    <Button DockPanel.Dock="Bottom" HorizontalAlignment="Center"
                            Content="{loc:T preview.loadMoreBlocks}"
                            Padding="12,5" Margin="0,6,0,8"
                            Command="{Binding LoadMoreCommand}"
                            Visibility="{Binding CanLoadMore, Converter={StaticResource BoolToVisibility}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,10">
                        <ItemsControl ItemsSource="{Binding Blocks}"
                                      ItemTemplate="{StaticResource PreviewBlockTemplate}" />
                    </ScrollViewer>
                </DockPanel>

                <!-- Deck (Phase 16): one panel per slide. -->
                <DockPanel Visibility="{Binding IsSlides, Converter={StaticResource BoolToVisibility}}">
                    <Button DockPanel.Dock="Bottom" HorizontalAlignment="Center"
                            Content="{loc:T preview.loadMoreSlides}"
                            Padding="12,5" Margin="0,6,0,8"
                            Command="{Binding LoadMoreCommand}"
                            Visibility="{Binding CanLoadMore, Converter={StaticResource BoolToVisibility}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
                        <ItemsControl ItemsSource="{Binding SlidePanels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" BorderThickness="1" Margin="0,0,0,10"
                                            Padding="14,12"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            Background="{DynamicResource BgPrimaryBrush}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Caption}" FontSize="11"
                                                       Margin="0,0,0,6"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding Title}" FontSize="15"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Margin="0,0,0,6"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Visibility="{Binding HasTitle, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{loc:T preview.emptySlide}" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                                            <ItemsControl ItemsSource="{Binding Blocks}"
                                                          ItemTemplate="{StaticResource PreviewBlockTemplate}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- Extracted text (plain text, and PDFs on request). Since
                     Phase 16 this is the FALLBACK for office files: it shows
                     when the structured read is unavailable. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}">
                    <TextBox Text="{Binding Text, Mode=OneWay}"
                             IsReadOnly="True" BorderThickness="0"
                             Background="Transparent"
                             TextWrapping="Wrap"
                             Margin="12"
                             FontSize="13"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                </ScrollViewer>

                <!-- Status / unsupported / pending -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="24" MaxWidth="420">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                               TextAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button Content="{loc:T common.retry}" MinWidth="100" Padding="10,5"
                            Margin="0,12,0,0" HorizontalAlignment="Center"
                            Command="{Binding RetryCommand}" />
                </StackPanel>

                <ProgressBar Height="2" VerticalAlignment="Top" IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- Footer: Download is present in EVERY state — preview adds to it,
             it never replaces it. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="{loc:T preview.showText}" MinWidth="120" Padding="10,6" Margin="0,0,8,0"
                    Command="{Binding ShowTextInsteadCommand}"
                    Visibility="{Binding CanShowTextInstead, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="{loc:T attachment.save}" MinWidth="110" Padding="10,6" Margin="0,0,8,0"
                    Click="Download_Click" />
            <Button Content="{loc:T common.close}" MinWidth="90" Padding="10,6"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
