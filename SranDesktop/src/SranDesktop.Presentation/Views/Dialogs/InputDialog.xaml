<Window x:Class="SranDesktop.Presentation.Views.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SRAN Desktop"
        SizeToContent="Height"
        Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,8" />
        <TextBox x:Name="ValueBox"
                 KeyDown="ValueBox_KeyDown" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" MinWidth="80" Padding="10,5" Margin="0,0,8,0"
                    IsCancel="True" />
            <Button Content="OK" MinWidth="80" Padding="10,5"
                    IsDefault="True" Click="Ok_Click"
                    Style="{DynamicResource AccentButton}" />
        </StackPanel>
    </StackPanel>
</Window>
