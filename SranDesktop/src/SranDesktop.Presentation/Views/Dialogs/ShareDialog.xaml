<Window x:Class="SranDesktop.Presentation.Views.Dialogs.ShareDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SranDesktop.Presentation.Controls"
        xmlns:loc="clr-namespace:SranDesktop.Presentation.Localization"
        Title="{loc:T share.title}"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <StackPanel Margin="24,20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <controls:IconView Geometry="{StaticResource Geo_Share}"
                               Stroke="{DynamicResource TextPrimaryBrush}"
                               Width="18" Height="18" Margin="0,0,10,0"
                               VerticalAlignment="Center" />
            <TextBlock Text="{loc:T share.title}" FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </StackPanel>

        <Border Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="10,8"
                Margin="0,0,0,12">
            <TextBox x:Name="UrlBox" IsReadOnly="True"
                     Background="Transparent" BorderThickness="0"
                     FontSize="12.5" FontFamily="Consolas"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RevokeButton" Style="{DynamicResource DangerButton}"
                    Padding="14,6" Margin="0,0,8,0"
                    Click="Revoke_Click">
                <TextBlock Text="{loc:T connector.disconnect}" FontSize="12.5" />
            </Button>
            <Button x:Name="CopyButton" Style="{DynamicResource AccentButton}"
                    Padding="14,6" IsDefault="True"
                    Click="Copy_Click">
                <TextBlock x:Name="CopyLabel" Text="{loc:T share.copyLink}" FontSize="12.5" />
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
