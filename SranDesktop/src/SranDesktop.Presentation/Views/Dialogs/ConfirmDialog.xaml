<Window x:Class="SranDesktop.Presentation.Views.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SRAN Desktop"
        SizeToContent="Height"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText"
                   FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock x:Name="MessageText"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" MinWidth="80" Padding="10,5" Margin="0,0,8,0"
                    IsCancel="True" />
            <Button x:Name="ConfirmButton" MinWidth="90" Padding="10,5"
                    Click="Confirm_Click" />
        </StackPanel>
    </StackPanel>
</Window>
