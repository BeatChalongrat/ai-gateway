<Window x:Class="SranDesktop.Presentation.Views.Dialogs.AudioGenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SranDesktop.Presentation.Converters"
        xmlns:controls="clr-namespace:SranDesktop.Presentation.Controls"
        xmlns:loc="clr-namespace:SranDesktop.Presentation.Localization"
        Title="{loc:T media.audioTitle}"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="{loc:T media.audioTitle}" FontSize="17" FontWeight="SemiBold" />
        <TextBlock Text="{loc:T media.audioSubtitle}" FontSize="12" Margin="0,2,0,14"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextTertiaryBrush}" />

        <!-- Mode: speech ↔ music -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton GroupName="AudioMode" Margin="0,0,16,0"
                         IsChecked="{Binding IsSpeech}"
                         Content="{loc:T media.modeSpeech}" />
            <RadioButton GroupName="AudioMode"
                         IsChecked="{Binding IsMusic, Mode=OneWay}"
                         Checked="MusicMode_Checked"
                         Content="{loc:T media.modeMusic}" />
        </StackPanel>

        <!-- Prompt label follows the mode: text to speak vs music to describe. -->
        <TextBlock FontSize="12" Margin="0,0,0,4"
                   Foreground="{DynamicResource TextSecondaryBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="{loc:T media.music.placeholder}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSpeech}" Value="True">
                            <Setter Property="Text" Value="{loc:T media.tts.placeholder}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Border BorderThickness="1" CornerRadius="8"
                BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource BgSecondaryBrush}"
                Padding="8">
            <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="90" MaxHeight="180"
                     VerticalScrollBarVisibility="Auto"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     CaretBrush="{DynamicResource TextPrimaryBrush}" />
        </Border>

        <!-- Speech: voice picker -->
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                    Visibility="{Binding IsSpeech, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{loc:T media.voice}" FontSize="12" VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox ItemsSource="{Binding Voices}"
                      SelectedItem="{Binding SelectedVoice}"
                      DisplayMemberPath="Name"
                      MinWidth="160" Padding="8,4" />
        </StackPanel>

        <!-- Music: duration -->
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                    Visibility="{Binding IsMusic, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{loc:T media.duration}" FontSize="12" VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Slider Value="{Binding DurationSec}" Minimum="10" Maximum="60"
                    Width="220" VerticalAlignment="Center"
                    IsSnapToTickEnabled="True" TickFrequency="5" />
            <TextBlock Text="{Binding DurationSec, StringFormat={}{0}s}" FontSize="12"
                       Margin="8,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
        </StackPanel>

        <!-- Progress / status -->
        <StackPanel Margin="0,14,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar Height="3" IsIndeterminate="True" />
        </StackPanel>
        <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" />

        <!-- Result -->
        <StackPanel Margin="0,12,0,0"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{loc:T media.audioReady}" FontSize="12.5"
                       Foreground="{DynamicResource AccentGreenBrush}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{loc:T common.cancel}" MinWidth="90" Padding="10,6" Margin="0,0,8,0"
                    IsCancel="True" />
            <Button MinWidth="130" Padding="10,6"
                    IsDefault="True"
                    Command="{Binding GenerateCommand}"
                    IsEnabled="{Binding CanSubmit}"
                    Style="{DynamicResource AccentButton}">
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{loc:T media.generateMusic}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSpeech}" Value="True">
                                    <Setter Property="Text" Value="{loc:T media.generateSpeech}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
