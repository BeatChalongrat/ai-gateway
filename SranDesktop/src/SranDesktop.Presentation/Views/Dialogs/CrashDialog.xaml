<Window x:Class="SranDesktop.Presentation.Views.Dialogs.CrashDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SranDesktop.Presentation.Localization"
        Title="{loc:T crash.title}"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <StackPanel Margin="24,20">
        <TextBlock Text="{loc:T crash.title}" FontSize="17" FontWeight="SemiBold" />
        <TextBlock Text="{loc:T crash.description}" FontSize="12.5" Margin="0,6,0,12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" />

        <Expander Margin="0,0,0,14">
            <Expander.Header>
                <TextBlock Text="{loc:T crash.details}" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Expander.Header>
            <Border Background="{DynamicResource BgSecondaryBrush}" CornerRadius="8"
                    Padding="10" Margin="0,6,0,0">
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="DetailsText" FontFamily="Consolas" FontSize="10.5"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </ScrollViewer>
            </Border>
        </Expander>

        <TextBlock x:Name="SendResult" Text="" FontSize="11.5" Margin="0,0,0,8"
                   Foreground="{DynamicResource AccentGreenBrush}" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SendButton" Padding="14,6" Margin="0,0,8,0"
                    Click="Send_Click">
                <TextBlock Text="{loc:T crash.sendReport}" FontSize="12.5" />
            </Button>
            <Button Padding="14,6" Margin="0,0,8,0" Click="Restart_Click">
                <TextBlock Text="{loc:T crash.restart}" FontSize="12.5" />
            </Button>
            <Button Style="{DynamicResource AccentButton}" Padding="14,6"
                    IsDefault="True" IsCancel="True">
                <TextBlock Text="{loc:T common.close}" FontSize="12.5" />
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
