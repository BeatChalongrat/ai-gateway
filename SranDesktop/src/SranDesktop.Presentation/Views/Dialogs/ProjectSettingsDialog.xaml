<Window x:Class="SranDesktop.Presentation.Views.Dialogs.ProjectSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SranDesktop.Presentation.Localization"
        Title="{Binding ProjectName}"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <StackPanel Margin="20">
        <TextBlock Text="{Binding ProjectName}" FontSize="17" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{loc:T project.settings.subtitle}" FontSize="12" Margin="0,2,0,14"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextTertiaryBrush}" />

        <!-- Shared instructions: applied to every chat in this project, on
             the server, so web and desktop see the same text. -->
        <TextBlock Text="{loc:T project.instructions}" FontSize="12" FontWeight="Medium"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBlock Text="{loc:T project.instructionsHint}" FontSize="11" Margin="0,2,0,6"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextTertiaryBrush}" />
        <Border BorderThickness="1" CornerRadius="8"
                BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource BgSecondaryBrush}"
                Padding="8">
            <TextBox Text="{Binding Instructions, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="130" MaxHeight="240"
                     VerticalScrollBarVisibility="Auto"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     CaretBrush="{DynamicResource TextPrimaryBrush}" />
        </Border>
        <TextBlock HorizontalAlignment="Right" FontSize="10" Margin="0,4,0,0"
                   Foreground="{DynamicResource TextTertiaryBrush}">
            <Run Text="{Binding InstructionsLength, Mode=OneWay}" />
            <Run Text="/ 8000" />
        </TextBlock>

        <!-- Knowledge base: one per project, same rule as the web page. -->
        <TextBlock Text="{loc:T project.kb}" FontSize="12" FontWeight="Medium" Margin="0,14,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBlock Text="{loc:T project.kbHint}" FontSize="11" Margin="0,2,0,6"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextTertiaryBrush}" />
        <ComboBox ItemsSource="{Binding KnowledgeBases}"
                  SelectedItem="{Binding SelectedKnowledgeBase}"
                  DisplayMemberPath="Name"
                  Padding="8,5" />

        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource AccentRedBrush}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:T common.cancel}" MinWidth="90" Padding="10,6" Margin="0,0,8,0"
                    IsCancel="True" />
            <Button Content="{loc:T common.save}" MinWidth="90" Padding="10,6"
                    IsDefault="True"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding CanSave}"
                    Style="{DynamicResource AccentButton}" />
        </StackPanel>
    </StackPanel>
</Window>
