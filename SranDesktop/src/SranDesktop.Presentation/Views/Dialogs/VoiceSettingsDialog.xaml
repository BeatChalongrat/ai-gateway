<Window x:Class="SranDesktop.Presentation.Views.Dialogs.VoiceSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SranDesktop.Presentation.Localization"
        Title="{loc:T voice.title}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <StackPanel Margin="24,20">
        <!-- Backend selector (R10 2F) -->
        <TextBlock Text="{loc:T voice.backend}" FontSize="12" Margin="0,0,0,4"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <ComboBox x:Name="BackendBox" Margin="0,0,0,10"
                  SelectionChanged="Backend_Changed" />

        <!-- Azure credentials (visible when Azure selected) -->
        <StackPanel x:Name="AzurePanel" Visibility="Collapsed" Margin="0,0,0,4">
            <TextBlock Text="{loc:T voice.azureHint}" FontSize="11.5" Margin="0,0,0,8"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextTertiaryBrush}" />
            <TextBlock Text="{loc:T voice.azureKey}" FontSize="12" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <PasswordBox x:Name="AzureKeyBox" Margin="0,0,0,8" />
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" x:Name="TestButton"
                        Content="{loc:T voice.test}" Padding="12,4" Margin="8,0,0,0"
                        Click="Test_Click" />
                <StackPanel>
                    <TextBlock Text="{loc:T voice.azureRegion}" FontSize="12" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox x:Name="RegionBox" Text="southeastasia" />
                </StackPanel>
            </DockPanel>
            <TextBlock x:Name="TestResult" Text="" FontSize="11.5" Margin="0,4,0,4" />
        </StackPanel>

        <!-- Recognition language -->
        <TextBlock Text="{loc:T voice.language}" FontSize="12" Margin="0,6,0,4"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <ComboBox x:Name="LanguageBox" Margin="0,0,0,10" />

        <!-- TTS voice -->
        <TextBlock Text="{loc:T voice.voice}" FontSize="12" Margin="0,0,0,4"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <ComboBox x:Name="VoiceBox" Margin="0,0,0,14"
                  DisplayMemberPath="Name" SelectedValuePath="Id" />

        <!-- Speed -->
        <TextBlock Text="{loc:T voice.speed}" FontSize="12" Margin="0,0,0,4"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <DockPanel Margin="0,0,0,14">
            <TextBlock DockPanel.Dock="Right" x:Name="RateLabel" Text="0"
                       FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Slider x:Name="RateSlider" Minimum="-10" Maximum="10"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    ValueChanged="RateSlider_ValueChanged" />
        </DockPanel>

        <CheckBox x:Name="AutoReadBox" Margin="0,0,0,18"
                  Foreground="{DynamicResource TextPrimaryBrush}">
            <TextBlock Text="{loc:T voice.autoRead}" FontSize="13" />
        </CheckBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:T common.cancel}" IsCancel="True"
                    Padding="16,6" Margin="0,0,8,0" />
            <Button Content="{loc:T common.save}"
                    Style="{DynamicResource AccentButton}"
                    Padding="16,6" IsDefault="True"
                    Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
