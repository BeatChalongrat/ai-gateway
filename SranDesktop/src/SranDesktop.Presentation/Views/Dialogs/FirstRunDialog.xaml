<Window x:Class="SranDesktop.Presentation.Views.Dialogs.FirstRunDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SranDesktop.Presentation.ViewModels"
        xmlns:conv="clr-namespace:SranDesktop.Presentation.Converters"
        xmlns:controls="clr-namespace:SranDesktop.Presentation.Controls"
        xmlns:loc="clr-namespace:SranDesktop.Presentation.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:FirstRunViewModel}"
        Title="Welcome to SRAN Desktop"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/SranDesktop;component/Assets/app.ico"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="32,28">
        <Border Width="52" Height="52" CornerRadius="12"
                HorizontalAlignment="Center"
                Background="{DynamicResource AccentBrush}">
            <TextBlock Text="S" FontSize="30" FontWeight="Bold"
                       Foreground="{DynamicResource OnAccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="Welcome to SRAN Desktop" FontSize="22" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,12,0,0"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="An AI assistant that lives on your desktop"
                   HorizontalAlignment="Center" Margin="0,6,0,24"
                   Foreground="{DynamicResource TextSecondaryBrush}" />

        <!-- Server presets (R11 A2a) -->
        <TextBlock Text="{loc:T setup.serverTitle}" FontWeight="SemiBold" Margin="0,0,0,2"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{loc:T setup.serverDesc}" FontSize="12" Margin="0,0,0,8"
                   Foreground="{DynamicResource TextSecondaryBrush}" />

        <RadioButton GroupName="Server" IsChecked="{Binding IsCloudSelected}"
                     Content="{loc:T setup.cloud}" Margin="0,4"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
        <Border Margin="24,0,0,8" Padding="8" CornerRadius="6"
                Background="{DynamicResource BgSecondaryBrush}"
                Visibility="{Binding IsCloudSelected, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="sran.ai (managed service)" FontSize="11"
                       Foreground="{DynamicResource TextTertiaryBrush}" />
        </Border>

        <RadioButton GroupName="Server" IsChecked="{Binding IsSelfHostedSelected}"
                     Content="{loc:T setup.selfHosted}" Margin="0,4"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
        <StackPanel Margin="24,0,0,12"
                    Visibility="{Binding IsSelfHostedSelected, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{loc:T setup.serverUrl}" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding ServerBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                     controls:WatermarkService.Text="https://sran.yourcompany.com" />
            <TextBlock Text="{loc:T setup.serverUrlHint}" FontSize="10.5" Margin="0,3,0,6"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextTertiaryBrush}" />
            <!-- Connection test (A2c) -->
            <DockPanel>
                <Button DockPanel.Dock="Left" Padding="12,4"
                        Command="{Binding TestConnectionCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar Width="26" Height="3" IsIndeterminate="True"
                                     Margin="0,0,6,0" VerticalAlignment="Center"
                                     Visibility="{Binding IsTestingConnection, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{loc:T setup.testConnection}" FontSize="12" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding ConnectionStatus}" FontSize="11.5" Margin="10,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnectionValid}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </StackPanel>

        <!-- Working folder (P3-4): file tools reach only granted folders, so a
             fresh install with none can read and write nothing. Name one and let
             the user confirm it, rather than granting the whole home directory. -->
        <TextBlock Text="{loc:T setup.workingFolderTitle}" FontWeight="SemiBold" Margin="0,0,0,2"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{loc:T setup.workingFolderDesc}" FontSize="12" Margin="0,0,0,8"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding WorkingFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Padding="8,6"
                     AutomationProperties.Name="Working folder" />
            <Button Grid.Column="1" Content="{loc:T setup.browse}" Margin="6,0,0,0"
                    Padding="12,6" Command="{Binding BrowseWorkingFolderCommand}" />
            <Button Grid.Column="2" Content="{loc:T setup.decideLater}" Margin="6,0,0,0"
                    Padding="12,6" Command="{Binding ClearProposedWorkingFolderCommand}" />
        </Grid>
        <TextBlock Text="{loc:T setup.workingFolderEmpty}" FontSize="11.5" Margin="0,0,0,16"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource AccentRedBrush}"
                   Visibility="{Binding HasNoWorkingFolder, Converter={StaticResource BoolToVisibility}}" />

        <Border Background="{DynamicResource BgSecondaryBrush}" CornerRadius="8" Padding="16,12"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Quick tips" FontWeight="SemiBold" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock TextWrapping="Wrap" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="• Ctrl+Shift+Space" FontWeight="SemiBold" /> - open SRAN from anywhere
                    <LineBreak />
                    <Run Text="• Agent Mode" FontWeight="SemiBold" /> - let the AI read files, run commands, and more
                    <LineBreak />
                    <Run Text="• Close to tray" FontWeight="SemiBold" /> - the app keeps running in the background
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Phase 8: the disabled "Show system tray icon" checkbox was a dead
             control (the tray icon is always created; no setting backs it) —
             removed rather than faked. -->
        <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,20" />

        <Button Content="Get Started" Style="{DynamicResource AccentButton}"
                HorizontalAlignment="Center" MinWidth="160" Padding="16,10"
                IsDefault="True"
                IsEnabled="{Binding CanContinue}"
                Click="GetStarted_Click" />
    </StackPanel>
</Window>
