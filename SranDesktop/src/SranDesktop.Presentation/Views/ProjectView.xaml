<Window x:Class="SranDesktop.Presentation.Views.ProjectView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:SranDesktop.Presentation.Converters"
        xmlns:controls="clr-namespace:SranDesktop.Presentation.Controls"
        xmlns:vm="clr-namespace:SranDesktop.Presentation.ViewModels"
        xmlns:loc="clr-namespace:SranDesktop.Presentation.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ProjectDetailViewModel}"
        Title="{Binding Name}"
        Width="580" Height="620"
        MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: editable name -->
        <DockPanel Grid.Row="0" Margin="24,24,24,12">
            <Button DockPanel.Dock="Right" Style="{DynamicResource IconButton}"
                    Width="28" Height="28" VerticalAlignment="Center"
                    ToolTip="{loc:T project.delete}"
                    Command="{Binding DeleteCommand}">
                <controls:IconView Geometry="{StaticResource Geo_Trash}"
                                   Stroke="{DynamicResource AccentRedBrush}"
                                   Width="14" Height="14" />
            </Button>
            <StackPanel Orientation="Horizontal">
                <controls:IconView Geometry="{StaticResource Geo_Folder}"
                                   Stroke="{DynamicResource AccentBrush}"
                                   Width="20" Height="20" Margin="0,0,10,0"
                                   VerticalAlignment="Center" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="17" FontWeight="SemiBold"
                         MinWidth="240"
                         Background="Transparent" BorderThickness="0,0,0,1"
                         BorderBrush="{DynamicResource BorderBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                         VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,8">
            <StackPanel>
                <!-- Instructions -->
                <TextBlock Text="{loc:T project.instructions}" FontSize="13" FontWeight="SemiBold"
                           Margin="0,4,0,2"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{loc:T project.instructionsHint}" FontSize="11.5" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBox Text="{Binding Instructions, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="90" MaxHeight="180"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,14" />

                <!-- Files -->
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{DynamicResource PillButton}" Padding="10,4"
                            Command="{Binding AddFileCommand}">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconView Geometry="{StaticResource Geo_Plus}"
                                               Stroke="{DynamicResource TextSecondaryBrush}"
                                               Width="12" Height="12" Margin="0,0,5,0" />
                            <TextBlock Text="{loc:T project.addFile}" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{loc:T project.files}" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </DockPanel>
                <TextBlock Text="{loc:T project.noFiles}" FontSize="12" Margin="0,4,0,8"
                           Foreground="{DynamicResource TextTertiaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Files.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Files}" Margin="0,0,0,14">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <Button DockPanel.Dock="Right" Style="{DynamicResource IconButton}"
                                        Width="24" Height="24"
                                        ToolTip="{loc:T common.delete}"
                                        Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <controls:IconView Geometry="{StaticResource Geo_Close}"
                                                       Stroke="{DynamicResource TextSecondaryBrush}"
                                                       Width="11" Height="11" />
                                </Button>
                                <controls:IconView Geometry="{StaticResource Geo_FileText}"
                                                   Stroke="{DynamicResource TextSecondaryBrush}"
                                                   Width="14" Height="14" Margin="0,0,7,0"
                                                   VerticalAlignment="Center" />
                                <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Conversations in this project -->
                <TextBlock Text="{loc:T project.conversations}" FontSize="13" FontWeight="SemiBold"
                           Margin="0,0,0,6"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{loc:T project.noConversations}" FontSize="12" Margin="0,4,0,4"
                           Foreground="{DynamicResource TextTertiaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Conversations.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Conversations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ConversationItemViewModel}">
                            <TextBlock Text="{Binding DisplayTitle}" FontSize="12.5" Margin="0,3"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer: start chat -->
        <Border Grid.Row="2" Padding="24,12"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Button Style="{DynamicResource AccentButton}" Padding="18,8"
                    HorizontalAlignment="Center"
                    Command="{Binding StartChatCommand}">
                <TextBlock Text="{loc:T project.startChat}" FontSize="13" FontWeight="Medium" />
            </Button>
        </Border>
    </Grid>
</Window>
