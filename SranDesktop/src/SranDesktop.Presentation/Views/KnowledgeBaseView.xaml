<Window x:Class="SranDesktop.Presentation.Views.KnowledgeBaseView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:SranDesktop.Presentation.Converters"
        xmlns:controls="clr-namespace:SranDesktop.Presentation.Controls"
        xmlns:vm="clr-namespace:SranDesktop.Presentation.ViewModels"
        xmlns:loc="clr-namespace:SranDesktop.Presentation.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:KnowledgeBaseViewModel}"
        Title="{loc:T kb.title}"
        Width="620" Height="640"
        MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="24,24,24,12">
            <StackPanel Orientation="Horizontal">
                <controls:IconView Geometry="{StaticResource Geo_BookOpen}"
                                   Stroke="{DynamicResource TextPrimaryBrush}"
                                   Width="20" Height="20" Margin="0,0,10,0"
                                   VerticalAlignment="Center" />
                <TextBlock Text="{loc:T kb.title}" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{loc:T kb.subtitle}" FontSize="12.5" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- Create button / inline panel -->
        <StackPanel Grid.Row="1" Margin="24,4,24,8">
            <Button Style="{DynamicResource AccentButton}" Padding="14,7"
                    HorizontalAlignment="Left"
                    Command="{Binding ToggleCreatePanelCommand}">
                <StackPanel Orientation="Horizontal">
                    <controls:IconView Geometry="{StaticResource Geo_Plus}"
                                       Stroke="{DynamicResource OnAccentBrush}"
                                       Width="14" Height="14" Margin="0,0,7,0" />
                    <TextBlock Text="{loc:T kb.create}" FontSize="13" />
                </StackPanel>
            </Button>

            <Border Background="{DynamicResource BgSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10"
                    Padding="14,12" Margin="0,10,0,0"
                    Visibility="{Binding IsCreatePanelOpen, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{loc:T kb.name}" FontSize="12" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,10" />
                    <TextBlock Text="{loc:T kb.description}" FontSize="12" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{loc:T common.cancel}" Padding="14,6" Margin="0,0,8,0"
                                Command="{Binding ToggleCreatePanelCommand}" />
                        <Button Content="{loc:T common.create}" Padding="14,6"
                                Style="{DynamicResource AccentButton}"
                                Command="{Binding CreateCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource AccentRedBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- KB list -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,0,24,16">
            <StackPanel>
                <ProgressBar Height="2" IsIndeterminate="True" Margin="0,4"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

                <!-- Empty state: centered icon + hint + full-width dashed create button -->
                <StackPanel Margin="0,24,0,8"
                            Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVisibility}}">
                    <controls:IconView Geometry="{StaticResource Geo_BookOpen}"
                                       Stroke="{DynamicResource TextTertiaryBrush}"
                                       Width="40" Height="40"
                                       HorizontalAlignment="Center" />
                    <TextBlock Text="{loc:T kb.empty}" FontSize="13" Margin="0,12,0,16"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                    <Button Command="{Binding ToggleCreatePanelCommand}"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Padding="0"
                            HorizontalContentAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Rectangle Stroke="{DynamicResource BorderBrush}"
                                               StrokeThickness="1.5" StrokeDashArray="4 3"
                                               RadiusX="12" RadiusY="12"
                                               Fill="Transparent" />
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="0,16" />
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <controls:IconView Geometry="{StaticResource Geo_Plus}"
                                               Stroke="{DynamicResource TextSecondaryBrush}"
                                               Width="14" Height="14" Margin="0,0,7,0"
                                               VerticalAlignment="Center" />
                            <TextBlock Text="{loc:T kb.create}" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding KnowledgeBases}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:KnowledgeBaseItemViewModel}">
                            <Border BorderThickness="1" CornerRadius="12"
                                    Padding="16,12" Margin="0,0,0,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BgSelectedBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <!-- header row -->
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Style="{DynamicResource PillButton}" Padding="10,4"
                                                    Command="{Binding ManageCommand}">
                                                <TextBlock Text="{loc:T kb.card.manage}" FontSize="12" />
                                            </Button>
                                            <Button Style="{DynamicResource IconButton}" Width="26" Height="26"
                                                    Margin="6,0,0,0"
                                                    ToolTip="{loc:T common.delete}" AutomationProperties.Name="{loc:T common.delete}"
                                                    Command="{Binding DeleteCommand}">
                                                <controls:IconView Geometry="{StaticResource Geo_Trash}"
                                                                   Stroke="{DynamicResource AccentRedBrush}"
                                                                   Width="13" Height="13" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <controls:IconView Geometry="{StaticResource Geo_BookOpen}"
                                                               Stroke="{DynamicResource AccentBrush}"
                                                               Width="16" Height="16" Margin="0,0,8,0"
                                                               VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </DockPanel>

                                    <TextBlock Text="{Binding Description}" FontSize="12" Margin="24,2,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />

                                    <!-- stats + active toggle -->
                                    <StackPanel Orientation="Horizontal" Margin="24,6,0,0">
                                        <TextBlock FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                                   VerticalAlignment="Center">
                                            <Run Text="{Binding DocumentCount, Mode=OneWay}" />
                                            <Run Text="{loc:T kb.unit.documents}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding TotalChunks, Mode=OneWay}" />
                                            <Run Text="{loc:T kb.unit.chunks}" />
                                        </TextBlock>
                                        <Button Margin="12,0,0,0" Padding="8,2"
                                                Style="{DynamicResource PillButton}"
                                                Command="{Binding ToggleActiveCommand}">
                                            <TextBlock FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{loc:T kb.card.inactive}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Text" Value="{loc:T kb.card.active}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                    </StackPanel>

                                    <!-- expanded document panel -->
                                    <StackPanel Margin="0,10,0,0"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                        <Border Height="1" Background="{DynamicResource BorderBrush}"
                                                Opacity="0.6" Margin="0,0,0,8" />
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <ProgressBar Width="60" Height="4" Margin="0,0,8,0"
                                                             VerticalAlignment="Center"
                                                             Minimum="0" Maximum="100"
                                                             Value="{Binding UploadProgress, Mode=OneWay}"
                                                             Visibility="{Binding IsUploading, Converter={StaticResource BoolToVisibility}}" />
                                                <Button Style="{DynamicResource PillButton}" Padding="10,4"
                                                        Command="{Binding UploadDocumentCommand}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:IconView Geometry="{StaticResource Geo_Plus}"
                                                                           Stroke="{DynamicResource TextSecondaryBrush}"
                                                                           Width="12" Height="12" Margin="0,0,5,0" />
                                                        <TextBlock Text="{loc:T kb.uploadDocument}" FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock Text="{loc:T kb.documents}" FontSize="12" FontWeight="Medium"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </DockPanel>

                                        <ProgressBar Height="2" IsIndeterminate="True" Margin="0,6"
                                                     Visibility="{Binding IsLoadingDocuments, Converter={StaticResource BoolToVisibility}}" />

                                        <TextBlock Text="{loc:T kb.noDocuments}" FontSize="12" Margin="0,8"
                                                   Foreground="{DynamicResource TextTertiaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Documents.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <ItemsControl ItemsSource="{Binding Documents}" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:KbDocumentViewModel}">
                                                    <DockPanel Margin="0,3">
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                            <Button Width="24" Height="24"
                                                                    ToolTip="{loc:T kb.reindex}" AutomationProperties.Name="{loc:T kb.reindex}"
                                                                    Command="{Binding ReindexCommand}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                                <Setter Property="IsEnabled" Value="False" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <controls:IconView Geometry="{StaticResource Geo_Regenerate}"
                                                                                   Stroke="{DynamicResource TextSecondaryBrush}"
                                                                                   Width="12" Height="12" />
                                                            </Button>
                                                            <Button Style="{DynamicResource IconButton}" Width="24" Height="24"
                                                                    Margin="2,0,0,0"
                                                                    ToolTip="{loc:T common.delete}" AutomationProperties.Name="{loc:T common.delete}"
                                                                    Command="{Binding DeleteCommand}">
                                                                <controls:IconView Geometry="{StaticResource Geo_Trash}"
                                                                                   Stroke="{DynamicResource AccentRedBrush}"
                                                                                   Width="12" Height="12" />
                                                            </Button>
                                                        </StackPanel>
                                                        <controls:IconView Geometry="{StaticResource Geo_FileText}"
                                                                           Stroke="{DynamicResource TextSecondaryBrush}"
                                                                           Width="14" Height="14" Margin="0,0,7,0"
                                                                           VerticalAlignment="Center" />
                                                        <TextBlock VerticalAlignment="Center" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Filename, Mode=OneWay}"
                                                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <Run Text="{Binding SizeText, Mode=OneWay}"
                                                                 Foreground="{DynamicResource TextTertiaryBrush}" />
                                                            <Run Text=" · " Foreground="{DynamicResource TextTertiaryBrush}" />
                                                            <Run Text="{Binding ChunkCount, Mode=OneWay}"
                                                                 Foreground="{DynamicResource TextTertiaryBrush}" />
                                                            <Run Text="{loc:T kb.unit.chunks}"
                                                                 Foreground="{DynamicResource TextTertiaryBrush}" />
                                                            <Run Text=" · " Foreground="{DynamicResource TextTertiaryBrush}" />
                                                            <Run Text="{Binding StatusLabel, Mode=OneWay}">
                                                                <Run.Style>
                                                                    <Style TargetType="Run">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsIndexed}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Run.Style>
                                                            </Run>
                                                        </TextBlock>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
