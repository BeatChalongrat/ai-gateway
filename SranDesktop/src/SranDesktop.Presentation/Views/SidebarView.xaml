<UserControl x:Class="SranDesktop.Presentation.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:SranDesktop.Presentation.Converters"
             xmlns:controls="clr-namespace:SranDesktop.Presentation.Controls"
             xmlns:vm="clr-namespace:SranDesktop.Presentation.ViewModels"
             xmlns:loc="clr-namespace:SranDesktop.Presentation.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ConversationListViewModel}"
             Background="{DynamicResource BgSidebarBrush}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:UpperCaseConverter x:Key="UpperCase" />

        <!-- Row chrome shared by every conversation row (folder sections + time
             buckets). Selection is VM-authoritative (IsSelected), so plain Buttons
             replace Selector items — no Selector null-push when live filters move
             rows between sections. -->
        <ControlTemplate x:Key="ConversationRowChrome" TargetType="Button">
            <Grid>
                <Border x:Name="Bd" CornerRadius="6" Background="Transparent" />
                <Border x:Name="HoverOverlay" CornerRadius="6"
                        Background="{DynamicResource BgSecondaryBrush}"
                        Opacity="0" IsHitTestVisible="False" />
                <ContentPresenter Margin="8,7" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Bd" Property="Background"
                            Value="{DynamicResource SidebarActiveBrush}" />
                    <Setter TargetName="HoverOverlay" Property="Background" Value="Transparent" />
                </DataTrigger>
                <!-- Phase 8 drag-drop: highlight a folder header while a
                     dragged conversation hovers it. (Conversation rows have
                     no IsDropTarget — the binding just never matches.) -->
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter TargetName="Bd" Property="Background"
                            Value="{DynamicResource BgSelectedBrush}" />
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- "..." overflow: appears on row hover or when the row is selected. -->
        <Style x:Key="RowOverflowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="controls:ButtonHelper.CornerRadius" Value="11" />
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ConversationRowTemplate" DataType="{x:Type vm:ConversationItemViewModel}">
            <Button Template="{StaticResource ConversationRowChrome}"
                    Margin="8,1" Cursor="Hand"
                    HorizontalContentAlignment="Stretch"
                    Command="{Binding DataContext.SelectConversationCommand,
                              RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                    CommandParameter="{Binding}"
                    Tag="{Binding DataContext,
                          RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                <Button.ContextMenu>
                    <ContextMenu Opened="ConversationMenu_Opened">
                        <!-- 1. Pin / Unpin -->
                        <MenuItem Command="{Binding PlacementTarget.Tag.TogglePinCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Header>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{loc:T conv.pin}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                    <Setter Property="Text" Value="{loc:T conv.unpin}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </MenuItem.Header>
                            <MenuItem.Icon>
                                <controls:IconView Geometry="{StaticResource Geo_Pin}"
                                                   Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                                                   Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <!-- 2. Rename -->
                        <MenuItem Header="{loc:T conv.rename}"
                                  Command="{Binding PlacementTarget.Tag.RenameCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Icon>
                                <controls:IconView Geometry="{StaticResource Geo_Rename}"
                                                   Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                                                   Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <!-- 3. Move to folder (sub-items filled in code-behind on open) -->
                        <MenuItem Header="{loc:T conv.moveToFolder}" Tag="move-target">
                            <MenuItem.Icon>
                                <controls:IconView Geometry="{StaticResource Geo_Folder}"
                                                   Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                                                   Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <!-- 4. Delete -->
                        <MenuItem Header="{loc:T conv.delete}"
                                  Tag="Danger"
                                  Foreground="{DynamicResource AccentRedBrush}"
                                  Command="{Binding PlacementTarget.Tag.DeleteCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Icon>
                                <controls:IconView Geometry="{StaticResource Geo_Trash}"
                                                   Stroke="{DynamicResource AccentRedBrush}"
                                                   Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:IconView Grid.Column="0"
                                       Geometry="{StaticResource Geo_Pin}"
                                       Stroke="{DynamicResource TextSecondaryBrush}"
                                       Width="11" Height="11" Margin="0,0,5,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />
                    <!-- display mode -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding DisplayTitle}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                    <!-- inline rename mode (web parity R5) -->
                    <TextBox Grid.Column="1"
                             Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14"
                             Padding="4,1"
                             Margin="-5,-2,0,-2"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}"
                             Loaded="InlineRename_Loaded"
                             IsVisibleChanged="InlineRename_IsVisibleChanged"
                             PreviewKeyDown="InlineRename_PreviewKeyDown"
                             LostFocus="InlineRename_LostFocus" />
                    <Button Grid.Column="2"
                            Style="{StaticResource RowOverflowButton}"
                            Click="Overflow_Click"
                            AutomationProperties.Name="Conversation options"
                            ToolTip="Options">
                        <controls:IconView Geometry="{StaticResource Geo_More}"
                                           Stroke="{DynamicResource TextSecondaryBrush}"
                                           Width="14" Height="14" />
                    </Button>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Brand wordmark + collapse chevron + new chat. Also the Phase 8
             "remove from folder" drop zone: dropping a filed chat here
             unfiles it (Background=Transparent keeps it drop-hit-testable). -->
        <StackPanel Grid.Row="0" x:Name="HeaderDropZone"
                    Background="Transparent" AllowDrop="True"
                    DragEnter="HeaderDropZone_DragEnter"
                    DragLeave="HeaderDropZone_DragLeave"
                    DragOver="HeaderDropZone_DragOver"
                    Drop="HeaderDropZone_Drop">
            <DockPanel Margin="16,12,8,8">
                <Button DockPanel.Dock="Right" Style="{DynamicResource IconButton}"
                        Width="28" Height="28"
                        Click="CollapseButton_Click"
                        AutomationProperties.Name="Collapse sidebar"
                        ToolTip="Collapse sidebar">
                    <controls:IconView Geometry="{StaticResource Geo_ChevronLeft}"
                                       Stroke="{DynamicResource TextSecondaryBrush}"
                                       Width="14" Height="14" />
                </Button>
                <TextBlock VerticalAlignment="Center" FontSize="16"
                           Foreground="{DynamicResource TextPrimaryBrush}">
                    <Run Text="SRAN" FontWeight="Bold" />
                    <Run Text="Chat" FontWeight="Normal" />
                </TextBlock>
            </DockPanel>

            <!-- New chat: flat row, no border (web parity R2 Fix 1a) -->
            <Button Command="{Binding NewChatCommand}"
                    Style="{DynamicResource FlatRowButton}"
                    Margin="8,0,8,0"
                    AutomationProperties.Name="New chat"
                    ToolTip="New chat (Ctrl+N)">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:IconView Grid.Column="0" Geometry="{StaticResource Geo_Plus}"
                                       Stroke="{DynamicResource TextPrimaryBrush}"
                                       Width="16" Height="16" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{loc:T sidebar.newChat}" FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Grid.Column="2" Text="Ctrl+N" FontSize="11" Opacity="0.6"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </Grid>
            </Button>

            <!-- New folder: same flat row (web parity R2 Fix 1b) -->
            <Button Command="{Binding NewFolderCommand}"
                    Style="{DynamicResource FlatRowButton}"
                    Margin="8,0,8,0"
                    AutomationProperties.Name="New folder">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:IconView Grid.Column="0" Geometry="{StaticResource Geo_Folder}"
                                       Stroke="{DynamicResource TextSecondaryBrush}"
                                       Width="16" Height="16" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{loc:T sidebar.newFolder}" FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
            </Button>
        </StackPanel>

        <!-- Search: collapsed button row ↔ expanded inline input (web parity R2 Fix 1c) -->
        <Grid Grid.Row="1" Margin="8,2,8,4">
            <!-- Button mode (default) -->
            <Button x:Name="SearchButton"
                    Style="{DynamicResource FlatRowButton}"
                    Click="SearchButton_Click"
                    AutomationProperties.Name="Search chats"
                    ToolTip="Search chats (Ctrl+K)"
                    Visibility="{Binding IsSearchExpanded, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:IconView Grid.Column="0" Geometry="{StaticResource Geo_Search}"
                                       Stroke="{DynamicResource TextSecondaryBrush}"
                                       Width="16" Height="16" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{loc:T sidebar.searchChats}" FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="Ctrl+K" FontSize="11" Opacity="0.6"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </Grid>
            </Button>

            <!-- Input mode (expanded) -->
            <Border Background="{DynamicResource BgSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6"
                    Visibility="{Binding IsSearchExpanded, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:IconView Grid.Column="0" Geometry="{StaticResource Geo_Search}"
                                       Stroke="{DynamicResource TextSecondaryBrush}"
                                       Width="15" Height="15" Margin="10,0,6,0"
                                       VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" x:Name="SearchInput"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             controls:WatermarkService.Text="{loc:T sidebar.searchPlaceholder}"
                             FontSize="13" Padding="0,7"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                             VerticalContentAlignment="Center"
                             PreviewKeyDown="SearchInput_PreviewKeyDown">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Grid>
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Margin="{TemplateBinding Padding}"
                                                  Focusable="False" />
                                    <TextBlock x:Name="Watermark"
                                               Text="{Binding Path=(controls:WatermarkService.Text), RelativeSource={RelativeSource TemplatedParent}}"
                                               Margin="{TemplateBinding Padding}"
                                               Padding="2,0,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Opacity="0.6"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter TargetName="Watermark" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                    <Button Grid.Column="2" Style="{DynamicResource IconButton}"
                            Width="24" Height="24" Margin="4,0,6,0"
                            controls:ButtonHelper.CornerRadius="12"
                            Click="CloseSearch_Click"
                            AutomationProperties.Name="Close search"
                            ToolTip="Close search (Esc)">
                        <controls:IconView Geometry="{StaticResource Geo_Close}"
                                           Stroke="{DynamicResource TextSecondaryBrush}"
                                           Width="12" Height="12" />
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Sidebar body (Phase 8 Task 2): ONE virtualized flat list — folder
             sections, time buckets and the "In messages" section are all rows
             of SidebarRows, so 500+ conversations realize only the viewport.
             Pixel scrolling keeps the feel identical to the old ScrollViewer. -->
        <ItemsControl Grid.Row="2" x:Name="SidebarList"
                      ItemsSource="{Binding SidebarRows}"
                      Focusable="False"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True"
                      PreviewMouseLeftButtonDown="SidebarList_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="SidebarList_PreviewMouseMove">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="True"
                                  Focusable="False">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Resources>
                <!-- Time-bucket header row -->
                <DataTemplate DataType="{x:Type vm:SidebarGroupHeaderRow}">
                    <TextBlock Text="{Binding Label, Converter={StaticResource UpperCase}}"
                               Margin="14,10,0,4"
                               FontSize="10" FontWeight="Medium"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </DataTemplate>

                <!-- Unfiled conversation row -->
                <DataTemplate DataType="{x:Type vm:ConversationItemViewModel}">
                    <ContentPresenter Content="{Binding}"
                                      ContentTemplate="{StaticResource ConversationRowTemplate}" />
                </DataTemplate>

                <!-- Conversation filed in a folder: same row, indented -->
                <DataTemplate DataType="{x:Type vm:FolderConversationRow}">
                    <ContentPresenter Content="{Binding Conversation}"
                                      ContentTemplate="{StaticResource ConversationRowTemplate}"
                                      Margin="12,0,0,0" />
                </DataTemplate>

                <!-- "In messages" section header (Phase 5) -->
                <DataTemplate DataType="{x:Type vm:SidebarSearchHeaderRow}">
                    <StackPanel>
                        <TextBlock Text="{loc:T search.inMessages}"
                                   Margin="14,10,0,4"
                                   FontSize="10" FontWeight="Medium"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <ProgressBar Height="2" Margin="14,0,14,4" IsIndeterminate="True"
                                     Visibility="{Binding DataContext.IsSearchingMessages,
                                                  RelativeSource={RelativeSource AncestorType={x:Type UserControl}},
                                                  Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </DataTemplate>

                <!-- Full-text hit row: opens its conversation; never-pulled
                     server conversations pull on click (Phase 8 Task 6). -->
                <DataTemplate DataType="{x:Type vm:MessageSearchHitViewModel}">
                    <Button Template="{StaticResource ConversationRowChrome}"
                            Margin="8,1" Cursor="Hand"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="{Binding Title}"
                            Command="{Binding DataContext.OpenMessageHitCommand,
                                      RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding}">
                        <StackPanel Background="Transparent">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Snippet}"
                                       FontSize="11.5" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ProgressBar Height="2" Margin="0,3,0,0" IsIndeterminate="True"
                                         Visibility="{Binding IsPulling, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Button>
                </DataTemplate>

                <!-- Folder header row: click toggles, right-click / "..." = menu,
                     drop target for conversation drag-drop (Phase 8). -->
                <DataTemplate DataType="{x:Type vm:FolderItemViewModel}">
                    <Button Template="{StaticResource ConversationRowChrome}"
                            Margin="8,1" Cursor="Hand"
                            HorizontalContentAlignment="Stretch"
                            Command="{Binding ToggleExpandCommand}"
                            AutomationProperties.Name="{Binding Name}"
                            AllowDrop="True"
                            DragEnter="FolderRow_DragEnter"
                            DragLeave="FolderRow_DragLeave"
                            DragOver="FolderRow_DragOver"
                            Drop="FolderRow_Drop"
                            Tag="{Binding DataContext,
                                  RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{loc:T folder.rename}"
                                                      Command="{Binding PlacementTarget.Tag.RenameFolderCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <controls:IconView Geometry="{StaticResource Geo_Rename}"
                                                                       Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                                                                       Width="14" Height="14" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="{loc:T folder.delete}"
                                                      Tag="Danger"
                                                      Foreground="{DynamicResource AccentRedBrush}"
                                                      Command="{Binding PlacementTarget.Tag.DeleteFolderCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <controls:IconView Geometry="{StaticResource Geo_Trash}"
                                                                       Stroke="{DynamicResource AccentRedBrush}"
                                                                       Width="14" Height="14" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Grid Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:IconView Grid.Column="0"
                                                           Geometry="{StaticResource Geo_ChevronRight}"
                                                           Stroke="{DynamicResource TextTertiaryBrush}"
                                                           Width="11" Height="11" Margin="0,0,6,0"
                                                           VerticalAlignment="Center"
                                                           RenderTransformOrigin="0.5,0.5">
                                            <controls:IconView.Style>
                                                <Style TargetType="controls:IconView">
                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="0" />
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <RotateTransform Angle="90" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:IconView.Style>
                                        </controls:IconView>
                                        <controls:IconView Grid.Column="1"
                                                           Geometry="{StaticResource Geo_Folder}"
                                                           Stroke="{DynamicResource TextSecondaryBrush}"
                                                           Width="14" Height="14" Margin="0,0,6,0"
                                                           VerticalAlignment="Center" />
                                        <!-- display mode -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Name}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                        <!-- inline rename mode (web parity R5) -->
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="13"
                                                 Padding="4,1"
                                                 Margin="-5,-2,0,-2"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}"
                                                 Loaded="InlineRename_Loaded"
                                                 IsVisibleChanged="InlineRename_IsVisibleChanged"
                                                 PreviewKeyDown="InlineRename_PreviewKeyDown"
                                                 LostFocus="InlineRename_LostFocus" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Conversations.Count, StringFormat=({0})}"
                                                   FontSize="11" Margin="4,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <Button Grid.Column="4"
                                                Style="{StaticResource RowOverflowButton}"
                                                Click="Overflow_Click"
                                                AutomationProperties.Name="Folder options"
                                                ToolTip="Folder options">
                                            <controls:IconView Geometry="{StaticResource Geo_More}"
                                                               Stroke="{DynamicResource TextSecondaryBrush}"
                                                               Width="14" Height="14" />
                                        </Button>
                                    </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.Resources>
        </ItemsControl>

        <!-- Status / footer -->
        <StackPanel Grid.Row="3" Margin="12,4,12,10">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ProgressBar Height="2" Margin="0,6,0,0" IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Grid>
</UserControl>
