<Window x:Class="SranDesktop.Presentation.Views.MemoryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:SranDesktop.Presentation.Converters"
        xmlns:controls="clr-namespace:SranDesktop.Presentation.Controls"
        xmlns:vm="clr-namespace:SranDesktop.Presentation.ViewModels"
        xmlns:loc="clr-namespace:SranDesktop.Presentation.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MemoryViewModel}"
        Title="{loc:T memory.title}"
        Width="640" Height="700"
        MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="24,24,24,12">
            <StackPanel Orientation="Horizontal">
                <controls:IconView Geometry="{StaticResource Geo_Brain}"
                                   Stroke="{DynamicResource TextPrimaryBrush}"
                                   Width="20" Height="20" Margin="0,0,10,0"
                                   VerticalAlignment="Center" />
                <TextBlock Text="{loc:T memory.title}" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{loc:T memory.description}" FontSize="12.5" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,16">
            <StackPanel>
                <ProgressBar Height="2" IsIndeterminate="True" Margin="0,4"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Margin="0,4"
                           TextWrapping="Wrap" Foreground="{DynamicResource AccentRedBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- ══ Suggested (pending) memories — callout card w/ accent bar ══ -->
                <Border Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12"
                        Padding="0" Margin="0,4,0,12"
                        Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- left accent bar (R8 B3 callout) -->
                        <Border Grid.Column="0" Width="4" CornerRadius="2"
                                Margin="6,8" Background="{DynamicResource AccentBrush}" />
                        <StackPanel Grid.Column="1" Margin="8,12,14,12">
                        <TextBlock Text="{Binding PendingHeader}" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ItemsControl ItemsSource="{Binding PendingMemories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MemoryItemViewModel}">
                                    <DockPanel Margin="0,4">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Style="{DynamicResource PillButton}" Padding="10,4"
                                                    Command="{Binding ConfirmCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:IconView Geometry="{StaticResource Geo_Check}"
                                                                       Stroke="{DynamicResource AccentGreenBrush}"
                                                                       Width="12" Height="12" Margin="0,0,5,0" />
                                                    <TextBlock Text="{loc:T common.confirm}" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{DynamicResource PillButton}" Padding="10,4" Margin="6,0,0,0"
                                                    Command="{Binding RejectCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:IconView Geometry="{StaticResource Geo_Close}"
                                                                       Stroke="{DynamicResource AccentRedBrush}"
                                                                       Width="11" Height="11" Margin="0,0,5,0" />
                                                    <TextBlock Text="{loc:T common.reject}" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Content}" FontSize="12.5"
                                                   TextWrapping="Wrap" Margin="0,0,10,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══ Global memory (local agent notes, cross-conversation) ══ -->
                <StackPanel Visibility="{Binding HasGlobalNotes, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding GlobalHeader}" FontSize="14" FontWeight="SemiBold"
                               Margin="0,4,0,6"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <ItemsControl ItemsSource="{Binding GlobalNotes}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GlobalNoteItemViewModel}">
                                <Border x:Name="NoteRoot"
                                        Background="{DynamicResource BgSecondaryBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="10"
                                        Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel>
                                            <!-- delete reveals on card hover, matching the saved rows -->
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                        VerticalAlignment="Top">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Opacity" Value="0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=NoteRoot}" Value="True">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button Style="{DynamicResource IconButton}" Width="26" Height="26"
                                                        ToolTip="{loc:T common.delete}" AutomationProperties.Name="{loc:T common.delete}"
                                                        Command="{Binding DeleteCommand}">
                                                    <controls:IconView Geometry="{StaticResource Geo_Trash}"
                                                                       Stroke="{DynamicResource AccentRedBrush}"
                                                                       Width="13" Height="13" />
                                                </Button>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Content}" FontSize="13"
                                                       TextWrapping="Wrap" Margin="0,0,10,0"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding MetaLine}" FontSize="11" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ══ Saved memories header + add + search ══ -->
                <DockPanel Margin="0,4,0,6">
                    <Button DockPanel.Dock="Right" Style="{DynamicResource AccentButton}" Padding="12,6"
                            Command="{Binding AddMemoryCommand}">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconView Geometry="{StaticResource Geo_Plus}"
                                               Stroke="{DynamicResource OnAccentBrush}"
                                               Width="13" Height="13" Margin="0,0,6,0" />
                            <TextBlock Text="{loc:T memory.addMemory}" FontSize="12.5" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding SavedHeader}" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </DockPanel>

                <!-- Search box: icon inside, rounded (R8 B3) -->
                <Border Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:IconView Grid.Column="0"
                                           Geometry="{StaticResource Geo_Search}"
                                           Stroke="{DynamicResource TextTertiaryBrush}"
                                           Width="14" Height="14" Margin="10,0,6,0"
                                           VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 controls:WatermarkService.Text="{loc:T memory.searchPlaceholder}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 VerticalContentAlignment="Center"
                                 Padding="0,7">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Grid>
                                        <ScrollViewer x:Name="PART_ContentHost"
                                                      Margin="{TemplateBinding Padding}"
                                                      Focusable="False" />
                                        <TextBlock x:Name="Watermark"
                                                   Text="{Binding Path=(controls:WatermarkService.Text), RelativeSource={RelativeSource TemplatedParent}}"
                                                   Margin="{TemplateBinding Padding}"
                                                   Padding="2,0,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Opacity="0.6"
                                                   IsHitTestVisible="False"
                                                   Visibility="Collapsed"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter TargetName="Watermark" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </Grid>
                </Border>

                <TextBlock Text="{loc:T memory.empty}" FontSize="13" Margin="0,16"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVisibility}}" />

                <!-- ══ Saved memory rows ══ -->
                <ItemsControl ItemsSource="{Binding Memories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MemoryItemViewModel}">
                            <Border x:Name="CardRoot"
                                    Background="{DynamicResource BgSecondaryBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10"
                                    Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel>
                                        <!-- actions reveal on card hover (R8 B3) -->
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                    VerticalAlignment="Top">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Opacity" Value="0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=CardRoot}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Style="{DynamicResource IconButton}" Width="26" Height="26"
                                                    ToolTip="{loc:T common.edit}" AutomationProperties.Name="{loc:T common.edit}"
                                                    Command="{Binding EditCommand}">
                                                <controls:IconView Geometry="{StaticResource Geo_Edit}"
                                                                   Stroke="{DynamicResource TextSecondaryBrush}"
                                                                   Width="13" Height="13" />
                                            </Button>
                                            <Button Style="{DynamicResource IconButton}" Width="26" Height="26"
                                                    ToolTip="{Binding PinLabel}" AutomationProperties.Name="{Binding PinLabel}"
                                                    Command="{Binding TogglePinCommand}">
                                                <controls:IconView Geometry="{StaticResource Geo_Pin}"
                                                                   Width="13" Height="13">
                                                    <controls:IconView.Style>
                                                        <Style TargetType="controls:IconView">
                                                            <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </controls:IconView.Style>
                                                </controls:IconView>
                                            </Button>
                                            <Button Style="{DynamicResource IconButton}" Width="26" Height="26"
                                                    ToolTip="{loc:T common.delete}" AutomationProperties.Name="{loc:T common.delete}"
                                                    Command="{Binding DeleteCommand}">
                                                <controls:IconView Geometry="{StaticResource Geo_Trash}"
                                                                   Stroke="{DynamicResource AccentRedBrush}"
                                                                   Width="13" Height="13" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                            <controls:IconView Geometry="{StaticResource Geo_Pin}"
                                                               Stroke="{DynamicResource AccentBrush}"
                                                               Width="11" Height="11" Margin="0,3,6,0"
                                                               VerticalAlignment="Top"
                                                               Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding Content}" FontSize="13"
                                                       TextWrapping="Wrap" MaxWidth="420"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding MetaLine}" FontSize="11" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ══ Data management ══ -->
                <TextBlock Text="{loc:T memory.dataManagement}" FontSize="13" FontWeight="SemiBold"
                           Margin="0,14,0,6"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <Button HorizontalAlignment="Left" Padding="12,6"
                        Command="{Binding ExportCommand}">
                    <StackPanel Orientation="Horizontal">
                        <controls:IconView Geometry="{StaticResource Geo_Export}"
                                           Stroke="{DynamicResource TextSecondaryBrush}"
                                           Width="13" Height="13" Margin="0,0,6,0" />
                        <TextBlock Text="{loc:T memory.export.button}" FontSize="12.5" />
                    </StackPanel>
                </Button>

                <!-- ══ Danger zone ══ -->
                <TextBlock Text="{loc:T memory.danger.title}" FontSize="13" FontWeight="SemiBold"
                           Margin="0,16,0,6"
                           Foreground="{DynamicResource AccentRedBrush}" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{DynamicResource DangerButton}" Padding="12,6"
                            Command="{Binding ClearAllCommand}">
                        <TextBlock Text="{loc:T memory.danger.clearButton}" FontSize="12.5" />
                    </Button>
                    <Button Style="{DynamicResource DangerButton}" Padding="12,6" Margin="8,0,0,0"
                            Command="{Binding PurgeCommand}">
                        <TextBlock Text="{loc:T memory.danger.purgeButton}" FontSize="12.5" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
