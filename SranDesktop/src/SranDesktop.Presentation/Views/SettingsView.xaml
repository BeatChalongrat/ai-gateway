<Window x:Class="SranDesktop.Presentation.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:SranDesktop.Presentation.Converters"
        xmlns:controls="clr-namespace:SranDesktop.Presentation.Controls"
        xmlns:loc="clr-namespace:SranDesktop.Presentation.Localization"
        xmlns:vm="clr-namespace:SranDesktop.Presentation.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="{loc:T settings.title}"
        Width="500" Height="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,18,24,12">
            <controls:IconView Geometry="{StaticResource Geo_Settings}"
                               Stroke="{DynamicResource TextPrimaryBrush}"
                               Width="20" Height="20" Margin="0,0,10,0"
                               VerticalAlignment="Center" />
            <TextBlock Text="{loc:T settings.title}" FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0">
            <StackPanel>

                <!-- General -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="{loc:T settings.general}" Style="{StaticResource SectionHeader}" />

                        <TextBlock Text="{loc:T settings.theme}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Themes}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  Margin="0,0,0,12" />

                        <TextBlock Text="{loc:T settings.defaultModel}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding AvailableModels}"
                                  SelectedValue="{Binding SelectedModelId}"
                                  SelectedValuePath="Id">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                        <Run Text="{Binding Provider, Mode=OneWay, StringFormat=({0})}"
                                             Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Personal instructions (Phase 13 Task 1) — account-wide, stored
                     on the server, so this is the same text the web Projects page
                     edits. Its own Save because it is a network write. -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="{loc:T settings.personal}" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{loc:T settings.personal.subtitle}"
                                   FontSize="12" Margin="0,-8,0,12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />

                        <TextBlock Text="{loc:T settings.personal.about}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding AboutYou, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="64" MaxHeight="120"
                                 VerticalScrollBarVisibility="Auto" />
                        <TextBlock HorizontalAlignment="Right" FontSize="10" Margin="0,2,0,10"
                                   Foreground="{DynamicResource TextTertiaryBrush}">
                            <Run Text="{Binding AboutYouLength, Mode=OneWay}" />
                            <Run Text="/" />
                            <Run Text="{Binding PersonalInstructionsMax, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock Text="{loc:T settings.personal.respond}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding RespondStyle, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="64" MaxHeight="120"
                                 VerticalScrollBarVisibility="Auto" />
                        <TextBlock HorizontalAlignment="Right" FontSize="10" Margin="0,2,0,4"
                                   Foreground="{DynamicResource TextTertiaryBrush}">
                            <Run Text="{Binding RespondStyleLength, Mode=OneWay}" />
                            <Run Text="/" />
                            <Run Text="{Binding PersonalInstructionsMax, Mode=OneWay}" />
                        </TextBlock>

                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" MinWidth="90" Padding="10,5"
                                    Content="{loc:T common.save}"
                                    Command="{Binding SavePersonalInstructionsCommand}"
                                    IsEnabled="{Binding CanSavePersonalInstructions}" />
                            <TextBlock Text="{Binding PersonalInstructionsStatus}"
                                       FontSize="11" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="0,0,10,0"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Desktop Integration -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="{loc:T settings.desktopIntegration}" Style="{StaticResource SectionHeader}" />

                        <CheckBox Content="{loc:T settings.minimizeToTray}"
                                  IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,8" />
                        <CheckBox Content="{loc:T settings.startWithWindows}"
                                  IsChecked="{Binding StartWithWindows}" Margin="0,0,0,8" />
                        <!-- Opt-in crash telemetry (R11 A3c) -->
                        <CheckBox IsChecked="{Binding CrashReportingEnabled}" Margin="0,0,0,8">
                            <TextBlock Text="{loc:T crash.optIn}" />
                        </CheckBox>
                        <!-- One-way agent-chat backup (Phase 3 D) -->
                        <CheckBox IsChecked="{Binding SyncAgentConversations}" Margin="0,0,0,2">
                            <TextBlock Text="{loc:T settings.syncAgentChats}" />
                        </CheckBox>
                        <TextBlock Text="{loc:T settings.syncAgentChatsHint}"
                                   FontSize="12" Margin="24,0,0,8" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <!-- On-device Office file generation (Phase 12 E) -->
                        <CheckBox IsChecked="{Binding PreferLocalOfficeGeneration}" Margin="0,0,0,2">
                            <TextBlock Text="{loc:T settings.localOfficeGen}" />
                        </CheckBox>
                        <TextBlock Text="{loc:T settings.localOfficeGenHint}"
                                   FontSize="12" Margin="24,0,0,8" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />

                        <TextBlock Text="{loc:T settings.globalHotkey}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{loc:T settings.globalHotkeyDesc}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Folder access (Phase 6 Task 1) -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="{loc:T settings.folderAccess}" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{loc:T settings.folderAccessHint}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />

                        <ItemsControl ItemsSource="{Binding GrantedFolders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right"
                                                Style="{DynamicResource IconButton}"
                                                Width="24" Height="24" Margin="8,0,0,0"
                                                controls:ButtonHelper.CornerRadius="12"
                                                Command="{Binding DataContext.RemoveFolderCommand,
                                                          RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{loc:T settings.removeFolder}"
                                                AutomationProperties.Name="{loc:T settings.removeFolder}">
                                            <controls:IconView Geometry="{StaticResource Geo_Close}"
                                                               Stroke="{DynamicResource TextSecondaryBrush}"
                                                               Width="11" Height="11" />
                                        </Button>
                                        <TextBlock Text="{Binding}" FontSize="12.5"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding FolderRejectedMessage}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource AccentRedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FolderRejectedMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button Content="{loc:T settings.addFolder}" Margin="0,10,0,0"
                                Padding="12,7" HorizontalAlignment="Left"
                                Background="Transparent" BorderThickness="1"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Command="{Binding AddFolderCommand}" />
                    </StackPanel>
                </Border>

                <!-- Browser bridge (Chrome extension) -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{loc:T settings.browser}" Style="{StaticResource SectionHeader}" Margin="0" />
                            <!-- status dot: green connected / grey not -->
                            <Ellipse Width="9" Height="9" Margin="8,2,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBrowserConnected}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource AccentGreenBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding BrowserStatusText}" FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>

                        <TextBlock Text="{loc:T settings.browser.hint}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />

                        <TextBlock Text="{loc:T settings.browser.token}" Style="{StaticResource FieldLabel}" />
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,5"
                                    Background="Transparent" BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Content="{loc:T settings.browser.copyToken}"
                                    Command="{Binding CopyBrowserTokenCommand}" />
                            <TextBox Text="{Binding BrowserPairingToken, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="Consolas" FontSize="12" />
                        </DockPanel>

                        <TextBlock Text="{loc:T settings.browser.extensionId}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding BrowserExtensionId, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" FontSize="12" Margin="0,0,0,10" />

                        <Button Content="{loc:T settings.browser.install}" Padding="12,7"
                                HorizontalAlignment="Left"
                                Background="Transparent" BorderThickness="1"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Command="{Binding InstallBrowserExtensionCommand}" />

                        <TextBlock Text="{Binding BrowserInstallMessage}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BrowserInstallMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Advanced (collapsed by default) -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <ToggleButton x:Name="AdvancedToggle" Cursor="Hand"
                                      HorizontalContentAlignment="Left"
                                      Background="Transparent" BorderThickness="0" Padding="0">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:T settings.advanced}" Style="{StaticResource SectionHeader}" Margin="0" />
                                <controls:IconView Geometry="{StaticResource Geo_ChevronDown}"
                                                   Stroke="{DynamicResource TextSecondaryBrush}"
                                                   Width="12" Height="12" Margin="8,2,0,0"
                                                   RenderTransformOrigin="0.5,0.5">
                                    <controls:IconView.Style>
                                        <Style TargetType="controls:IconView">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="0" />
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=AdvancedToggle}" Value="True">
                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="180" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:IconView.Style>
                                </controls:IconView>
                            </StackPanel>
                        </ToggleButton>

                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding IsChecked, ElementName=AdvancedToggle,
                                                 Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{loc:T settings.chatServerUrl}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ChatEdgeBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10" />

                            <TextBlock Text="{loc:T settings.gatewayUrl}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding GatewayBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10" />

                            <TextBlock Text="{loc:T settings.restartNote}"
                                       FontSize="11" FontStyle="Italic" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />

                            <Button Content="{loc:T settings.cleanupEmptyChats}" Margin="0,14,0,0"
                                    Padding="12,7" HorizontalAlignment="Left"
                                    Background="Transparent" BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Command="{Binding CleanupEmptyChatsCommand}"
                                    ToolTip="{loc:T settings.cleanupEmptyChatsTip}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="24,12,24,18">
            <Button Content="{loc:T common.cancel}" MinWidth="84" Padding="12,7" Margin="0,0,8,0"
                    IsCancel="True"
                    Background="Transparent" BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}" />
            <Button Content="{loc:T common.save}" MinWidth="84" Padding="12,7"
                    IsDefault="True" Click="Save_Click"
                    Style="{DynamicResource AccentButton}" />
        </StackPanel>
    </Grid>
</Window>
