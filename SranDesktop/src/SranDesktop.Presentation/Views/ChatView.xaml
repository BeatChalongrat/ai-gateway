<UserControl x:Class="SranDesktop.Presentation.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:SranDesktop.Presentation.Converters"
             xmlns:controls="clr-namespace:SranDesktop.Presentation.Controls"
             xmlns:vm="clr-namespace:SranDesktop.Presentation.ViewModels"
             xmlns:loc="clr-namespace:SranDesktop.Presentation.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ChatViewModel}"
             Background="{DynamicResource BgPrimaryBrush}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid AllowDrop="True"
          DragEnter="ChatRoot_DragEnter"
          DragOver="ChatRoot_DragOver"
          DragLeave="ChatRoot_DragLeave"
          Drop="ChatRoot_Drop"
          Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- History loading indicator -->
        <ProgressBar Grid.Row="0"
                     Height="2"
                     VerticalAlignment="Top"
                     IsIndeterminate="True"
                     Visibility="{Binding IsLoadingHistory, Converter={StaticResource BoolToVisibility}}" />

        <!-- Message list (UI-virtualized: only visible bubbles are realized) -->
        <ListBox Grid.Row="0"
                 x:Name="MessageList"
                 ItemsSource="{Binding Messages}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0,8"
                 Focusable="False"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.ScrollChanged="MessageList_ScrollChanged"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 KeyboardNavigation.TabNavigation="Once"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <!-- Phase 8 Task 5: Tab enters the transcript once; arrows
                         move between messages; Tab inside a message reaches
                         its action row (revealed via IsKeyboardFocusWithin). -->
                    <Setter Property="Focusable" Value="True" />
                    <Setter Property="IsTabStop" Value="True" />
                    <Setter Property="FocusVisualStyle" Value="{DynamicResource ThemedFocusVisual}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:MessageViewModel}">
                    <!-- centered 768px conversation column (web max-w-3xl).
                         Width="768" forces the column to always be 768px so
                         user bubbles right-align at the edge and assistant
                         text left-aligns — matching the web layout exactly. -->
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <controls:MessageBubble Grid.Row="0" Width="768" HorizontalAlignment="Center"
                                                Margin="24,0" />
                        <!-- P3 turn-anchor spacer: empty, hit-test-invisible
                             geometry BELOW the last bubble of an anchored
                             turn. Being item content, the virtualizing panel
                             measures it into the scrollable extent — which
                             ListBox.Padding (the old, broken spacer) never
                             was. Height is 0 on every other message. -->
                        <Border Grid.Row="1"
                                Height="{Binding TurnSpacerHeight}"
                                IsHitTestVisible="False"
                                Focusable="False" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Transcript skeleton (Phase 13 Task 3): placeholder bubbles while the
             first page of a chat loads, in the same 768px column the real
             messages use so nothing shifts when they arrive. Only shown when
             the list is still empty — see ShowHistorySkeleton. -->
        <ItemsControl Grid.Row="0" Margin="24,16,24,0"
                      IsHitTestVisible="False"
                      Focusable="False"
                      VerticalAlignment="Top"
                      Visibility="{Binding ShowHistorySkeleton, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Width="768" HorizontalAlignment="Center">
                <!-- user bubble, right-aligned -->
                <Border Style="{DynamicResource SkeletonBar}" Width="220" Height="34"
                        HorizontalAlignment="Right" Margin="0,0,0,18" />
                <!-- assistant paragraph, left-aligned -->
                <Border Style="{DynamicResource SkeletonBar}" Width="520"
                        HorizontalAlignment="Left" Margin="0,0,0,8" />
                <Border Style="{DynamicResource SkeletonBar}" Width="600"
                        HorizontalAlignment="Left" Margin="0,0,0,8" />
                <Border Style="{DynamicResource SkeletonBar}" Width="380"
                        HorizontalAlignment="Left" Margin="0,0,0,26" />
                <Border Style="{DynamicResource SkeletonBar}" Width="160" Height="34"
                        HorizontalAlignment="Right" Margin="0,0,0,18" />
                <Border Style="{DynamicResource SkeletonBar}" Width="560"
                        HorizontalAlignment="Left" Margin="0,0,0,8" />
                <Border Style="{DynamicResource SkeletonBar}" Width="300"
                        HorizontalAlignment="Left" />
            </StackPanel>
        </ItemsControl>

        <!-- Jump to latest (Phase C PART 2): shown only when scrolled up with
             content below; click smooth-scrolls to the newest message + re-pins. -->
        <Button x:Name="JumpToLatestButton" Grid.Row="0"
                Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,12" Width="36" Height="36"
                Cursor="Hand" Click="JumpToLatest_Click"
                ToolTip="{loc:T chat.jumpToLatest}"
                AutomationProperties.Name="{loc:T chat.jumpToLatest}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="18"
                            Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.25" />
                        </Border.Effect>
                        <controls:IconView Geometry="{StaticResource Geo_ChevronDown}"
                                           Stroke="{DynamicResource TextSecondaryBrush}"
                                           Width="18" Height="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BgPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- "Chat is getting long" nudge (Phase 5 Task 4) — dismissible,
             chat-edge conversations only, at most once per conversation. -->
        <Border Grid.Row="1"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource BgSecondaryBrush}"
                Padding="12,8"
                Margin="24,0,24,6"
                MaxWidth="768"
                HorizontalAlignment="Center">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ContextNudgeMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{DynamicResource IconButton}"
                        Width="22" Height="22" Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding DismissContextNudgeCommand}"
                        AutomationProperties.Name="Dismiss notice"
                        ToolTip="Dismiss">
                    <controls:IconView Geometry="{StaticResource Geo_Close}"
                                       Stroke="{DynamicResource TextSecondaryBrush}"
                                       Width="11" Height="11" />
                </Button>
                <TextBlock Text="{Binding ContextNudgeMessage}"
                           FontSize="12.5" TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </DockPanel>
        </Border>

        <!-- Error banner -->
        <Border Grid.Row="2"
                Background="{DynamicResource BgSecondaryBrush}"
                Padding="16,6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource AccentRedBrush}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Input area: shared composer (web parity Fix 2) -->
        <controls:ComposerControl Grid.Row="3" Margin="20,4,20,10" />

        <!-- Drag-drop overlay (A5) -->
        <Grid x:Name="DropOverlay" Grid.Row="0" Grid.RowSpan="4"
              Visibility="Collapsed" IsHitTestVisible="False">
            <Border Background="#B3000000" Margin="14" CornerRadius="12">
                <Grid>
                    <Rectangle Stroke="White" StrokeThickness="2" StrokeDashArray="5 3"
                               RadiusX="12" RadiusY="12" Opacity="0.7" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:IconView Geometry="{StaticResource Geo_Attach}"
                                           Stroke="White" Width="32" Height="32"
                                           HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:T input.dropFiles}" FontSize="16" Margin="0,10,0,0"
                                   Foreground="White" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
