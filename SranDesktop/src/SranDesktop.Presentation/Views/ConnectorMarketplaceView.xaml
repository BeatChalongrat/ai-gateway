<Window x:Class="SranDesktop.Presentation.Views.ConnectorMarketplaceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:SranDesktop.Presentation.Converters"
        xmlns:controls="clr-namespace:SranDesktop.Presentation.Controls"
        xmlns:vm="clr-namespace:SranDesktop.Presentation.ViewModels"
        xmlns:loc="clr-namespace:SranDesktop.Presentation.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ConnectorMarketplaceViewModel}"
        Title="{loc:T connector.title}"
        Width="640" Height="600"
        MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,24,24,8">
            <StackPanel Orientation="Horizontal">
                <controls:IconView Geometry="{StaticResource Geo_Store}"
                                   Stroke="{DynamicResource TextPrimaryBrush}"
                                   Width="20" Height="20" Margin="0,0,10,0"
                                   VerticalAlignment="Center" />
                <TextBlock Text="{loc:T connector.title}" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{loc:T connector.subtitle}" FontSize="12.5" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{loc:T connector.comingSoon}" FontSize="11" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="24,4,24,10">
            <!-- custom-connector UI entry point: any MCP server, HTTP or stdio -->
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,6"
                    VerticalAlignment="Center"
                    Command="{Binding AddCustomCommand}">
                <StackPanel Orientation="Horizontal">
                    <controls:IconView Geometry="{StaticResource Geo_Plus}"
                                       Stroke="{DynamicResource TextSecondaryBrush}"
                                       Width="12" Height="12" Margin="0,0,6,0" />
                    <TextBlock Text="{loc:T connector.addCustom}" FontSize="12" />
                </StackPanel>
            </Button>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     controls:WatermarkService.Text="{loc:T connector.searchPlaceholder}"
                     Padding="8,6" />
        </DockPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,0,24,16">
            <StackPanel>
            <!-- Connectors installed as packages in the managed folder. Listed
                 whether or not they are approved: one that is waiting for a
                 decision has to be visible, or the decision cannot be made. -->
            <StackPanel Margin="0,0,0,12"
                        Visibility="{Binding HasLocalConnectors, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Installed on this computer" FontSize="13" FontWeight="SemiBold"
                           Margin="0,4,0,8"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <ItemsControl ItemsSource="{Binding LocalConnectors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LocalConnectorItemViewModel}">
                            <Border Background="{DynamicResource BgSecondaryBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="12"
                                    Padding="14,12" Margin="0,0,0,10">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" VerticalAlignment="Center"
                                            Padding="12,5" Command="{Binding ReviewCommand}">
                                        <TextBlock Text="{Binding ActionText}" FontSize="12" />
                                    </Button>
                                    <StackPanel Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,7,0"
                                                     VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill"
                                                                Value="{DynamicResource AccentRedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsApproved}" Value="True">
                                                                <Setter Property="Fill"
                                                                        Value="{DynamicResource AccentGreenBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Name}" FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Version}" FontSize="11"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Publisher}" FontSize="12"
                                                   Margin="0,3,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Empty state (Phase 8 Task 4): with the embedded catalog the
                 list is only empty when a search matches nothing. -->
            <StackPanel Margin="0,32,0,8">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Connectors.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <controls:IconView Geometry="{StaticResource Geo_Store}"
                                   Stroke="{DynamicResource TextTertiaryBrush}"
                                   Width="40" Height="40"
                                   HorizontalAlignment="Center" />
                <TextBlock Text="{loc:T connector.empty}" FontSize="13" Margin="0,12,0,0"
                           HorizontalAlignment="Center" TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Connectors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ConnectorItemViewModel}">
                        <Border Background="{DynamicResource BgSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12"
                                Padding="14,12" Margin="0,0,0,10">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" VerticalAlignment="Center"
                                        Padding="12,5"
                                        Command="{Binding ToggleInstallCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BgSelectedBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding ButtonText}" FontSize="12" />
                                </Button>
                                <StackPanel Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- health dot: green/red/grey (R10 1E) -->
                                        <Ellipse Width="8" Height="8" Margin="0,0,7,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding StatusBrush}" />
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <Border Background="{DynamicResource BgSelectedBrush}" CornerRadius="4"
                                                Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <!-- the Custom badge replaces the category chip on custom cards -->
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCustom}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Category}" FontSize="9.5"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </Border>
                                        <!-- "Custom" badge: user-added server (custom-connector UI) -->
                                        <Border CornerRadius="4" BorderThickness="1"
                                                BorderBrush="{DynamicResource AccentBrush}"
                                                Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{loc:T connector.custom}" FontSize="9.5"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ToolsText}" FontSize="10.5" Margin="0,3,0,0"
                                               FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <!-- oauth2 flow status: Connecting… / connect failed (Phase 7 C5) -->
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
