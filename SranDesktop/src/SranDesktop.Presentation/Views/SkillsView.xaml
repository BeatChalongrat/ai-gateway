<Window x:Class="SranDesktop.Presentation.Views.SkillsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:SranDesktop.Presentation.Converters"
        xmlns:controls="clr-namespace:SranDesktop.Presentation.Controls"
        xmlns:vm="clr-namespace:SranDesktop.Presentation.ViewModels"
        xmlns:loc="clr-namespace:SranDesktop.Presentation.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SkillsViewModel}"
        Title="{loc:T skill.title}"
        Width="620" Height="560"
        MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="24,24,24,12">
            <Button DockPanel.Dock="Right" Style="{DynamicResource AccentButton}" Padding="12,6"
                    VerticalAlignment="Top"
                    Command="{Binding InstallCommand}">
                <StackPanel Orientation="Horizontal">
                    <controls:IconView Geometry="{StaticResource Geo_Plus}"
                                       Stroke="{DynamicResource OnAccentBrush}"
                                       Width="13" Height="13" Margin="0,0,6,0" />
                    <TextBlock Text="{loc:T skill.install}" FontSize="12.5" />
                </StackPanel>
            </Button>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <controls:IconView Geometry="{StaticResource Geo_Puzzle}"
                                       Stroke="{DynamicResource TextPrimaryBrush}"
                                       Width="20" Height="20" Margin="0,0,10,0"
                                       VerticalAlignment="Center" />
                    <TextBlock Text="{loc:T skill.title}" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{loc:T skill.subtitle}" FontSize="12.5" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,16">
            <StackPanel>
                <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Margin="0,4"
                           TextWrapping="Wrap" Foreground="{DynamicResource AccentRedBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Empty state (Phase 8 Task 4, KB pattern: icon + hint; the
                     header's Install button is the CTA) -->
                <StackPanel Margin="0,32,0,8">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Skills.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <controls:IconView Geometry="{StaticResource Geo_Puzzle}"
                                       Stroke="{DynamicResource TextTertiaryBrush}"
                                       Width="40" Height="40"
                                       HorizontalAlignment="Center" />
                    <TextBlock Text="{loc:T skill.empty}" FontSize="13" Margin="0,12,0,0"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Skills}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SkillItemViewModel}">
                            <Border Background="{DynamicResource BgSecondaryBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="12"
                                    Padding="14,12" Margin="0,0,0,10">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                VerticalAlignment="Top">
                                        <CheckBox IsChecked="{Binding IsEnabled}"
                                                  VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <Button Style="{DynamicResource IconButton}" Width="26" Height="26"
                                                ToolTip="{loc:T common.delete}" AutomationProperties.Name="{loc:T common.delete}"
                                                Command="{Binding DeleteCommand}"
                                                Visibility="{Binding IsBuiltin, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                            <controls:IconView Geometry="{StaticResource Geo_Trash}"
                                                               Stroke="{DynamicResource AccentRedBrush}"
                                                               Width="13" Height="13" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <controls:IconView Geometry="{StaticResource Geo_Puzzle}"
                                                               Stroke="{DynamicResource AccentBrush}"
                                                               Width="15" Height="15" Margin="0,0,8,0"
                                                               VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <Border Background="{DynamicResource BgSelectedBrush}" CornerRadius="4"
                                                    Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BadgeText}" FontSize="10"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Margin="23,3,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding TriggersText}" FontSize="11" Margin="23,3,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
