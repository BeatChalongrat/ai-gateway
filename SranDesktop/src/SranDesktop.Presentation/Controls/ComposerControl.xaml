<UserControl x:Class="SranDesktop.Presentation.Controls.ComposerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:SranDesktop.Presentation.Converters"
             xmlns:controls="clr-namespace:SranDesktop.Presentation.Controls"
             xmlns:vm="clr-namespace:SranDesktop.Presentation.ViewModels"
             xmlns:loc="clr-namespace:SranDesktop.Presentation.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ChatViewModel}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:EqualityToVisibilityConverter x:Key="EqualityToVisibility" />
    </UserControl.Resources>

    <!-- Cap the whole composer at 768 and centre it; Stretch all the way down so the
         box fills that width instead of shrinking to its toolbar content (Fix 3).
         Stretch + MaxWidth renders at 768 and is centred by WPF when space allows. -->
    <StackPanel MaxWidth="768" HorizontalAlignment="Stretch">
        <Border HorizontalAlignment="Stretch"
                CornerRadius="24"
                BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource BgSecondaryBrush}"
                Padding="16,12,16,8"
                AllowDrop="True"
                DragOver="ComposerBorder_DragOver"
                Drop="ComposerBorder_Drop">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="12" Opacity="0.18" Color="Black" Direction="270" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- pending attachment chips -->
                <ItemsControl Grid.Row="0"
                              ItemsSource="{Binding PendingFiles}"
                              Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PendingFileViewModel}">
                            <Border Background="{DynamicResource BgSecondaryBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,4"
                                    Margin="0,0,6,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentRedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <!-- image chip: thumbnail preview (R9 D3) -->
                                    <Border CornerRadius="6" Margin="0,0,6,0" ClipToBounds="True"
                                            Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                                        <Image Source="{Binding ThumbnailSource}"
                                               MaxWidth="56" MaxHeight="40"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <controls:IconView Geometry="{StaticResource Geo_Attach}"
                                                       Stroke="{DynamicResource TextSecondaryBrush}"
                                                       Width="12" Height="12" Margin="0,0,5,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="12"
                                               MaxWidth="180"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding Error}"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <ProgressBar Width="46" Height="4"
                                                 Margin="6,0,0,0"
                                                 VerticalAlignment="Center"
                                                 Minimum="0" Maximum="100"
                                                 Value="{Binding Progress, Mode=OneWay}"
                                                 Visibility="{Binding IsUploading, Converter={StaticResource BoolToVisibility}}" />
                                    <controls:IconView Geometry="{StaticResource Geo_Check}"
                                                       Stroke="{DynamicResource AccentGreenBrush}"
                                                       Width="13" Height="13" Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="failed" Margin="6,0,0,0" FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentRedBrush}"
                                               Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Command="{Binding DataContext.RemovePendingFileCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{DynamicResource IconButton}"
                                            Width="18" Height="18"
                                            controls:ButtonHelper.CornerRadius="9"
                                            Margin="6,0,0,0"
                                            ToolTip="Remove" AutomationProperties.Name="Remove">
                                        <controls:IconView Geometry="{StaticResource Geo_Close}"
                                                           Stroke="{DynamicResource TextSecondaryBrush}"
                                                           Width="10" Height="10" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- input row: borderless textarea filling the box -->
                <TextBox Grid.Row="1"
                         x:Name="InputBox"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         controls:WatermarkService.Text="{loc:T input.placeholder}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="24"
                         MaxHeight="200"
                         FontSize="15"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                         VerticalScrollBarVisibility="Auto"
                         Padding="2,2"
                         PreviewKeyDown="InputBox_PreviewKeyDown">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>

                <!-- toolbar row: [+] .......... [Knowledge] [model ▾] [send] (R2 Fix 3) -->
                <DockPanel Grid.Row="2" Margin="0,6,0,0" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <!-- + : attach -->
                        <Button Click="AttachButton_Click"
                                Style="{DynamicResource IconButton}"
                                Width="30" Height="30"
                                controls:ButtonHelper.CornerRadius="15"
                                AutomationProperties.Name="Attach files"
                                ToolTip="{loc:T input.attach}">
                            <controls:IconView Geometry="{StaticResource Geo_Plus}"
                                               Stroke="{DynamicResource TextSecondaryBrush}"
                                               Width="16" Height="16" />
                        </Button>
                        <!-- mic: dictation into the composer (R9 J1) -->
                        <ToggleButton IsChecked="{Binding IsListening}"
                                      ToolTip="{loc:T input.voice}"
                                      Margin="2,0,0,0"
                                      Width="30" Height="30"
                                      Cursor="Hand"
                                      AutomationProperties.Name="Voice input">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bg" Background="Transparent"
                                            CornerRadius="15" Padding="6">
                                        <controls:IconView Geometry="{StaticResource Geo_Mic}"
                                                           Width="15" Height="15">
                                            <controls:IconView.Style>
                                                <Style TargetType="controls:IconView">
                                                    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                            <Setter Property="Stroke" Value="{DynamicResource AccentRedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:IconView.Style>
                                        </controls:IconView>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BgSelectedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BgSelectedBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <!-- working folder pill (Cowork-style) -->
                        <Button Style="{DynamicResource PillButton}"
                                Padding="8,4" Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding SelectWorkingFolderCommand}"
                                AutomationProperties.Name="Select working folder"
                                ToolTip="{Binding WorkingFolderTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <controls:IconView Geometry="{StaticResource Geo_FolderPlus}"
                                                   Stroke="{DynamicResource TextSecondaryBrush}"
                                                   Width="14" Height="14" Margin="0,0,5,0"
                                                   VerticalAlignment="Center" />
                                <TextBlock Text="{Binding WorkingFolderLabel}" FontSize="13"
                                           MaxWidth="140" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                        <!-- clear working folder (only when one is set) -->
                        <Button Command="{Binding ClearWorkingFolderCommand}"
                                Style="{DynamicResource IconButton}"
                                Width="18" Height="18"
                                controls:ButtonHelper.CornerRadius="9"
                                Margin="2,0,0,0" VerticalAlignment="Center"
                                AutomationProperties.Name="Clear working folder"
                                ToolTip="{loc:T input.clearWorkingFolder}"
                                Visibility="{Binding HasWorkingFolder, Converter={StaticResource BoolToVisibility}}">
                            <controls:IconView Geometry="{StaticResource Geo_Close}"
                                               Stroke="{DynamicResource TextSecondaryBrush}"
                                               Width="10" Height="10" />
                        </Button>
                        <!-- permission mode pill: opens the 3-mode dropdown -->
                        <Button x:Name="PermissionButton"
                                Style="{DynamicResource PillButton}"
                                Padding="8,4" Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding OpenPermissionPopupCommand}"
                                AutomationProperties.Name="Permission mode"
                                ToolTip="{loc:T perm.tooltip}">
                            <StackPanel Orientation="Horizontal">
                                <controls:IconView Geometry="{StaticResource Geo_Shield}"
                                                   Stroke="{DynamicResource TextSecondaryBrush}"
                                                   Width="14" Height="14" Margin="0,0,5,0"
                                                   VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ApprovalModeLabel}" FontSize="13"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <controls:IconView Geometry="{StaticResource Geo_ChevronDown}"
                                                   Stroke="{DynamicResource TextSecondaryBrush}"
                                                   Width="11" Height="11" Margin="4,1,0,0" />
                            </StackPanel>
                        </Button>
                        <!-- listening hint -->
                        <TextBlock Text="{loc:T voice.listening}" FontSize="11.5"
                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentRedBrush}"
                                   Visibility="{Binding IsListening, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <!-- Knowledge selector pill (active conversation only — R2 Fix 3c) -->
                        <Button x:Name="KnowledgeButton"
                                Style="{DynamicResource PillButton}"
                                Padding="8,4" Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Command="{Binding OpenKnowledgePopupCommand}"
                                AutomationProperties.Name="Select knowledge base"
                                ToolTip="{loc:T input.selectKnowledgeBase}"
                                Visibility="{Binding HasActiveConversation, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <controls:IconView Geometry="{StaticResource Geo_BookOpen}"
                                                   Stroke="{DynamicResource TextSecondaryBrush}"
                                                   Width="14" Height="14" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding KnowledgeBaseLabel}" FontSize="13"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Button>

                        <!-- model selector: interactive dropdown (R2 Fix 3b) -->
                        <Button x:Name="ModelSelectorButton"
                                Style="{DynamicResource PillButton}"
                                Padding="8,4" Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Click="ModelSelectorButton_Click"
                                Command="{Binding OpenModelPopupCommand}"
                                AutomationProperties.Name="Select model"
                                ToolTip="{loc:T input.selectModel}">
                            <StackPanel Orientation="Horizontal">
                                <!-- Image mode toggle: click to force image generation -->
                                <ToggleButton IsChecked="{Binding IsImageModeOn}"
                                              ToolTip="{loc:T input.imageMode}" AutomationProperties.Name="{loc:T input.imageMode}"
                                              Visibility="{Binding CurrentModelSupportsImage, Converter={StaticResource BoolToVisibility}}"
                                              Margin="0,0,2,0"
                                              Width="28" Height="28"
                                              Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bg" Background="Transparent"
                                                    CornerRadius="6" Padding="5">
                                                <controls:IconView Geometry="{StaticResource Geo_ImageBadge}"
                                                                   Width="14" Height="14">
                                                    <controls:IconView.Style>
                                                        <Style TargetType="controls:IconView">
                                                            <Setter Property="Stroke" Value="{DynamicResource TextTertiaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                                    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </controls:IconView.Style>
                                                </controls:IconView>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BgSelectedBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BgSelectedBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <!-- Video mode toggle: click to force video generation -->
                                <ToggleButton IsChecked="{Binding IsVideoModeOn}"
                                              ToolTip="{loc:T input.videoMode}" AutomationProperties.Name="{loc:T input.videoMode}"
                                              Visibility="{Binding CurrentModelSupportsVideo, Converter={StaticResource BoolToVisibility}}"
                                              Margin="0,0,2,0"
                                              Width="28" Height="28"
                                              Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bg" Background="Transparent"
                                                    CornerRadius="6" Padding="5">
                                                <controls:IconView Geometry="{StaticResource Geo_VideoBadge}"
                                                                   Width="14" Height="14">
                                                    <controls:IconView.Style>
                                                        <Style TargetType="controls:IconView">
                                                            <Setter Property="Stroke" Value="{DynamicResource TextTertiaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                                    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </controls:IconView.Style>
                                                </controls:IconView>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BgSelectedBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BgSelectedBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <!-- Web-search toggle: offers the web_search tool (R9 C3) -->
                                <ToggleButton IsChecked="{Binding IsWebSearchOn}"
                                              ToolTip="{loc:T input.webSearch}" AutomationProperties.Name="{loc:T input.webSearch}"
                                              Margin="0,0,2,0"
                                              Width="28" Height="28"
                                              Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bg" Background="Transparent"
                                                    CornerRadius="6" Padding="5">
                                                <controls:IconView Geometry="{StaticResource Geo_Globe2}"
                                                                   Width="14" Height="14">
                                                    <controls:IconView.Style>
                                                        <Style TargetType="controls:IconView">
                                                            <Setter Property="Stroke" Value="{DynamicResource TextTertiaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                                    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </controls:IconView.Style>
                                                </controls:IconView>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BgSelectedBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BgSelectedBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <!-- Sparkle icon: only shown when Auto is selected, no special color -->
                                <controls:IconView Geometry="{StaticResource Geo_Sparkles}"
                                                   Stroke="{DynamicResource TextSecondaryBrush}"
                                                   Width="13" Height="13" Margin="0,0,5,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsAutoSelected, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding CurrentModelDisplayName}" FontSize="13"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <controls:IconView Geometry="{StaticResource Geo_ChevronDown}"
                                                   Stroke="{DynamicResource TextSecondaryBrush}"
                                                   Width="11" Height="11" Margin="4,1,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- send / stop circle -->
                        <Button Width="32" Height="32"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Send"
                                controls:ButtonHelper.CornerRadius="16">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                    <Setter Property="Command" Value="{Binding SendCommand}" />
                                    <Setter Property="ToolTip" Value="{loc:T input.send}" />
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <controls:IconView Geometry="{StaticResource Geo_Send}"
                                                               Stroke="{DynamicResource OnAccentBrush}"
                                                               StrokeThickness="2.5"
                                                               Width="16" Height="16" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <!-- disabled (empty input): surface-hover bg + faint icon -->
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource BgSelectedBrush}" />
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <controls:IconView Geometry="{StaticResource Geo_Send}"
                                                                       Stroke="{DynamicResource TextTertiaryBrush}"
                                                                       StrokeThickness="2.5"
                                                                       Width="16" Height="16" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <!-- streaming: foreground bg + filled stop -->
                                        <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Command" Value="{Binding CancelStreamingCommand}" />
                                            <Setter Property="ToolTip" Value="{loc:T input.stop}" />
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <controls:IconView Geometry="{StaticResource Geo_Stop}"
                                                                       Fill="{DynamicResource OnAccentBrush}"
                                                                       Width="13" Height="13" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Model selector popup (R2 Fix 3b) — open/close managed in code-behind
                     to avoid dual-instance TwoWay binding conflicts between the home
                     screen and conversation-view ComposerControls. -->
                <Popup x:Name="ModelSelectorPopup"
                       PlacementTarget="{Binding ElementName=ModelSelectorButton}"
                       Placement="Top"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       Opened="ModelSelectorPopup_Opened"
                       Closed="ModelSelectorPopup_Closed">
                    <Border x:Name="ModelPopupRoot" Margin="8"
                            Background="{DynamicResource BgPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="12"
                            Padding="8" MinWidth="380" MaxWidth="460"
                            PreviewKeyDown="ModelPopup_PreviewKeyDown">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="2"
                                              Opacity="0.35" Color="Black" />
                        </Border.Effect>
                        <Border.Resources>
                            <!-- One model row: name+provider, capability badges, checkmark -->
                            <DataTemplate x:Key="ModelRowTemplate" DataType="{x:Type vm:ModelItemViewModel}">
                                <Button Style="{DynamicResource FlatRowButton}"
                                        Padding="8,6"
                                        Command="{Binding DataContext.SelectModelCommand, ElementName=ModelPopupRoot}"
                                        CommandParameter="{Binding Model}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <!-- Phase C PART 4: provider · context window -->
                                            <TextBlock Text="{Binding MetaLine}" FontSize="11"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       Visibility="{Binding HasMetaLine, Converter={StaticResource BoolToVisibility}}" />
                                            <!-- Phase C PART 4: one-line model description (was unrendered) -->
                                            <TextBlock Text="{Binding Description}" FontSize="11"
                                                       TextWrapping="Wrap" MaxWidth="320" Margin="0,1,0,0"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    Margin="8,0,0,0" VerticalAlignment="Center">
                                            <!-- Image badge (purple) -->
                                            <Border Background="#1A8B5CF6" CornerRadius="4" Padding="6,2" Margin="0,0,4,0"
                                                    Visibility="{Binding SupportsImage, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:IconView Geometry="{StaticResource Geo_ImageBadge}"
                                                                       Stroke="#8B5CF6" StrokeThickness="1.4"
                                                                       Width="11" Height="11" Margin="0,0,4,0"
                                                                       VerticalAlignment="Center" />
                                                    <TextBlock Text="Image" FontSize="10.5" FontWeight="Medium"
                                                               Foreground="#8B5CF6" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Thinks badge (blue) -->
                                            <Border Background="#1A3B82F6" CornerRadius="4" Padding="6,2" Margin="0,0,4,0"
                                                    Visibility="{Binding SupportsThinking, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:IconView Geometry="{StaticResource Geo_Brain}"
                                                                       Stroke="#3B82F6" StrokeThickness="1.4"
                                                                       Width="11" Height="11" Margin="0,0,4,0"
                                                                       VerticalAlignment="Center" />
                                                    <TextBlock Text="Thinks" FontSize="10.5" FontWeight="Medium"
                                                               Foreground="#3B82F6" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Video badge (red) -->
                                            <Border Background="#1AEF4444" CornerRadius="4" Padding="6,2" Margin="0,0,4,0"
                                                    Visibility="{Binding SupportsVideo, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:IconView Geometry="{StaticResource Geo_VideoBadge}"
                                                                       Stroke="#EF4444" StrokeThickness="1.4"
                                                                       Width="11" Height="11" Margin="0,0,4,0"
                                                                       VerticalAlignment="Center" />
                                                    <TextBlock Text="Video" FontSize="10.5" FontWeight="Medium"
                                                               Foreground="#EF4444" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Music badge (green) -->
                                            <Border Background="#1A10B981" CornerRadius="4" Padding="6,2" Margin="0,0,4,0"
                                                    Visibility="{Binding SupportsAudio, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:IconView Geometry="{StaticResource Geo_AudioBadge}"
                                                                       Stroke="#10B981" StrokeThickness="1.4"
                                                                       Width="11" Height="11" Margin="0,0,4,0"
                                                                       VerticalAlignment="Center" />
                                                    <TextBlock Text="Music" FontSize="10.5" FontWeight="Medium"
                                                               Foreground="#10B981" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <controls:IconView Geometry="{StaticResource Geo_Check}"
                                                               Stroke="{DynamicResource AccentGreenBrush}"
                                                               Width="14" Height="14" Margin="4,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </Border.Resources>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBox Grid.Row="0" x:Name="ModelSearchBox"
                                     Text="{Binding ModelSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     controls:WatermarkService.Text="{loc:T model.searchPlaceholder}"
                                     Margin="4,4,4,8" Padding="8,6" FontSize="13" />

                            <!-- Auto: the gateway routes each turn to the best model -->
                            <Button Grid.Row="1"
                                    Style="{DynamicResource FlatRowButton}" Padding="8,7"
                                    Command="{Binding SelectAutoCommand}"
                                    AutomationProperties.Name="Auto model">
                                <DockPanel LastChildFill="True">
                                    <controls:IconView DockPanel.Dock="Left"
                                                       Geometry="{StaticResource Geo_Sparkles}"
                                                       Stroke="{DynamicResource AccentPurpleBrush}"
                                                       Width="17" Height="17" Margin="0,0,10,0"
                                                       VerticalAlignment="Center" />
                                    <controls:IconView DockPanel.Dock="Right"
                                                       Geometry="{StaticResource Geo_Check}"
                                                       Stroke="{DynamicResource AccentGreenBrush}"
                                                       Width="14" Height="14" Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsAutoSelected, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{loc:T model.auto.name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{loc:T model.auto.description}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>

                            <ScrollViewer Grid.Row="2" MaxHeight="380"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding GroupedModels}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ModelGroup}">
                                            <StackPanel>
                                                <!-- collapsible provider header -->
                                                <Button Style="{DynamicResource FlatRowButton}" Padding="8,5"
                                                        Command="{Binding ToggleExpandCommand}"
                                                        Visibility="{Binding IsCollapsible, Converter={StaticResource BoolToVisibility}}">
                                                    <DockPanel LastChildFill="True">
                                                        <controls:IconView DockPanel.Dock="Right"
                                                                           Geometry="{StaticResource Geo_ChevronDown}"
                                                                           Stroke="{DynamicResource TextTertiaryBrush}"
                                                                           Width="11" Height="11" Margin="6,0,0,0"
                                                                           VerticalAlignment="Center"
                                                                           RenderTransformOrigin="0.5,0.5">
                                                            <controls:IconView.Style>
                                                                <Style TargetType="controls:IconView">
                                                                    <Setter Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <RotateTransform Angle="-90" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                            <Setter Property="RenderTransform">
                                                                                <Setter.Value>
                                                                                    <RotateTransform Angle="0" />
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </controls:IconView.Style>
                                                        </controls:IconView>
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Text="{Binding Count}" FontSize="11"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Header}"
                                                                   FontSize="11" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </Button>
                                                <!-- static header (POPULAR / RECENTLY USED) -->
                                                <TextBlock Text="{Binding Header}"
                                                           FontSize="11" FontWeight="Bold"
                                                           Margin="12,8,12,3"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           Visibility="{Binding IsCollapsible, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                                <!-- rows -->
                                                <ItemsControl ItemsSource="{Binding Models}"
                                                              ItemTemplate="{StaticResource ModelRowTemplate}"
                                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- shown when the catalogue couldn't be loaded / is empty -->
                            <TextBlock Grid.Row="2" Text="{loc:T model.none}"
                                       FontSize="12" Margin="8,10"
                                       Foreground="{DynamicResource TextTertiaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AvailableModels.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Popup>

                <!-- Knowledge base popup (R2 Fix 3c) -->
                <Popup x:Name="KnowledgePopup"
                       PlacementTarget="{Binding ElementName=KnowledgeButton}"
                       Placement="Top"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Popup.Style>
                        <Style TargetType="Popup">
                            <Setter Property="IsOpen" Value="{Binding IsKnowledgePopupOpen, Mode=TwoWay}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                    <Setter Property="IsOpen" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Popup.Style>
                    <Border Margin="8"
                            Background="{DynamicResource BgPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="12"
                            Padding="8" MinWidth="260" MaxWidth="340">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="2"
                                              Opacity="0.35" Color="Black" />
                        </Border.Effect>
                        <StackPanel>
                            <!-- unbind row -->
                            <Button Style="{DynamicResource FlatRowButton}" Padding="8,6"
                                    Command="{Binding SelectKnowledgeBaseCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:T kbPopup.none}" FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <controls:IconView Grid.Column="1"
                                                       Geometry="{StaticResource Geo_Check}"
                                                       Stroke="{DynamicResource AccentBrush}"
                                                       Width="14" Height="14" Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding HasKnowledgeBase, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                </Grid>
                            </Button>

                            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AvailableKnowledgeBases}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{DynamicResource FlatRowButton}"
                                                    Padding="8,6"
                                                    Command="{Binding DataContext.SelectKnowledgeBaseCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock FontSize="11"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}">
                                                            <Run Text="{Binding DocumentCount, Mode=OneWay}" /><Run Text=" documents" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <controls:IconView Grid.Column="1"
                                                                       Geometry="{StaticResource Geo_Check}"
                                                                       Stroke="{DynamicResource AccentBrush}"
                                                                       Width="14" Height="14" Margin="8,0,0,0"
                                                                       VerticalAlignment="Center">
                                                        <controls:IconView.Visibility>
                                                            <MultiBinding Converter="{StaticResource EqualityToVisibility}">
                                                                <Binding Path="Id" />
                                                                <Binding Path="DataContext.KnowledgeBaseId"
                                                                         RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                            </MultiBinding>
                                                        </controls:IconView.Visibility>
                                                    </controls:IconView>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Text="{loc:T kbPopup.empty}" FontSize="12" Margin="8,6"
                                       Foreground="{DynamicResource TextTertiaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AvailableKnowledgeBases.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Popup>
                <!-- Permission mode popup (Cowork-style 3-mode dropdown) -->
                <Popup x:Name="PermissionPopup"
                       PlacementTarget="{Binding ElementName=PermissionButton}"
                       Placement="Top"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Popup.Style>
                        <Style TargetType="Popup">
                            <Setter Property="IsOpen" Value="{Binding IsPermissionPopupOpen, Mode=TwoWay}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                    <Setter Property="IsOpen" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Popup.Style>
                    <Border Margin="8"
                            Background="{DynamicResource BgPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="12"
                            Padding="8" MinWidth="320" MaxWidth="400">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="2"
                                              Opacity="0.35" Color="Black" />
                        </Border.Effect>
                        <StackPanel>
                            <!-- Manually approve -->
                            <Button Style="{DynamicResource FlatRowButton}" Padding="8,7"
                                    Command="{Binding SelectApprovalModeCommand}"
                                    CommandParameter="manual"
                                    AutomationProperties.Name="{loc:T perm.manual.name}">
                                <DockPanel LastChildFill="True">
                                    <controls:IconView DockPanel.Dock="Left"
                                                       Geometry="{StaticResource Geo_Hand}"
                                                       Stroke="{DynamicResource TextSecondaryBrush}"
                                                       Width="16" Height="16" Margin="0,0,10,0"
                                                       VerticalAlignment="Center" />
                                    <controls:IconView DockPanel.Dock="Right"
                                                       Geometry="{StaticResource Geo_Check}"
                                                       Stroke="{DynamicResource AccentBrush}"
                                                       Width="14" Height="14" Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsApprovalManual, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{loc:T perm.manual.name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{loc:T perm.manual.desc}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <!-- Automatically approve -->
                            <Button Style="{DynamicResource FlatRowButton}" Padding="8,7"
                                    Command="{Binding SelectApprovalModeCommand}"
                                    CommandParameter="auto"
                                    AutomationProperties.Name="{loc:T perm.auto.name}">
                                <DockPanel LastChildFill="True">
                                    <controls:IconView DockPanel.Dock="Left"
                                                       Geometry="{StaticResource Geo_FastForward}"
                                                       Stroke="{DynamicResource TextSecondaryBrush}"
                                                       Width="16" Height="16" Margin="0,0,10,0"
                                                       VerticalAlignment="Center" />
                                    <controls:IconView DockPanel.Dock="Right"
                                                       Geometry="{StaticResource Geo_Check}"
                                                       Stroke="{DynamicResource AccentBrush}"
                                                       Width="14" Height="14" Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsApprovalAuto, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{loc:T perm.auto.name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{loc:T perm.auto.desc}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <!-- Skip all approvals -->
                            <Button Style="{DynamicResource FlatRowButton}" Padding="8,7"
                                    Command="{Binding SelectApprovalModeCommand}"
                                    CommandParameter="skip"
                                    AutomationProperties.Name="{loc:T perm.skip.name}">
                                <DockPanel LastChildFill="True">
                                    <controls:IconView DockPanel.Dock="Left"
                                                       Geometry="{StaticResource Geo_Warning}"
                                                       Stroke="{DynamicResource TextSecondaryBrush}"
                                                       Width="16" Height="16" Margin="0,0,10,0"
                                                       VerticalAlignment="Center" />
                                    <controls:IconView DockPanel.Dock="Right"
                                                       Geometry="{StaticResource Geo_Check}"
                                                       Stroke="{DynamicResource AccentBrush}"
                                                       Width="14" Height="14" Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsApprovalSkip, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{loc:T perm.skip.name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{loc:T perm.skip.desc}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <!-- Disclaimer (web parity) -->
        <TextBlock Text="{loc:T input.footer}"
                   FontSize="11" Margin="0,8,0,0"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextTertiaryBrush}" />
    </StackPanel>
</UserControl>
