<UserControl x:Class="SranDesktop.Presentation.Controls.CircularProgress"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="48" Height="48">
    <Grid>
        <!-- track -->
        <Ellipse Stroke="{DynamicResource BorderBrush}" StrokeThickness="4"
                 Fill="Transparent" Margin="2" />
        <!-- progress arc (geometry set in code-behind) -->
        <Path x:Name="ArcPath" Stroke="#10B981" StrokeThickness="4"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <!-- center label -->
        <TextBlock x:Name="Label"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="11" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
    </Grid>
</UserControl>
