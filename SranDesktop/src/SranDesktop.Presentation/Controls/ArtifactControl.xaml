<UserControl x:Class="SranDesktop.Presentation.Controls.ArtifactControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SranDesktop.Presentation.Controls"
             xmlns:vm="clr-namespace:SranDesktop.Presentation.ViewModels"
             xmlns:loc="clr-namespace:SranDesktop.Presentation.Localization"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ArtifactViewModel}"
             Loaded="ArtifactControl_Loaded"
             Unloaded="ArtifactControl_Unloaded">

    <!-- Live artifact card: toolbar + WebView2 renderer (R9 A2) -->
    <Border CornerRadius="12" BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}"
            Background="{DynamicResource BgSecondaryBrush}"
            Margin="0,8" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- toolbar -->
            <DockPanel Grid.Row="0" Margin="12,8" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{DynamicResource IconButton}" Width="26" Height="26"
                            Command="{Binding CopySourceCommand}"
                            ToolTip="{loc:T artifact.copyCode}" AutomationProperties.Name="{loc:T artifact.copyCode}">
                        <controls:IconView Geometry="{StaticResource Geo_Copy}"
                                           Stroke="{DynamicResource TextSecondaryBrush}"
                                           Width="13" Height="13" />
                    </Button>
                    <Button Style="{DynamicResource IconButton}" Width="26" Height="26"
                            Command="{Binding ToggleFullscreenCommand}"
                            ToolTip="{loc:T artifact.fullscreen}" AutomationProperties.Name="{loc:T artifact.fullscreen}">
                        <controls:IconView Geometry="{StaticResource Geo_Fullscreen}"
                                           Stroke="{DynamicResource TextSecondaryBrush}"
                                           Width="13" Height="13" />
                    </Button>
                    <Button Style="{DynamicResource IconButton}" Width="26" Height="26"
                            Command="{Binding OpenExternalCommand}"
                            ToolTip="{loc:T artifact.openExternal}" AutomationProperties.Name="{loc:T artifact.openExternal}">
                        <controls:IconView Geometry="{StaticResource Geo_Browser}"
                                           Stroke="{DynamicResource TextSecondaryBrush}"
                                           Width="13" Height="13" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <controls:IconView Geometry="{StaticResource Geo_Sparkles}"
                                       Stroke="{DynamicResource AccentBrush}"
                                       Width="14" Height="14" Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Border Background="{DynamicResource BgSelectedBrush}" CornerRadius="4"
                            Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Type}" FontSize="10"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </Border>
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BorderBrush}">
                <Grid>
                    <wv2:WebView2 x:Name="ArtifactWebView"
                                  MinHeight="200" MaxHeight="600"
                                  DefaultBackgroundColor="Transparent" />
                    <!-- shown when the WebView2 runtime is unavailable -->
                    <TextBlock x:Name="FallbackText"
                               Visibility="Collapsed"
                               Margin="14" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
