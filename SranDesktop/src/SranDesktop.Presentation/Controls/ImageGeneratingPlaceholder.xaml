<UserControl x:Class="SranDesktop.Presentation.Controls.ImageGeneratingPlaceholder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SranDesktop.Presentation.Controls"
             xmlns:loc="clr-namespace:SranDesktop.Presentation.Localization">
    <!-- Shimmer placeholder shown while the server generates an image (R7 A2) -->
    <Border Width="256" Height="256"
            CornerRadius="12"
            HorizontalAlignment="Left"
            Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Margin="0,6">
        <StackPanel x:Name="PulseTarget"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="PulseTarget"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0.4" To="1.0" Duration="0:0:0.8"
                                             AutoReverse="True" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </StackPanel.Triggers>
            <controls:IconView Geometry="{StaticResource Geo_ImageBadge}"
                               Stroke="{DynamicResource TextSecondaryBrush}"
                               Width="32" Height="32"
                               HorizontalAlignment="Center" />
            <TextBlock Text="{loc:T gen.image.working}"
                       FontSize="14" Margin="0,12,0,2"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{loc:T gen.mayTakeAWhile}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>
    </Border>
</UserControl>
