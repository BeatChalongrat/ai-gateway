<UserControl x:Class="SranDesktop.Presentation.Controls.PlanCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:SranDesktop.Presentation.Converters"
             xmlns:controls="clr-namespace:SranDesktop.Presentation.Controls"
             xmlns:vm="clr-namespace:SranDesktop.Presentation.ViewModels"
             xmlns:loc="clr-namespace:SranDesktop.Presentation.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PlanBlockViewModel}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Border MaxWidth="520" HorizontalAlignment="Left"
            Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="12"
            Padding="16,12" Margin="0,6">
        <Grid>
            <!-- ══ Plan view (before execution) ══ -->
            <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <StackPanel Orientation="Horizontal">
                    <controls:IconView Geometry="{StaticResource Geo_FileText}"
                                       Stroke="{DynamicResource AccentBrush}"
                                       Width="16" Height="16" Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>

                <TextBlock Text="{Binding Description}"
                           FontStyle="Italic" FontSize="12.5" Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Text="{Binding ActionsHeader}"
                           FontSize="12" FontWeight="Medium" Margin="0,10,0,4"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <ItemsControl ItemsSource="{Binding Actions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,1">
                                <TextBlock Text="•" FontSize="12" Margin="0,0,6,0"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding}" FontSize="12"
                                           TextWrapping="Wrap" MaxWidth="440"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- error line -->
                <TextBlock Text="{Binding ErrorMessage}"
                           FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource AccentRedBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Execute button / progress -->
                <Grid Margin="0,12,0,0">
                    <Button Style="{DynamicResource AccentButton}"
                            HorizontalAlignment="Center" Padding="20,7"
                            Command="{Binding ExecuteCommand}"
                            Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <TextBlock Text="{loc:T plan.execute}" FontSize="13" FontWeight="Medium" />
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar Width="120" Height="4" IsIndeterminate="True"
                                     VerticalAlignment="Center" />
                        <TextBlock Text="{loc:T plan.executing}" FontSize="12.5" Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ══ Result view (after execution) ══ -->
            <StackPanel DataContext="{Binding Result}"
                        Visibility="{Binding DataContext.HasResult,
                                     RelativeSource={RelativeSource AncestorType=UserControl},
                                     Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <controls:IconView Geometry="{StaticResource Geo_Check}"
                                       Stroke="{DynamicResource AccentGreenBrush}"
                                       Width="16" Height="16" Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Filename}" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               MaxWidth="420"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding MetaLine}" FontSize="12" Margin="24,2,0,0"
                           Foreground="{DynamicResource TextTertiaryBrush}" />

                <TextBlock Text="{loc:T plan.result.changes}"
                           FontSize="12" FontWeight="Medium" Margin="0,10,0,4"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Changes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,1">
                                <controls:IconView Geometry="{StaticResource Geo_Check}"
                                                   Stroke="{DynamicResource AccentGreenBrush}"
                                                   Width="12" Height="12" Margin="0,2,6,0"
                                                   VerticalAlignment="Top" />
                                <TextBlock Text="{Binding}" FontSize="12"
                                           TextWrapping="Wrap" MaxWidth="440"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,12,0,0">
                    <Button Style="{DynamicResource AccentButton}"
                            HorizontalAlignment="Center" Padding="20,7"
                            Command="{Binding DownloadCommand}"
                            Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <TextBlock Text="{loc:T plan.result.download}" FontSize="13" FontWeight="Medium" />
                    </Button>
                    <ProgressBar Width="120" Height="4" IsIndeterminate="True"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
