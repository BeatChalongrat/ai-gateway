{
  "Sran": {
    "ChatEdgeBaseUrl": "http://localhost:4000",
    "GatewayBaseUrl": "http://localhost:8080",
    "DefaultModel": "gpt-4o-mini",
    "UpdateManifestUrl": "https://releases.sran.ai/desktop/latest.json",
    "McpCatalogUrl": "http://localhost:3200/catalog.json",
    "CrashReportUrl": "https://sran.ai/api/crash-reports"
  },
  "ComputerUse": {
    "Actions": {
      "MaxCaptureAge": "00:00:05",
      "MaximumGeometryDifference": 2,
      "ForegroundWindowRequirement": true,
      "RequireTargetWindowIdentity": true,
      "MaximumRetriesPerAction": 4,
      "SafeClickEdgeMargin": 3
    },
    "TargetResolver": {
      "MinimumVisionConfidence": 0.85,
      "MaximumElementAge": "00:00:03",
      "AllowRawPixelFallback": false,
      "MinimumLowRiskScore": 0.62,
      "MinimumMediumRiskScore": 0.75,
      "MinimumHighRiskScore": 0.88,
      "MinimumScoreGap": 0.08,
      "FusionIouThreshold": 0.55
    },
    "ScreenSecurity": {
      "DenyUnknownExternalClassification": true,
      "DeniedProcessNames": [
        "CredentialUIBroker",
        "KeePass",
        "KeePassXC",
        "1Password",
        "Bitwarden",
        "CredentialUI"
      ],
      "DeniedWindowTitleFragments": [
        "Windows Security",
        "Credential Manager",
        "Enter your credentials",
        "Security key"
      ],
      "RedactionRules": []
    }
  },
  "RuntimeStabilization": {
    "SemanticOutcomeEnforcement": true,
    "TargetBoundInput": true,
    "RuntimeOwnedCapabilityRouting": true,
    "ApplicationReadiness": true,
    "AuthoritativePlanUI": true,
    "VerifiedRecovery": true,
    "RealRuntimeMetrics": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
