<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>SranDesktop.App</RootNamespace>
    <AssemblyName>SranDesktop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.2.7</Version>
    <FileVersion>1.2.7.0</FileVersion>
    <AssemblyVersion>1.2.7.0</AssemblyVersion>
    <Product>SRAN Desktop</Product>
    <Company>SRAN</Company>
    <Description>AI Desktop Assistant with MCP Agent capabilities</Description>
    <Copyright>© 2026 SRAN</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.*" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.*" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.*" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SranDesktop.Presentation\SranDesktop.Presentation.csproj" />
    <ProjectReference Include="..\SranDesktop.Infrastructure\SranDesktop.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Unpacked Chrome extension ships beside the app: Settings → Browser shows
       this folder for chrome://extensions load-unpacked. -->
  <ItemGroup>
    <None Include="..\..\browser-extension\**"
          Link="browser-extension\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Offline WebView2 libs (KaTeX for display math, React/mermaid/babel for
       canvas) must land beside the exe as LOOSE FILES: the app finds them via
       Path.Combine(AppContext.BaseDirectory, "Assets", "WebLibs") and maps the
       folder into WebView2. A single-file publish bundles Content items INTO
       the exe, where Directory.Exists cannot see them — so the build output
       had all five libs while the publish output had none, and the installer
       (which copies from publish) shipped a folder that silently disappeared.
       Copying explicitly after Publish is the same idiom PublishBrowserHost
       already uses, and it is immune to single-file bundling semantics. -->
  <Target Name="PublishWebLibs" AfterTargets="Publish">
    <ItemGroup>
      <WebLibFile Include="..\SranDesktop.Presentation\Assets\WebLibs\**\*" />
    </ItemGroup>
    <Error Condition="'@(WebLibFile)' == ''"
           Text="No files under SranDesktop.Presentation\Assets\WebLibs — display math and canvas would ship broken." />
    <Copy SourceFiles="@(WebLibFile)"
          DestinationFiles="@(WebLibFile->'$(PublishDir)Assets\WebLibs\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishBrowserHost" AfterTargets="Publish">
    <PropertyGroup>
      <BrowserHostPublishDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\publish\win-x64\'))</BrowserHostPublishDir>
    </PropertyGroup>
    <MSBuild Projects="..\SranDesktop.BrowserHost\SranDesktop.BrowserHost.csproj"
             Targets="Restore;Publish"
             RemoveProperties="PublishProfile"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;PublishDir=$(BrowserHostPublishDir)" />
  </Target>

  <!-- Icon as a WPF resource so pack:// URIs (window + tray) can load it -->
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
