<Application x:Class="SranDesktop.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SranDesktop.Presentation;component/Resources/Themes/Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/SranDesktop.Presentation;component/Resources/Styles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/SranDesktop.Presentation;component/Resources/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
