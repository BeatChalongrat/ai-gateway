<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SranDesktop.DocumentWorker</RootNamespace>
    <AssemblyName>SranDesktop.DocumentWorker</AssemblyName>
    <!-- Runs inside a capability-free AppContainer with no host environment.
         It must not pull in WPF, the desktop app, or anything that expects
         credentials, so it deliberately references NO SRAN assembly. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Source-linked, not referenced: the PPTX package backbone and shape tree
       are plain OpenXML helpers, and linking them keeps a deck built out of
       process identical to one built in-app without dragging in the WPF graph. -->
  <ItemGroup>
    <!-- Source-linked, not referenced: the worker must not drag the WPF and
         credential graph into a sandboxed process. The capability matrix has to
         be the SAME data on both sides, or the host would refuse operations the
         worker supports, or worse, the reverse. -->
    <Compile Include="..\SranDesktop.Application\Models\DocumentCapabilityMatrix.cs"
             Link="DocumentCapabilityMatrix.cs" />
    <Compile Include="..\SranDesktop.Infrastructure\Office\PptxBackbone.cs"
             Link="PptxBackbone.cs" />
    <Compile Include="..\SranDesktop.Infrastructure\Office\PptxShapeTreeBuilder.cs"
             Link="PptxShapeTreeBuilder.cs" />
    <Compile Include="..\SranDesktop.Infrastructure\Office\PlanJson.cs" Link="PlanJson.cs" />
    <Compile Include="..\SranDesktop.Infrastructure\Office\LocalDocPlanExecutor.cs" Link="LocalDocPlanExecutor.cs" />
    <Compile Include="..\SranDesktop.Infrastructure\Office\LocalExcelPlanExecutor.cs" Link="LocalExcelPlanExecutor.cs" />
    <Compile Include="..\SranDesktop.Infrastructure\Office\LocalPptxPlanExecutor.cs" Link="LocalPptxPlanExecutor.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.*" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.*" />
  </ItemGroup>

</Project>
