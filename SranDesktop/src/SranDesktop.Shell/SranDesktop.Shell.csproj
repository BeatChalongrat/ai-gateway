<Project Sdk="Microsoft.NET.Sdk">

  <!-- SranDesktop.Shell — the WebView2 host for apps/web-chat (docs/DESKTOP_SHELL_PLAN.md).
       Phase 1: a window that loads the page, refuses to go anywhere else, and hosts the
       existing services. No chat, no bridge.

       It is a WPF Application on purpose: SranDesktop.Infrastructure already carries
       UseWPF=true, and ReadClipboardTool / WriteClipboardTool need a live
       System.Windows.Application.Current (SHELL_PHASE0_SIZING_REPORT.md Q2). -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>SranDesktop.Shell</RootNamespace>
    <AssemblyName>SranDesktop.Shell</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Same file the WPF app ships; referenced in place so the two cannot drift. -->
    <ApplicationIcon>..\SranDesktop.App\Assets\app.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>SRAN Desktop Shell</Product>
    <Company>SRAN</Company>
  </PropertyGroup>

  <!-- The WindowsDesktop SDK (UseWPF) drops these from implicit usings -->
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <!-- The host-query dispatcher's RouteAsync is internal so its refusal rules can
       be unit-tested (Phase 5 criterion 4) without a live WebView2. This is an
       assembly attribute, not a <Reference> — the Presentation-reference pinning
       test is unaffected. -->
  <ItemGroup>
    <InternalsVisibleTo Include="SranDesktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.*" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.*" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.*" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.1.4" />
    <!-- Pinned EXACTLY (audit U-9): the spike verified every API this design uses
         against 1.0.4129.50. Bump deliberately, never by float. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="[1.0.4129.50]" />
  </ItemGroup>

  <!-- Abandonment rule 2 (DESKTOP_SHELL_PLAN.md §8): Infrastructure + Application + Domain
       ONLY. A build that needs SranDesktop.Presentation is a design failure.
       Pinned by ShellPinningTests. -->
  <ItemGroup>
    <ProjectReference Include="..\SranDesktop.Infrastructure\SranDesktop.Infrastructure.csproj" />
    <ProjectReference Include="..\SranDesktop.Infrastructure.Windows\SranDesktop.Infrastructure.Windows.csproj" />
    <ProjectReference Include="..\SranDesktop.Infrastructure.Windows.Desktop\SranDesktop.Infrastructure.Windows.Desktop.csproj" />
    <ProjectReference Include="..\SranDesktop.Application\SranDesktop.Application.csproj" />
    <ProjectReference Include="..\SranDesktop.Domain\SranDesktop.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Same icon as the WPF app, linked (not copied) so they cannot drift. -->
  <ItemGroup>
    <Resource Include="..\SranDesktop.App\Assets\app.ico" Link="Assets\app.ico" />
  </ItemGroup>

</Project>
