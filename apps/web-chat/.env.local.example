# Public API base used by the browser (chat-edge). Server-side (RSC)
# reads it too.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Gateway (FastAPI) origin — the identity authority. Chat calls it
# directly (cross-origin, with credentials) for silent refresh and the
# /portal/me session lookup. Must be in the gateway's CORS_ORIGINS.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# SRAN Portal — used to redirect unauthenticated users to login/signup.
# HttpOnly cookie migration: the session rides the portal_access_token /
# portal_refresh_token HttpOnly cookies. On localhost these are host-only
# and shared across ports (3001/3002/4000/8080); in production set
# AUTH_COOKIE_DOMAIN on the gateway to a shared parent domain so the
# cookie reaches chat. No more ?token= in the URL.
NEXT_PUBLIC_PORTAL_URL=http://localhost:3001
