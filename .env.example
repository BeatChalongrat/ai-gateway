# ============================================================
# SRAN AI Gateway — Environment Configuration
#
# First-run:
#   cp .env.example .env    # or copy/paste on Windows
#   make up                  # or .\scripts\dev.ps1 up
#   make seed                # once, creates admin + portal users
#
# Every var here has a safe dev default in docker-compose.yml; override
# only the ones you actually need (real provider keys, OAuth secrets).
# ============================================================

# --- Application ---
APP_ENV=development
APP_NAME=secure-ai-gateway
APP_PORT=8080
LOG_LEVEL=INFO
# Startup schema-drift guard. Empty = auto by APP_ENV (development →
# autoupgrade, else → failclosed). autoupgrade: run 'alembic upgrade head'
# in-process on boot (advisory-locked) — best for dev hot-reload. failclosed:
# refuse to start with a named error if the DB is behind the code head (prod;
# migrate before boot). warn: log loudly + proceed. off: disable the guard.
# SCHEMA_DRIFT_MODE=
# Must list every browser origin (allow_credentials=True forbids "*").
# :3002 = web-chat, which calls the gateway directly for silent refresh.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# --- Portal auth cookies (HttpOnly cookie migration) ---
# Empty domain = host-only (localhost shares across ports). In prod set a
# shared parent (".yourdomain.com"). SECURE auto-on outside dev; SAMESITE
# lax unless chat/api are a different registrable domain. SAMESITE=none
# requires DOMAIN + Secure — startup validation blocks a misconfigured
# production deploy. See backend/.env.example for the full notes.
# AUTH_COOKIE_DOMAIN=
# AUTH_COOKIE_SECURE=
# AUTH_COOKIE_SAMESITE=lax

# --- Database (PostgreSQL 16 — docker compose runs it on 5432) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_gateway
POSTGRES_USER=postgres
# Dev default kept as "postgres" so `make up` works on a clean checkout.
# PRODUCTION: rotate with `openssl rand -base64 32` before `make prod`.
POSTGRES_PASSWORD=postgres
# DATABASE_URL_OVERRIDE=postgresql+psycopg://postgres:postgres@postgres:5432/ai_gateway

# --- Redis (compose runs it on 6379) ---
REDIS_HOST=localhost
REDIS_PORT=6379
# REQUIRED for the base docker-compose stack: redis now runs
# --requirepass ${REDIS_PASSWORD} (no longer unauthenticated), so
# `make up` / `docker compose up` fails until this is set. Generate one
# with `openssl rand -base64 32`. The same value is folded into the
# backend connector (config.py) and the rate-limiter / redis-exporter.
REDIS_PASSWORD=changeme-generate-with-openssl-rand-base64-32

# --- Security (change for any non-dev use) ---
JWT_SECRET=dev-stable-key-change-in-prod
MASTER_ENCRYPTION_KEY=dev-stable-key-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Admin session signing (Phase 2A HttpOnly cookies) ---
# Comma-separated rotation list. Leftmost entry signs new cookies; the
# rest stay valid for verification so rotation is zero-downtime. Any
# value containing "change-me" is rejected outside dev by
# validate_secrets(). Generate each entry with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Rotation procedure: see RUNBOOK.md "Session signing key rotation".
SESSION_SIGNING_SECRETS=change-me-session-signing

# --- Portal JWT (separate from admin JWT) ---
PORTAL_JWT_SECRET=dev-stable-portal-key-change-in-prod
PORTAL_ACCESS_TOKEN_EXPIRE_MINUTES=60
PORTAL_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Connector OAuth broker (SRAN Desktop Phase 7) ---
# Separate OAuth apps from portal login: these ask for DATA scopes
# (Gmail/Drive/Calendar, Slack bot, GitHub repo). Provider tokens are
# stored AES-encrypted server-side only — the desktop never sees them.
CONNECTOR_OAUTH_GOOGLE_CLIENT_ID=
CONNECTOR_OAUTH_GOOGLE_CLIENT_SECRET=
CONNECTOR_OAUTH_SLACK_CLIENT_ID=
CONNECTOR_OAUTH_SLACK_CLIENT_SECRET=
CONNECTOR_OAUTH_GITHUB_CLIENT_ID=
CONNECTOR_OAUTH_GITHUB_CLIENT_SECRET=

# --- Initial admin (consumed by `make seed`) ---
# Dev default is admin/admin1234. PRODUCTION: INITIAL_ADMIN_PASSWORD is
# REQUIRED — the seed script raises if APP_ENV != 'development' and this
# is unset. Generate with `openssl rand -base64 24`.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@audit.test
INITIAL_ADMIN_PASSWORD=

# --- AI Provider API Keys ---
# These SEED the database on a provider's FIRST boot, and are ignored ever
# after. Set them here before you bring the stack up and it comes up
# configured; change them afterwards in the admin console under /providers,
# which needs no restart.
#
#   EDITING ONE OF THESE ON A RUNNING SYSTEM DOES NOTHING. That is deliberate
#   — the database is the single source of truth once a provider has a key,
#   and a key you delete in the UI stays deleted across restarts.
#
# A placeholder (sk-ant-..., changeme, anything under 20 chars) is never
# seeded; the boot log says so, and filling in the real value and restarting
# still works. Every boot logs one line per provider:
#   [startup] provider key openai: seeded | owned-by-database | env-placeholder
#
# A provider with no key returns 503 "No API key configured for provider
# '<name>'". OPENAI_API_KEY additionally backs embeddings (RAG / KB search)
# and voice (Whisper STT, TTS) — those now resolve through the same pool, so
# rotating the key in the UI moves them too.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- Provider Timeouts & Retry ---
PROVIDER_TIMEOUT_CONNECT=5.0
PROVIDER_TIMEOUT_READ=30.0
PROVIDER_MAX_RETRIES=2

# --- Provider base-URL seed ---
# Same rule as the keys above: seeds each provider's endpoint on its FIRST
# boot, ignored ever after. Change endpoints in the admin console under
# /providers. Clearing this variable does NOT revert an endpoint already in
# the database — delete the system_settings row instead.
# Default empty = adapters hit real provider URLs. Uncomment to route
# all three major providers through the in-cluster mock:
# PROVIDER_BASE_URL_OVERRIDES={"openai":"http://mock-provider:9090/v1","anthropic":"http://mock-provider:9090","openrouter":"http://mock-provider:9090/v1"}

# --- Provider resilience (Batch A) ---
# Per-provider concurrency bulkhead: JSON map provider -> max concurrent
# in-flight upstream calls. Empty (default) = no caps, cloud behavior
# unchanged. Meant for small self-hosted boxes.
# IMPORTANT SIZING FORMULA: the semaphore is per gunicorn worker, so a
# provider's real ceiling = cap x GUNICORN_WORKERS (x pods if scaled).
# A box that tolerates 16 concurrent behind 4 workers wants cap=4.
# A global cross-worker cap is deferred to the Rust rate-limiter (see
# docs/DEFERRED_WORK.md).
# PROVIDER_CONCURRENCY_CAPS={"sranai": 4}
# Seconds a request may wait for a free slot before shedding with
# 503 + Retry-After (non-stream) / fallback (streaming). Keep short.
# PROVIDER_CONCURRENCY_ACQUIRE_TIMEOUT_SECONDS=1.0

# Outbound httpx pool per provider base_url. Defaults = the previous
# hardcoded values (50 / 20 / 30s). Per-provider max_connections
# override via JSON map — a capped box doesn't need 50 warm sockets
# (roughly match the concurrency cap). Limits are captured when a
# base_url's pool is first built; changing them needs a restart.
# PROVIDER_POOL_MAX_CONNECTIONS=50
# PROVIDER_POOL_MAX_KEEPALIVE_CONNECTIONS=20
# PROVIDER_POOL_KEEPALIVE_EXPIRY_SECONDS=30.0
# PROVIDER_POOL_OVERRIDES={"sranai": 8}

# Backend worker count — single knob read by backend/Dockerfile,
# scripts/start.sh, and the loadtest compose (they used to disagree:
# 4/8/-). Remember: per-provider caps scale with this number.
# GUNICORN_WORKERS=4
# FIX131 — a stopping backend lets in-flight turns finish for up to this
# many seconds (compose stop_grace_period is set above it).
# GUNICORN_GRACEFUL_TIMEOUT=180

# FIX131 — a stopping chat-edge refuses new turns (503 SERVER_DRAINING, the
# page retries) and lets the ones in flight finish for up to DRAIN_TIMEOUT;
# what is left ends as "interrupted". A turn still marked streaming with no
# live owner is settled as interrupted by a sweep.
# CHAT_EDGE_DRAIN_TIMEOUT=60s
# CHAT_EDGE_DRAIN_GRACE=10s
# INTERRUPTED_TURN_SWEEP_INTERVAL=60s
# INTERRUPTED_TURN_MIN_AGE=2m

# chat-edge -> gateway whole-request deadline. Default 0 = unbounded,
# REQUIRED for long SSE generations (the old hardcoded 5m severed
# them). Dial/TLS/header waits stay bounded by the client transport.
# Set a duration (e.g. "90s") only for deployments that never stream.
# GATEWAY_CLIENT_TIMEOUT=0

# --- Long-conversation compaction (chat-edge, FIX33) — ON by default ---
# Auto-compact fires when the loaded history reaches TRIGGER × the model's
# messages budget (Claude compacts at a threshold, not on overflow), then
# refreshes <conversation_state> and trims the MIDDLE of the history down to
# TARGET × budget (the first exchange and the newest tail survive). The gap
# between the two is hysteresis; 1.0/1.0 restores "only when it overflows".
# Prod runs the defaults — leave unset unless you are tuning.
# CONTEXT_COMPACT_TRIGGER_RATIO=0.85
# CONTEXT_COMPACT_TARGET_RATIO=0.60

# --- Temporary chat / memory off ---
# FIX130: TEMPORARY_CHAT_READS_MEMORY is retired. A chat with memory
# switched off, and every temporary chat, neither reads nor writes memory;
# there is no setting to make them read it. chat-edge ignores an old value
# (and logs that it did); web-chat's NEXT_PUBLIC_TEMPORARY_CHAT_READS_MEMORY
# and the desktop's temporaryChatReadsMemory are gone the same way.

# --- Code-interpreter sandbox runtime (docs/DEPLOY_SANDBOX.md) ---
# DEV MODE (this file): leave unset. Per-run sandbox containers use the
# daemon's default runtime (runc) with the standard container boundary —
# no network, non-root, capabilities dropped, seccomp, read-only rootfs.
# PROD MODE: SANDBOX_RUNTIME=runsc (docker-compose.prod.yml defaults to it)
# runs them under gVisor, after `sudo bash scripts/install-runsc.sh` on the
# Docker host. Setting runsc WITHOUT the runtime installed makes chat-edge
# refuse to start — deliberately (FIX14 no-silent-fall-back). Check which
# mode is live: bash scripts/verify-sandbox-runtime.sh
# SANDBOX_RUNTIME=

# --- DLP ---
DLP_ENABLED=true
DLP_DEFAULT_PROFILE=default
DLP_DISABLED_DETECTORS=
DLP_SCAN_RESPONSES=true

# --- Admin REST key (server-side only; NOT bundled into the browser) ---
# Used by dev/test tooling under scripts/ for legacy admin REST calls.
# Real admin auth is cookie-session based at /auth/session/login. This is
# a server-side var only — it must NEVER carry a NEXT_PUBLIC_ prefix
# (CI's secret-leak-guard rejects that).
ADMIN_API_KEY=

# --- Provider key encryption (AES-256-GCM) ---
# 64 hex chars = 32 bytes. Generate:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Required in production; empty in dev/test uses a deterministic dev key.
PROVIDER_KEY_MASTER_KEY=

# --- Observability (Grafana) ---
# Grafana admin password (UI at http://localhost:3100, user "admin").
GRAFANA_ADMIN_PASSWORD=admin

# --- Portal UI + NextAuth ---
NEXT_PUBLIC_OAUTH_ENABLED=false
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=dev-portal-nextauth-secret

# Google OAuth (leave blank to hide the Google button on the portal)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (leave blank to hide the GitHub button on the portal)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Gateway API key for the local E2E driver scripts (scripts/*_e2e.py,
# test_dlp_e2e_*.py). These read GW_API_KEY from the environment and
# fail fast if it is unset — never hardcode a gw_ key in a tracked file.
# Mint one via the portal (POST /portal/projects/{id}/keys).
GW_API_KEY=

# ═══════════════════════════════════════════════════════════════════
# Google SSO (Phase 0-3) — sign-in identity. SEPARATE app from the
# CONNECTOR_OAUTH_* data-scope clients above.
# ═══════════════════════════════════════════════════════════════════
# Comma-separated sign-in domain allowlist. Empty = allow every domain
# (e.g. to open up to gmail later). Enforced SERVER-SIDE in
# oauth_service.login_or_create + auth_service.signup.
ALLOWED_EMAIL_DOMAINS=gbtech.co.th
# Google account-chooser `hd` hint (UX only, never enforcement).
GOOGLE_HOSTED_DOMAIN=gbtech.co.th
# Phase 3 cutover: false = login/signup/password-reset answer 403 and
# every login UI hides the password form (via /portal/auth/public-
# settings). Code stays; flip back to true to re-enable passwords.
PASSWORD_LOGIN_ENABLED=false

# ─── PRODUCTION go-live checklist (B-track; no real values here) ────
# 1. Google Cloud Console (SAME client id feeds portal + backend):
#    - consent screen: INTERNAL (Workspace only). Switch to External
#      only when/if gmail sign-in is opened up.
#    - Authorized redirect URIs — ADD the prod ones alongside dev:
#        https://<portal-host>/api/auth/callback/google      (NextAuth)
#        https://<gateway-host>/portal/auth/oauth/callback   (desktop PKCE)
#    - Authorized JS origin: https://<portal-host>
#    - ROTATE GOOGLE_CLIENT_SECRET before prod (the dev secret has been
#      shared in chat/tooling) and update GOOGLE_CLIENT_SECRET here.
# 2. NEXTAUTH_URL=https://<portal-host>   NEXTAUTH_SECRET=<openssl rand -base64 32>
#    (the dev-portal-nextauth-secret default REFUSES to boot prod).
# 3. AUTH_COOKIE_DOMAIN=.<parent-domain>  — lets the HttpOnly portal
#    cookies ride portal/webchat/gateway subdomains. Leave empty for
#    host-only (dev). docker-compose.prod.yml also sets Secure=true.
# 4. CORS: CORS_ORIGINS=<prod portal+webchat origins> (gateway) and
#    CORS_ALLOW_ORIGINS (chat-edge, docker-compose.webchat.yml) — both
#    are env-driven, nothing is hardcoded.
# 5. Secrets that must be REAL before prod boot (validate_secrets
#    fail-closes on the dev defaults): SESSION_SIGNING_SECRETS,
#    NEXTAUTH_SECRET, REDIS_PASSWORD, INITIAL_ADMIN_PASSWORD,
#    JWT_SECRET, PORTAL_JWT_SECRET, MASTER_ENCRYPTION_KEY,
#    SERVICE_JWT_SECRET, DLP_AUDIT_KEY, PROVIDER_KEY_MASTER_KEY.
#    RESEND_API_KEY is REQUIRED IN PRODUCTION TOO — validate_secrets()
#    checks it unconditionally, so an empty value blocks backend startup
#    ("STARTUP BLOCKED") even while PASSWORD_LOGIN_ENABLED=false and no
#    reset/verification mail would ever be sent. Set a real key.
#    Full walkthrough: docs/SSO-GO-LIVE.md

# ─── Alerts (FIX129 A4; docs/ops/monitoring.md) ─────────────────────
# ntfy topic URL = a secret (anyone who knows the topic reads the alerts):
# a long random topic, or a reserved topic + ALERT_NTFY_TOKEN (FIX130).
ALERT_NTFY_URL=
ALERT_NTFY_TOKEN=
ALERT_EMAIL_TO=
ALERT_WEBHOOK_URL=
# FIX131 — test alerts. ALERT_ENVIRONMENT=test (test stack, lanes) puts
# "[TEST]" on every alert and sends it ONLY to ALERT_TEST_NTFY_URL — never to
# the channels above. Leave ALERT_ENVIRONMENT empty on the live system;
# ALERT_TEST_NTFY_URL is a separate throwaway topic for test fires
# (`python -m app.ops.fire_test_alert`, `backup notify …`).
ALERT_ENVIRONMENT=
ALERT_TEST_NTFY_URL=
# FIX131 — ops-watch pages "no fresh backup" when nothing proven is newer
# than this many hours, and "replies stuck" for rows streaming longer than
# this many minutes.
# BACKUP_MAX_AGE_H=26
# OPS_WATCH_TURN_STUCK_MIN=15

# ─── Off-site backup copy (FIX130; docs/ops/backups.md "Off-site copy") ──
# restic -> an S3-compatible bucket. Empty repository = off (local only).
# Keep BACKUP_OFFSITE_PASSWORD in a password manager OFF this machine too:
# without it the off-site copy cannot be read.
BACKUP_OFFSITE_REPOSITORY=
BACKUP_OFFSITE_PASSWORD=
BACKUP_OFFSITE_ACCESS_KEY_ID=
BACKUP_OFFSITE_SECRET_ACCESS_KEY=
BACKUP_OFFSITE_REGION=

# ─── Knowledge base (FIX132 B; docs/ops/knowledge-base.md) ──────────────
# The models run in kb-models on this machine (bge-m3 embeddings + sparse
# keyword weights, optional bge-reranker-v2-m3, PyThaiNLP); chat-edge calls it
# directly. KB_MODELS_URL must name a compose service, loopback, an RFC 1918
# address or host.docker.internal — anything else is refused, so document
# and question text never leaves the host. Everything below is optional;
# the commented values are the defaults (measured on the FIX132 eval set).
# KB_MODELS_URL=http://kb-models:8090
# kb-models: bf16 is ~2x faster than fp32 on this CPU (AVX512-BF16).
# KB_DTYPE=bf16
# KB_THREADS=6
# 1 = never reach Hugging Face (the kb_models volume already holds the
# pinned weights). Set 0 once to download into an EMPTY volume.
# KB_MODELS_OFFLINE=1
# Indexing: background goroutines in chat-edge; chunk size/overlap in
# characters for new knowledge bases (and old ones still on 512/50).
# KB_INDEX_WORKERS=2
# KB_CHUNK_SIZE=1000
# KB_CHUNK_OVERLAP=150
# Retrieval: score = cosine + KB_SPARSE_WEIGHT × bge-m3 lexical score over the
# top KB_CANDIDATES of each arm; a passage is kept at score ≥ KB_MIN_SCORE, up
# to KB_TOP_K, and the block is capped at KB_CONTEXT_MAX_CHARS characters (and
# a quarter of the model's context window).
# KB_SPARSE_WEIGHT=0.3
# KB_CANDIDATES=50
# KB_MIN_SCORE=0.40
# KB_TOP_K=20
# KB_CONTEXT_MAX_CHARS=24000
# Reranker: off (30–40 passages cost 20–60 s per question on this CPU). When
# on, kb-models also loads bge-reranker-v2-m3 (~+2.3 GB RAM) and a question's
# rerank stops at KB_RERANK_BUDGET_MS (then the fused order is used).
# KB_RERANK_ENABLED=false
# KB_RERANK_CANDIDATES=40
# KB_RERANK_BUDGET_MS=4000
# KB_RERANK_FLOOR=0.01
