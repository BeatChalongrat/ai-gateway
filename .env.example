# ============================================================
# SRAN AI Gateway — Environment Configuration
#
# First-run:
#   cp .env.example .env    # or copy/paste on Windows
#   make up                  # or .\scripts\dev.ps1 up
#   make seed                # once, creates admin + portal users
#
# Every var here has a safe dev default in docker-compose.yml; override
# only the ones you actually need (real provider keys, OAuth secrets).
# ============================================================

# --- Application ---
APP_ENV=development
APP_NAME=secure-ai-gateway
APP_PORT=8080
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Database (PostgreSQL 16 — docker compose runs it on 5432) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_gateway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# DATABASE_URL_OVERRIDE=postgresql+psycopg://postgres:postgres@postgres:5432/ai_gateway

# --- Redis (compose runs it on 6379) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Security (change for any non-dev use) ---
JWT_SECRET=dev-stable-key-change-in-prod
MASTER_ENCRYPTION_KEY=dev-stable-key-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Portal JWT (separate from admin JWT) ---
PORTAL_JWT_SECRET=dev-stable-portal-key-change-in-prod
PORTAL_ACCESS_TOKEN_EXPIRE_MINUTES=60
PORTAL_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI Provider API Keys (leave blank to route through the mock) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- Provider Timeouts & Retry ---
PROVIDER_TIMEOUT_CONNECT=5.0
PROVIDER_TIMEOUT_READ=30.0
PROVIDER_MAX_RETRIES=2

# --- Provider base-URL overrides ---
# The compose file hard-codes this to the mock-provider service for
# dev. Unset / override in .env to talk to real providers.
# PROVIDER_BASE_URL_OVERRIDES={"openai":"https://api.openai.com/v1"}

# --- DLP ---
DLP_ENABLED=true
DLP_DEFAULT_PROFILE=default
DLP_DISABLED_DETECTORS=
DLP_SCAN_RESPONSES=true

# --- Admin UI (compiled into the browser bundle at build time) ---
# The admin API key is bundled into the client; rotate it by
# rebuilding the admin-ui image. Real admin auth lives at
# /auth/session/login — the key is only used for legacy admin REST
# calls until those move to cookie-based routes.
NEXT_PUBLIC_ADMIN_API_KEY=

# --- Portal UI + NextAuth ---
NEXT_PUBLIC_OAUTH_ENABLED=false
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=dev-portal-nextauth-secret

# Google OAuth (leave blank to hide the Google button on the portal)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (leave blank to hide the GitHub button on the portal)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
