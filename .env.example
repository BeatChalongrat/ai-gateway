# ============================================================
# SRAN AI Gateway — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- Application ---
APP_ENV=development
APP_NAME=secure-ai-gateway
APP_PORT=8080
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database (PostgreSQL 14+) ---
# Option A: individual fields (used by default)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_gateway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Option B: full URL override (takes precedence when set, used in Docker)
# DATABASE_URL_OVERRIDE=postgresql+psycopg://postgres:postgres@postgres:5432/ai_gateway

# --- Redis (for rate limiting) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Security ---
# IMPORTANT: Change these in production. App refuses to start with
# defaults when APP_ENV != development|test.
# Must be STABLE across restarts — do NOT use random/generated values here.
JWT_SECRET=dev-stable-key-change-in-prod
MASTER_ENCRYPTION_KEY=dev-stable-key-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Portal JWT (used by /portal/* endpoints; keep separate from admin) ---
PORTAL_JWT_SECRET=dev-stable-portal-key-change-in-prod
PORTAL_ACCESS_TOKEN_EXPIRE_MINUTES=60
PORTAL_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI Provider API Keys (at least one required for live requests) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...

# --- Provider Timeouts & Retry ---
PROVIDER_TIMEOUT_CONNECT=5.0
PROVIDER_TIMEOUT_READ=30.0
PROVIDER_MAX_RETRIES=2

# --- DLP (Data Loss Prevention) ---
DLP_ENABLED=true
DLP_DEFAULT_PROFILE=default
DLP_DISABLED_DETECTORS=
DLP_SCAN_RESPONSES=true
