# chat-edge-api environment example.
#
# Copy to .env and edit. Required values: any field without a default
# in internal/config/config.go. The service refuses to start with
# missing required vars.

# HTTP listener
PORT=4000

# PostgreSQL (host port 5433 when using docker-compose.webchat.yml)
DATABASE_URL=postgres://chatedge:chatedge_pass@localhost:5433/sran_ai?sslmode=disable

# Redis (host port 6380; DB 1 reserved for chat-edge state)
REDIS_URL=redis://localhost:6380/1

# Upstream Gateway API
GATEWAY_API_URL=http://localhost:8000/api/v1

# JWT secrets — change in production!
USER_JWT_SECRET=dev-user-jwt-secret-change-in-prod
SERVICE_JWT_SECRET=dev-service-jwt-secret-change-in-prod
CSRF_SECRET=dev-csrf-secret-change-in-prod

# Token expiries
ACCESS_TOKEN_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=168h
SERVICE_JWT_TTL=60s

# Dev-mode logging (text instead of JSON). Unset/empty in production.
CHAT_EDGE_DEV=1

# Comma-separated browser origins allowed by CORS.
CORS_ALLOW_ORIGINS=http://localhost:3002
