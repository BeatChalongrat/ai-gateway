# SRAN Chat Edge API — environment template.
#
# Copy to .env and fill in the secrets. The compose stack reads it
# automatically; standalone ``go run`` also picks it up via direnv /
# similar tooling.
#
# All variables are documented in README.md and parsed by
# internal/config/config.go. The service refuses to start with
# missing required vars.

# ── Required ──────────────────────────────────────────────────
DATABASE_URL=postgres://chatedge:chatedge_pass@localhost:5433/sran_ai?sslmode=disable
REDIS_URL=redis://localhost:6380/1
# The gateway's plain loopback door: :8080 is Caddy's https port since FIX133
# (docs/ops/tls.md; in compose the service name is used instead).
GATEWAY_API_URL=http://127.0.0.1:28080/v1
USER_JWT_SECRET=dev-user-jwt-secret-change-in-prod
SERVICE_JWT_SECRET=dev-service-jwt-secret-change-in-prod
CSRF_SECRET=dev-csrf-secret-change-in-prod
# Load-bearing user-auth secret. MUST be byte-identical to the gateway's
# (FastAPI) PORTAL_JWT_SECRET — chat-edge verifies the session JWT the
# gateway mints. Outside dev, config.Validate() refuses to boot on this
# "change-in-prod" default or any secret < 32 bytes (and demands
# COOKIE_SECURE=true). Generate: openssl rand -base64 48
PORTAL_JWT_SECRET=dev-stable-portal-key-change-in-prod

# ── HTTP / runtime ────────────────────────────────────────────
PORT=4000
CORS_ALLOW_ORIGINS=https://localhost:3002   # https since FIX133 (docs/ops/tls.md)
CHAT_EDGE_DEV=1
# Deployment environment. Anything other than development/dev/test/testing
# turns on config.Validate() (rejects dev-default secrets + non-Secure
# cookies). Set APP_ENV=production in prod.
APP_ENV=development

# ── Gateway client ────────────────────────────────────────────
GATEWAY_API_KEY=
SERVICE_JWT_TTL=60s
ACCESS_TOKEN_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=168h

# ── Admin observability ───────────────────────────────────────
# Required for /api/v1/admin/* — empty disables the routes.
CHAT_EDGE_ADMIN_API_KEY=

# ── File storage ──────────────────────────────────────────────
# Default: local filesystem. Flip to ``s3`` + set the S3 vars below
# to route uploads through any S3-compatible bucket (MinIO included).
STORAGE_BACKEND=local
FILE_STORAGE_ROOT=./data/uploads

# Optional isolated LibreOffice review; docker-compose.office.yml wires this.
# Empty: report rendering/recalculation unavailable, never claim full verification.
OFFICE_CONVERTER_URL=
# Optional vision-capable chat model for visual review. Empty disables AI review.
# Tenant media_pii_egress must allow raw page images; IMAGE_GEN_MODEL handles image repairs.
OFFICE_VISUAL_MODEL=
MAX_FILE_SIZE_BYTES=26214400        # 25 MiB
MAX_CONV_FILE_TOTAL_BYTES=104857600 # 100 MiB
MAX_FILES_PER_MESSAGE=5
EXTRACT_PYTHON_BINARY=python3

# ── S3 (only when STORAGE_BACKEND=s3) ─────────────────────────
S3_BUCKET=sran-chat-files
S3_REGION=us-east-1
S3_ENDPOINT=                         # http://minio:9000 for MinIO; empty for AWS
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false            # auto-true when S3_ENDPOINT is set
PRESIGNED_URL_EXPIRY=15m

# ── OpenAI (Whisper STT, TTS) ─────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1

# ── Knowledge base (FIX132 B; docs/ops/knowledge-base.md) ─────
# The models run in kb-models on this machine (no OpenAI). Defaults shown.
KB_MODELS_URL=http://kb-models:8090
KB_INDEX_WORKERS=2
KB_CHUNK_SIZE=1000
KB_CHUNK_OVERLAP=150
KB_SPARSE_WEIGHT=0.3
KB_CANDIDATES=50
KB_MIN_SCORE=0.40
KB_TOP_K=20
KB_CONTEXT_MAX_CHARS=24000
KB_RERANK_ENABLED=false
KB_RERANK_CANDIDATES=40
KB_RERANK_BUDGET_MS=4000
KB_RERANK_FLOOR=0.01

# ── Rate limiting (message send) ──────────────────────────────
RATE_LIMIT_MESSAGES=30
RATE_LIMIT_WINDOW=1m

# ── Context window ────────────────────────────────────────────
MAX_CONTEXT_MESSAGES=50

# ── Cookies ───────────────────────────────────────────────────
# MUST be true in production (HTTPS only).
COOKIE_SECURE=false
