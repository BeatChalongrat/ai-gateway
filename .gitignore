__pycache__/
*.pyc
.env
.env.*
!.env.example
# Example/template env files carry no secrets and MUST be tracked —
# without this negation portal/.env.local.example was silently ignored.
!*.env*.example
!.env.*.example
!scripts/uat/.env.uat.template
.venv/
venv/
node_modules/
.next/
dist/
build/
coverage/
.pytest_cache/
.claude/
.vscode/
.idea/
.DS_Store
*.log
logs/

# Scratch/debug scratchpads — never commit (once held a real admin JWT; see
# docs/SECURITY_17A_TOKEN_PURGE.md). Ignored everywhere in the tree.
.tmp_bugs/
**/.tmp_bugs/
tmp/
storage/
# Track the Go ``internal/storage/`` package — the generic
# ``storage/`` rule above was meant for data dirs (./data/storage,
# etc.), not Go source. Exception must come AFTER the broader rule.
!services/chat-edge-api/internal/storage/
!services/chat-edge-api/internal/storage/**
# Same fix for the desktop's C# Storage source — the ``storage/`` rule
# matched it case-insensitively on Windows, leaving these core files
# UNTRACKED (a fresh clone wouldn't build). Re-include the source dir.
!SranDesktop/src/SranDesktop.Infrastructure/Storage/
!SranDesktop/src/SranDesktop.Infrastructure/Storage/**
# ...and the matching TEST directory, for the same reason. This one bit later:
# four test sources sat there untracked and did not even appear in git status,
# so `git add -A` skipped them without a word. A rule meant for data directories
# must never be left to match source by accident.
!SranDesktop/src/SranDesktop.Tests/Storage/
!SranDesktop/src/SranDesktop.Tests/Storage/**
uploads/
*.sqlite3
admin-ui/tsconfig.tsbuildinfo
backend/uploads/

# Perf-baseline track (deferred) — source lives on branch
# archive/uncommitted-20260423 in perf/. Generated results and scratch
# directories are never tracked on main.
perf/
perf_audit_tmp/

# Local dev artifacts (DOM measurements, hero-tuning screenshots,
# debug request/response traces) — not project sources.
measure.js
hero-*.png
traces/

# Report & audit docs (root level)
*_REPORT.md
*_AUDIT_REPORT.md
*_VERIFICATION_REPORT.md
*_PLAN.md
*_LOG.md
BASELINE_STATUS.md
IMPLEMENTATION_ROADMAP.md
RUNBOOK.md
TASK_BOARD.md
POST_*.md
THREE_FIXES_REPORT.md
UX_CLEANUP_REPORT.md
RUNTIME_CONSOLIDATION_REPORT.md

# Shell test scripts
real-loop-test.sh
sran-pii-test.sh

# Rust sidecar build artifacts
dlp-sidecar/target/

# UAT seed output — contains raw API keys printed once by 02_seed_uat.py.
# Keep on disk only until copied into the customer's secret manager.
uat-seed-output.txt

# Secrets & local state (cross-cutting; defense in depth)
*.pem
*.key
credentials.dat
*.db
*.sqlite
*.sqlite-journal
Thumbs.db
.vs/

# SranDesktop's Inno Setup script lives in build/ — a required build
# input, not an output. Re-include it past the generic ``build/`` rule
# above (dir first, then contents — same pattern as internal/storage).
!SranDesktop/build/
!SranDesktop/build/**

# Local data and dev-server artifacts (dev-server*.log already matches *.log)
data/
test-results/
.next-dev/
.next-fresh/

# Local pre-fix backup snapshots (multi-GB) - never commit
_retired-*/

# AI-workflow scratch files - keep out of the repo (2026-08-12 hygiene pass)
PROMPT*.md
*_sandbox_*
scratchpad/
*.patch
!reports/**/*.patch

# Build artifacts: installers and release binaries (2026-08-20 hygiene pass)
# Nothing here is source — every one is regenerable by the desktop build.
# The tree already carries a ~98 MB installer under releases/, which no rule
# covered: a single `git add -A` would put it in history permanently, and
# undoing that means rewriting history across every branch.
# SranDesktop/publish/ and SranDesktop/installer/ were already covered by
# SranDesktop/.gitignore:6-7; these extension rules are the repo-wide
# backstop for artifacts produced anywhere else, including releases/.
# Scoped by extension rather than by directory ON PURPOSE: releases/ is the
# desktop update channel and releases/latest.json is the live manifest whose
# history is the rollback path, so it must STAY TRACKED. A `releases/` rule
# would have swallowed it.
*.exe
*.msi
*.msix
*.appx
*.appxbundle
*.nupkg
